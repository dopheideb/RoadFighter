; We can get here from:
;   0x5230 (call) [from=5224_handle_race_substate]
7755_handle_grabbed_fuel_heart_state:
	ld a,(0e0b8h)		;7755 A = fuel_heart_state
	dec a			;7758 --A
	jr z,$+6		;7759 if (fuel_heart_state == 1) jump to 0x775F (775f_grabbed_fuel_heart)
	dec a			;775b --A
	jr z,$+58		;775c if (fuel_heart_state == 2) jump to 0x7796 (7796_set_sprite_attributes_for_bonus_score_and_decrement_the_show_timer)
	ret			;775e



; We can get here from:
;   0x7759 (jump) [from=7755_handle_grabbed_fuel_heart_state]
775f_grabbed_fuel_heart:
	; Add 0x20 to fuel remaining, maxing out at 0xD7.
	ld hl,0e083h		;775f HL = &fuel_remaining
	ld a,(hl)		;7762 A = fuel_remaining
	add a,020h		;7763 A = fuel_remaining + 0x20
	ld b,0d7h		;7765 B = MAX_FUEL
	cp b			;7767 Compute A - MAX_FUEL and update C/NC flag.
	jr c,$+3		;7768 if (fuel_remaining < MAX_FUEL) jump to 0x776B
	ld a,b			;776a A = MAX_FUEL, cap fuel remaining to maximum of 0xD7.
	
	; We can get here:
	;   0x7768 (jump) Fuel below 0xD7
	;   0x776A (fall) Fuel capped to 0xD7
	ld (hl),a		;776b fuel_remaining = A
	
	call 07444h		;776c 7444_draw_fuel_gauge
	ld hl,0e0b8h		;776f HL = 0xE0B8
	inc (hl)		;7772
	
	; ++grabbed_fuel_hearts_streak_count
	inc hl			;7773 HL = &grabbed_fuel_hearts_streak_count
	inc (hl)		;7774 ++grabbed_fuel_hearts_streak_count

	inc hl			;7775 HL = 0xE0BA
	ld (hl),060h		;7776
	
	dec hl			;7778 HL = &grabbed_fuel_hearts_streak_count
	ld a,(hl)		;7779 A = grabbed_fuel_hearts_streak_count
	cp 004h			;777a
	jr c,$+4		;777c if (grabbed_fuel_hearts_streak_count < 4) jump to 0x7791
	ld a,004h		;777e A = 4
	
	; We can get here from:
	;   0x777c (jump) A = Heart streak count capped to 4
	;   0x777e (fall) A = Heart streak count not capped
	ld hl,07791h		;7780 HL = 7791_heart_score_table
	call 0403bh		;7783 HL += A
	
	; Score += 7791_heart_score_table[A] * 100, updates hiscore if 
	; needed.
	ld d,(hl)		;7786 D = 7791_heart_score_table[A]
	ld e,000h		;7787 E = 0x00
	call 0447fh		;7789 447f_add_to_score_and_update_hiscore
	; Fall to 778c_play_sound_03__grabbed_bonus_fuel_heart



; We can get here from:
;   0x40DE (call) [from=40cf_game_state_00_substate_03__draw_logo_konami_play_select_level_A_level_B]
;   0x7789 (fall) [from=775f_grabbed_fuel_heart]
778c_play_sound_03__grabbed_bonus_fuel_heart:
	ld a,003h		;778c A = 3, sound ID of grabbing a bonus fuel heart.
	jp 04b6eh		;778e 4b6e_sound_something_with_D_is_0



; The more fuel hearts a player grabs, the more it is worth.
; 
; Referenced by 0x7780.
7791_heart_score_table:
	defb 0x00		;7791 0  consecutive fuel hearts:    0 points
	defb 0x03		;7792 1  consecutive fuel hearts:  300 points
	defb 0x05		;7793 2  consecutive fuel hearts:  500 points
	defb 0x08		;7794 3  consecutive fuel hearts:  800 points
	defb 0x10		;7795 4+ consecutive fuel hearts: 1000 points


	
; We can get here from:
;   0x775C (jump) [from=7755_handle_grabbed_fuel_heart_state]
7796_set_sprite_attributes_for_bonus_score_and_decrement_the_show_timer:
	ld hl,0e0bah		;7796 HL = 0xE0BA
	dec (hl)		;7799
	jr z,$+36		;779a if (z) jump to 0x77BE (77be_stop_showing_bonus_score)

	ld de,0e13ah		;779c DE = 0xE13A (start of sprite 0x0B: bonus points for grabbed bonus fuel heart)
	ld hl,0e112h		;779f HL = 0xE112 (start of sprite 0x02: shadow of player car)
	
	; Set bonus score sprite vpos.
	ld a,(hl)		;77a2 A = vpos
	sub 010h		;77a3 A = vpos - 0x10
	ld (de),a		;77a5
	
	; Set bonus score sprite hpos.
	inc de			;77a6 Point to hpos.
	inc hl			;77a7 Point to hpos.
	ldi			;77a8 *(DE++) = *(HL++), --BC (copy hpos)

	; Set bonus score sprite pattern.
	;
	;   pattern = 0x94 + 4 * (bonus_fuel_heart_streak_count - 1)
	; 
	;   Sprite pattern 0x94: "300"
	;   Sprite pattern 0x98: "500"
	;   Sprite pattern 0x9C: "800"
	;   Sprite pattern 0xA0: "1000"
	ld a,(0e0b9h)		;77aa A = bonus_fuel_heart_streak_count
	dec a			;77ad --A, make it 0-based
	cp 004h			;77ae Compute A - 0x04 and update C/NC flag.
	jr c,$+4		;77b0 if (bonus_fuel_heart_streak_count <= 4) jump to 0x77B4
	ld a,003h		;77b2 A = 0x03, there is no higher bonus than "1000".
	add a,a			;77b4 A *= 2
	add a,a			;77b5 A *= 2
	add a,094h		;77b6 A += 0x94
	ld (de),a		;77b8
	
	; Set bonus score sprite color
	inc de			;77b9
	ld a,006h		;77ba Transparent for zeroes and dark red for ones.
	ld (de),a		;77bc

	ret			;77bd



; We can get here from:
;   0x779A (jump) [from=7796_set_sprite_attributes_for_bonus_score_and_decrement_the_show_timer] HL == 0xE0BA
77be_stop_showing_bonus_score:
	dec hl			;77be HL = 0xE0B9
	dec hl			;77bf HL = 0xE0B8
	ld (hl),000h		;77c0
	
	; Hide bonus score sprite.
	ld hl,0e13ah		;77c2
	ld (hl),0e0h		;77c5 Set vpos to 0xE0.

	ret			;77c7




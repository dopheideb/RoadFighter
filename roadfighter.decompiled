	ld bc,00030h		;51de BC = 0x0030 
	ld (hl),0c8h		;51e1 Set vpos to outside of the screen.
	ldir			;51e3 do { *(DE++) = *(HL++) } while (--BC)

	; Fall to 51e5_moving_objects__zero.



; Clear everything about moving objects, from 0xE0C1 upto and including 
; 0xE104.
; 
; We can get here from:
;   0x5059 (call) [from=504c_init_stage]
;   0x51E3 (fall) [from=51d8_moving_objects__hide_and_zero]
51e5_moving_objects__zero:

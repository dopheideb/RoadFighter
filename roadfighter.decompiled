; We can get here from:
;   0x419B (call) [from=4197_game_state_03_substate_03]
;   0x42D9 (call) [from=4294_game_state_04_substate_06]
68aa_push_much_stuff_to_VRAM:
	ld de,05dech		;68aa DE = 0x5DEC, pattern source
	ld hl,02200h		;68ad HL = 0x2200, VRAM destination
	call 45e0_copy2VRAM_3x	;68b0
	
	ld de,05f25h		;68b3 DE = 0x5F25, color source
	ld hl,00200h		;68b6 HL = 0x0200, VRAM destination
	call 45e0_copy2VRAM_3x	;68b9



	; Track patterns 0xD0 upto and including 0xD4.
	ld hl,02680h		;68bc HL = 0x2680, VRAM destination
	ld de,05fech		;68bf DE = 0x5FEC, pattern source
	call 45e0_copy2VRAM_3x	;68c2
	
	; Track colors 0xD0 upto and including 0xD4.
	ld hl,00680h		;68c5 HL = 0x0680, VRAM destination
	ld de,0601dh		;68c8 DE = 0x601D, color source
	call 45e0_copy2VRAM_3x	;68cb



	; Track patterns 0xD5 upto and including 0xD8. Mirror source: patterns 0xD1 upto and including 0xD4.
	ld hl,02688h		;68ce HL = 0x2688, pattern source (in VRAM)
	ld de,026a8h		;68d1 DE = 0x26A8, VRAM destination
	ld c,004h		;68d4 C = 4, copy/mirror count
	call 04652h		;68d6 4652_mirror_VRAM_patterns_in_vertical_axis
	
	; Track color 0xD5 upto and including 0xD8.
	ld hl,006a8h		;68d9 HL = 0x06A8, VRAM destination
	ld de,0601fh		;68dc DE = 0x601F, color source
	call 45e0_copy2VRAM_3x	;68df



	; Track patterns 0xD9 upto and including 0xE0.
	ld hl,026c8h		;68e2 HL = 0x26C8, VRAM destination
	ld de,05ff7h		;68e5 DE = 0x5FF7, pattern source
	call 45e0_copy2VRAM_3x	;68e8
	
	; Track colors 0xD9 upto and including 0xE0.
	ld hl,006c8h		;68eb HL = 0x06C8, VRAM destination
	ld de,06022h		;68ee DE = 0x6022, color source
	call 45e0_copy2VRAM_3x	;68f1



	; Track patterns 0xE1 upto and including 0xE8. Mirror source: patterns 0xD9 upto and including 0xE0.
	ld hl,026c8h		;68f4 HL = 0x26C8, pattern source (in VRAM)
	ld de,02708h		;68f7 DE = 0x2708, VRAM destination
	ld c,008h		;68fa C = 8, copy/mirror count
	call 04652h		;68fc 4652_mirror_VRAM_patterns_in_vertical_axis
	
	; Track colors 0xE1 upto and including 0xE8.
	ld hl,00708h		;68ff HL = 0x0708, VRAM destination
	ld de,06022h		;6902 DE = 0x6022, color source
	call 45e0_copy2VRAM_3x	;6905



	; Track patterns 0xE9 upto and including 0xF2.
	ld hl,02748h		;6908 HL = 0x2748, VRAM destination
	ld de,06008h		;690b DE = 0x6008, pattern source
	call 45e0_copy2VRAM_3x	;690e
	
	; Track colors 0xE9 upto and including 0xF3 (!).
	ld hl,00748h		;6911 HL = 0x0748, VRAM destination
	ld de,0602dh		;6914 DE = 0x602D, color source
	call 45e0_copy2VRAM_3x	;6917



	; Track patterns 0xF3 upto and including 0xF8. Mirror source: patterns 0xEC upto and including 0xF1.
	ld hl,02760h		;691a HL = 0x2760
	ld de,02798h		;691d DE = 0x2798
	ld c,006h		;6920 C = 6, copy/mirror count
	call 04652h		;6922 4652_mirror_VRAM_patterns_in_vertical_axis
	
	; Track colors 0xF3 upto and including 0xFA.
	ld hl,00798h		;6925 HL = 0x0798
	ld de,06031h		;6928 DE = 0x6031
	call 45e0_copy2VRAM_3x	;692b



	ld de,05a71h		;692e DE = 0x5A71, sprite data
	; HL = *DE, so HL == 0x1800
	; DE += 2,  so DE == 0x5A73
	; 
	; So sprite data starting at 0x1800 is filled with compressed 
	; data starting at 0x5A73.
	call 0460bh		;6931 460b_hl=*de_and_inc_de_twice_and_decompress_and_copy_to_VRAM
	
	ld hl,01880h		;6934 HL = 0x1880 (inside sprite pattern table)
	ld de,01950h		;6937 DE = 0x1950 (inside sprite pattern table)
	ld c,006h		;693a Mirror 6 sprites
	call 04636h		;693c 4636_mirror_sprites_horizontally(source=HL, destination=DE, count=C)
	
	ld de,05b95h		;693f DE = 0x5B95 (sprite patterns 0x40-0xA3, "crash" to "1000")
	; HL = *DE, so HL == 0x1A00
	; DE += 2,  so DE == 0x5B97
	call 0460bh		;6942 460b_hl=*de_and_inc_de_twice_and_decompress_and_copy_to_VRAM
	
	call 06a06h		;6945 6a06_fixme
	ld a,(0e043h)		;6948 A = stage
	dec a			;694b
	jp z,06a30h		;694c if (stage == 1) jump to 0x6A30 (6a30_stage_01_and_02_and_03_and_06_something)
	dec a			;694f
	jr z,$+57		;6950 if (stage == 2) jump to 0x6989 (6989_stage_02_something)
	dec a			;6952
	jp z,06a30h		;6953 if (stage == 3) jump to 0x6A30 (6a30_stage_01_and_02_and_03_and_06_something)
	dec a			;6956
	jp z,06995h		;6957 if (stage == 4) jump to 0x6995 (6995_stage_04_and_05_something)
	dec a			;695a
	jp z,06995h		;695b if (stage == 5) jump to 0x6995 (6995_stage_04_and_05_something)
	; stage == 6
	call 06a30h		;695e 6a30_stage_01_and_02_and_03_and_06_something
	
	ld hl,006c8h		;6961 HL = 0x06C8, address to read with RDVRM
	ld bc,00100h		;6964 BC = 0x0100
	push bc			;6967
	push hl			;6968
	call 004A_RDVRM		;6969 A = VRAM[0x06C8] (inside color table)
	ld b,a			;696c
	and 00fh		;696d
	cp 00fh			;696f
	jr nz,$+8		;6971 if (nz) jump to 0x6979
	ld a,b			;6973
	and 0f0h		;6974
	or 007h			;6976
	ld b,a			;6978

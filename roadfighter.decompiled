; We can get here from:
;   0x4773 (call) [from=4773_copy_symbols_to_VRAM]
489a_zero_first_0x10_patterns_and_colors:
	; Zero the patterns of the first 0x10 patterns.
	ld hl,02000h		;489a 0x2000 is the start of pattern generator table
	ld bc,00080h		;489d BC = 0x0080 (copy count)
	xor a			;48a0 Fill VRAM with 0x00.
	call 045cfh		;48a1 45cf_filvrm_color_or_pattern_generator
	
	ld hl,00000h		;48a4 0x0000 is the start of the color table.
	ld de,00008h		;48a7 The color mapping of 1 pattern consist of 8 bytes.
	ld b,010h		;48aa
	
	; Zero the color mappings of the first 0x10 characters.
	
	; We can get here from:
	;   0x48AA (fall)
	;   0x48B8 (djnz)
	48ac_start_of_djnz_loop:
	push bc			;48ac
	ld bc,00008h		;48ad 1 patterns needs 8 bytes of color mapping (1 for each line)
	push hl			;48b0
	call 045cfh		;48b1 45cf_filvrm_color_or_pattern_generator
	
	pop hl			;48b4
	add hl,de		;48b5
	inc a			;48b6
	pop bc			;48b7
	djnz $-12		;48b8 if (--B != 0) jump to 0x48AC
	
	ret			;48ba



; ?Related to Konami logo scrolling upwards?
48bb_initialize_konami_logo:
	; konami_logo__scroll_ups_remaining = 0x0E (14).
	ld a,00eh		;48bb A = 0x0E
	ld (0e00ah),a		;48bd konami_logo__scroll_ups_remaining = 0x0E
	
	; *(0xE00E) = 0x3AAA
	; 
	; Set start of the VDP name table for the middle line of the 
	; Konami logo.
	ld hl,03aaah		;48c0 HL = 0x3AAA
	ld (0e00eh),hl		;48c3 *(0xE00E) = 0x3AAA
	
	jp 04010h		;48c6 jump to 4010_from_48c6_to_48c9, which jumps to 0x48C9.



; We can get here from:
;   0x4010 (jump) "fall" from 0x48C6 to 0x40140 to here.
48c9_copy_konami_logo_characters_to_vram_3x:
	;      Character 0x40  Character 0x41  Character 0x42
	; --------------------+---------------+---------------+
	; [00] . . . . . . . .|. . . . . . . .|. . . . . . . .|

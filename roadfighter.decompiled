	defb 0xCE		;4b37 #08 H
	defb 0xD5		;4b38 #09 H
	defb 0x00		;4b39 #0A
	defb 0xD0		;4b3a #0B T
	defb 0xD1		;4b3b #0C T
	defb 0x00		;4b3c #0D
	defb 0xC0		;4b3d #0E E
	defb 0xCD		;4b3e #0F E
	defb 0x00		;4b3f #10
	defb 0xC0		;4b40 #11 R
	defb 0xC1		;4b41 #12 R
	defb 0x00		;4b42 #13
	defb 0xFF		;4b43 #14 END
	
	; Start of the second line.
	defb 0xD6		;4b44 F
	defb 0xDC		;4b45 F
	defb 0x00		;4b46
	defb 0xD8		;4b47 I
	defb 0x00		;4b48
	defb 0xD8		;4b49 G
	defb 0xDD		;4b4a G
	defb 0x00		;4b4b
	defb 0xD6		;4b4c H
	defb 0xDE		;4b4d H
	defb 0x00		;4b4e
	defb 0xDF		;4b4f T
	defb 0xE0		;4b50 T
	defb 0x00		;4b51
	defb 0xD6		;4b52 E
	defb 0xDC		;4b53 E
	defb 0x00		;4b54
	defb 0xD6		;4b55 R
	defb 0xD7		;4b56 R
	defb 0x00		;4b57
	defb 0xFF		;4b58 END
	
	; Start of the third line.
	defb 0xC2		;4b59 F
	defb 0x00		;4b5a
	defb 0x00		;4b5b
	defb 0xC2		;4b5c I
	defb 0x00		;4b5d
	defb 0xC6		;4b5e G
	defb 0xC7		;4b5f G
	defb 0x00		;4b60
	defb 0xC2		;4b61 H
	defb 0xC3		;4b62 H
	defb 0x00		;4b63
	defb 0xD2		;4b64 T
	defb 0xD3		;4b65 T
	defb 0x00		;4b66
	defb 0xCC		;4b67 E
	defb 0xD4		;4b68 E
	defb 0x00		;4b69
	defb 0xC2		;4b6a R
	defb 0xC3		;4b6b R
	defb 0x00		;4b6c
	defb 0xFF		;4b6d END



; We can get here from:
;   0x407F (jump) A == 0x1B (see 0x468C) Silence (on all 3 channels).
;   0x4122 (call) A == 0x1B Silence (on all 3 channels).
;   0x4214 (call) A in [0x05, 0x07] yellow/green traffic light.
;   0x4268 (call) A == 0x98 Tune after selecting either level A or B.
;   0x42B9 (call) A == 0x07 Green traffic light.
;   0x4343 (call) A == 0x95 Tune of being GAME OVER.
;   0x43F7 (call) A == 0x1B Silence (on all 3 channels).
;   0x468C (call) A == 0x1B Silence (on all 3 channels).
;   0x5262 (call) A == 0x92 Player reached checkpoint. A & 0x3F == 0x12
;   0x5452 (call) A == 0x04 55 gallon oil drum behind an 18-wheeler.
;   0x6AB1 (call) A == 0x01
;   0x6AD9 (call) A == 0x4F Player crashes. A & 0x3F == 0x0F
;   0x6B23 (call) A == 0x1B Silence (on all 3 channels).
;   0x6BC7 (call) A == 0x0D Player bounced against a car, but car is still controllable.
;   0x6C4A (call) A == 0x0B ???
;   0x72E4 (jump) A == 0x09 Weird intermittent sound during a level.
;   0x7441 (jump) A == 0x02 Emit low fuel warning.
;   0x778E (jump) A == 0x03 Bleep for both grabbing a fuel heart and for when both parts of Road Fighter logo join.
4b6e_sound_something_with_D_is_0:
	di			;4b6e Disable interrupts
	ld d,000h		;4b6f D = 0
	call 04b76h		;4b71 4b76_sound_something
	ei			;4b74 Enable interrupts
	ret			;4b75



; Input:
;   A: Sound ID, including flags
;
; We can get here from
;   0x4B71 (call) D == 0
;   0x4BD8 (call) D == 1
4b76_sound_something:
	ld c,a			;4b76 Save sound ID.
	ld b,001h		;4b77 B = 0x01, default number of channels
	ld hl,0e012h		;4b79 HL = 0xE012
	
	and 03fh		;4b7c A &= 0x3F (remove flag 0x80 and 0x40)
	cp 001h			;4b7e
	jr z,$+35		;4b80 if (sound_ID & 0x3F == 1) jump to 0x4BA3
	
	cp 005h			;4b82
	jr c,$+16		;4b84 if (sound_ID & 0x3F < 0x05) jump to 0x4B94
	
	cp 00fh			;4b86
	jr c,$+6		;4b88 if (sound_ID & 0x3F < 0x0F) jump to 0x4B8E
	
	; Sound IDs: 0xF, 0x12, 0x15, 0x18. These sound IDs use 3 PSG 
	; channels, so update the number of channels to use to 3.
	inc b			;4b8a ++B (B == 2)
	inc b			;4b8b ++B (B == 3)
	jr $+11			;4b8c jump to 0x4B97



	; We can get here from:
	;   0x4B88 (jump) tuneID & 0x3F in [5,7,9,0xA,0xB,0xD]
	4b8e_:
	ld hl,0e01dh		;4b8e HL = 0xE01D
	inc b			;4b91 ++B (B == 2)
	jr $+5			;4b92 jump to 0x4b97
	
	; We can get here from:
	;   0x4B84 (jump) B==1, tuneID & 0x3F in [2,3,4] (tune ID 0 does not exist)
	ld hl,E028_soundID_B	;4b94 HL = 0xE028
	
	; We can get here from:
	;   0x4B8C (jump) B == 3 channels, HL == 0xE012, sound_ID&0x3F >= 0x0F
	;   0x4B92 (jump) B == 2 channels, HL == 0xE01D, sound_ID&0x3F in [5,7,9,0xA,0xB,0xD]
	;   0x4B94 (fall) B == 1 channel,  HL == 0xE028, sound_ID&0x3F in [2,3,4]
	dec d			;4b97 --D
	jr z,$+11		;4b98 if (D_pre_4b97 == 1) jump to 0x4BA3
	
	; D_pre_4b97 != 1, i.e. D_pre_4b97 == 0.
	ld a,(hl)		;4b9a A = sound_ID of channel X
	and 03fh		;4b9b A &= 0x3F
	ld e,a			;4b9d E = A
	ld a,c			;4b9e A = original sound_ID
	and 03fh		;4b9f A &= 0x3F
	cp e			;4ba1 Compute A - E and update C/NC flag.
	ret c			;4ba2 if (A < E) return
	
	
	; We can get here from:
	;   0x4B80 (jump) (sound_ID & 0x3F) == 0x01 (silence)
	;   0x4B98 (jump) D_pre_4b97 == 1
	;   0x4BA2 (fall)
	4ba3_:
	and 03fh		;4ba3 A &= 0x3F
	add a,a			;4ba5 A *= 2, since data in table at 0x4DE2 contains pointers which are 2 bytes.
	ld de,04de0h		;4ba6 DE = 0x4DE0, but this 1-based table starts at 0x4DE2.
	call 04040h		;4ba9 DE += A
	
	; Set HL to start of sound struct.
	dec hl			;4bac
	dec hl			;4bad
	; Post: HL in [0xE010, 0xE01B, 0xE026], i.e. start of sound struct A/B/C.
	
	; Store base engine humming frequency divider.
	;
	; Frequency divider for 0xE032: 0x0DEB
	; Frequency divider for 0xE034: 0x0DEE
	push hl			;4bae
	; Write 0xEB0D to 0xE032 as little endian, but will be read as big endian, hence 0DEB.
	ld hl,0eb0dh		;4baf HL = 0xEB0D
	ld (0e032h),hl		;4bb2 *(0xE032) = 0xEB0D
	; Write 0xEE0D to 0xE034 as little endian, but will be read as big endian, hence 0DEE.
	ld hl,0ee0dh		;4bb5 HL = 0xEE0D
	ld (0e034h),hl		;4bb8 *(0xE034) = 0xEE0D
	pop hl			;4bbb
				;fall to 4bbc_start_of_djnz_4bcf



; Initialize the first five bytes of the RAM sound struct(s).
; 
; Input:
;   B:  The number of PSG channels to initialize.
;   C:  Sound ID
;   DE: B addresses of the sound definitions.
;   HL: Address of the destination RAM sound structs.
; 
;   +----------+-----------+-----------+----------------+
;   | input HL | HL[0] = 1 | HL[0] = 2 | HL[3..4]       |
;   +----------+-----------+-----------+----------------+
;   |  0xE011  |   0xE011  |   0xE012  | 0xE013..0xE014 |
;   +----------+-----------+-----------+----------------+
;   |  0xE01C  |   0xE01C  |   0xE01D  | 0xE01E..0xE01F |
;   +----------+-----------+-----------+----------------+
;   |  0xE027  |   0xE027  |   0xE028  | 0xE029..0xE02A |
;   +----------+-----------+-----------+----------------+
;
; 1 loop is for 1 PSG channel.
4bbc_start_of_djnz_4bcf:
	ld (hl),001h		;4bbc sound_struct[0] = 0x01
	inc hl			;4bbe
	ld (hl),001h		;4bbf sound_struct[1] = 0x01
	inc hl			;4bc1 
	ld (hl),c		;4bc2 sound_struct[2] = sound_ID
	inc hl			;4bc3
	ld a,(de)		;4bc4
	ld (hl),a		;4bc5 sound_struct[3] = start address of sound, low byte.
	inc hl			;4bc6
	inc de			;4bc7 ++DE
	ld a,(de)		;4bc8
	ld (hl),a		;4bc9 sound_struct[4] = Store start address of sound, high byte.
	
	; HL += 0x07 (sound struct is 11 bytes, we are at offset 4, so add 7)
	ld a,007h		;4bca
	add a,l			;4bcc
	ld l,a			;4bcd

	inc de			;4bce ++DE
	djnz $-19		;4bcf if (--B != 0) jump to 0x4BBC
	
	ret			;4bd1



4bd2_:
	ld a,(ix+002h)		;4bd2 A = IX[2]
	push bc			;4bd5
	ld d,001h		;4bd6 D = 1
	call 04b76h		;4bd8 4b76_sound_something
	pop bc			;4bdb
	ex af,af'		;4bdc
	ld (ix+009h),a		;4bdd IX[9] = A
	ret			;4be0



; Input:
;   C: tone channel to enable, noise channel to disable
;     1: enable tone channel A, disable noise channel A
;     3: enable tone channel B, disable noise channel B
;     5: enable tone channel C, disable noise channel C
;   
;   Why 1/3/5? Since other code uses 1/3/5 because PSG register 1/3/5 
;   control the frequency divider for channel A/B/C.
;   
;   D: enable/disable selected noise channels:
;     1==disable selected noise channels
;     0==enable selected noise channels
;
; We can get here from:
;   0x4CC0 (call) D == 1
;   0x4CFF (call) D == 0
;   0x4D2B (call) D == 1
4be1_enable_or_disable_single_noise_channel:
	ld a,(e031_PSG_reg07)	;4be1
	ld e,a			;4be4 E = PSG_reg07_value
	ld a,c			;4be5 A = C
	
	; Map [1,3,5] to [1,2,4], i.e. map to bits 0, 1 and 2.
	cp 001h			;4be6 Compute A - 1 and set flags.
	jr z,$+3		;4be8 if (A == 1) jump to 0x4BEB (don't decrement A)
	dec a			;4bea --A
	; Suppose we want to change channel B:
	;   A == 0b00 000 010
	
	; A <<= 3, because noise channels are bits 3, 4, and 5.
	rlca			;4beb A <<= 1
	rlca			;4bec A <<= 1
	rlca			;4bed A <<= 1
	; Example post: A == 0b00 010 000
	
	dec d			;4bee --D, set Z/NZ flag. 
	jr z,$+6		;4bef if (D@routine_entry == 1) jump to 0x4BF5
	; Post: D@routine_entry != 1 (but typically 0): enable a noise channel.
	cpl			;4bf1 A = ~A (flip all bits)
	; Example post: A == 0b11 101 111
	; 
	; If this value would be written to PSG register 7, then all 
	; three tone channels will be disabled, and noise channel B is 
	; enabled. (Remember: register 7 is active low/inverse logic.)
	
	and e			;4bf2 A &= E
	; Example post (with E==0x88==0b10 001 000): A == 0b10 001 000: noise channel B was enabled  and will be enabled.
	; Example post (with E==0x90==0b10 010 000): A == 0b10 000 000: noise channel B was disabled and will be enabled.
	; Example post (with E==0xA0==0b10 100 000): A == 0b10 100 000: noise channel B was disabled and will be enabled.
	; Example post (with E==0xB8==0b10 111 000): A == 0b10 101 000: noise channel B was enabled  and will be enabled.
	; 
	; In other words: with respect to E: we will enable noise channel B, no more, no less.
	jr $+3			;4bf3 jump to 4bf6_configure_and_store_PSG_sound_and_noise_generator_control_register(value=A)
	
	; We can get here from:
	;   0x4BEF (jump) D@routine_entry == 1: disable a noise channel.
	or e			;4bf5 A |= E
	; fall to 4bf6_configure_and_store_PSG_sound_and_noise_generator_control_register(value=A)



; Input:
;   A: value to write to PSG register 0x07: the sound and noise 
;      generator control register.

; Bit | Mask | Meaning                    | Fixed value | 0xB8        |
; ----+------+----------------------------+-------------+-------------+
;   7 | 0x80 | PSG I/O port B direction   | 1 (output)  | 1 (ouput)   |
;   6 | 0x40 | PSG I/O port A direction   | 0 (input)   | 0 (input)   |
;   5 | 0x20 | Channel C: noise generator |             | 1 (disable) |
;   4 | 0x10 | Channel B: noise generator |             | 1 (disable) |
;   3 | 0x08 | Channel A: noise generator |             | 1 (disable) |
;   2 | 0x04 | Channel C: tone generator  |             | 0 (enable)  |
;   1 | 0x02 | Channel B: tone generator  |             | 0 (enable)  |
;   0 | 0x01 | Channel A: tone generator  |             | 0 (enable)  |
; ----+------+----------------------------+-------------+-------------+
;
; We can get here from:
;   0x4687 (call) A == 0xB8
;   0x4BF5 (fall)
;   0x4C02 (call) A == *0xE031
4bf6_configure_and_store_PSG_sound_and_noise_generator_control_register:
	ld (e031_PSG_reg07),a	;4bf6 Store new value.
	ld e,a			;4bf9 New value for PSG register 0x07.
	ld a,007h		;4bfa PSG register 0x07.
	jp 0093_WRTPSG		;4bfc Write reg E to PSG reg 0x07.



; We can get here from:
;   0x4017 (call) Interrupts are disabled!
;   0x4033 (call) Interrupts are disabled!
4bff_handle_3_PSG_channel_structs_something:
	ld a,(e031_PSG_reg07)	;4bff
	call 04bf6h		;4c02 4bf6_configure_and_store_PSG_sound_and_noise_generator_control_register(value=A)
	
	; C = 0x01, start with PSG channel A frequency divider control register. 
	; See 4dc3_set_PSG_tone_frequency_divider.
	ld c,001h		;4c05
	
	ld ix,0e010h		;4c07 IX = 0xE010
	exx			;4c0b
	ld b,003h		;4c0c DJNZ loop count. B_shadow = 0x03
	ld de,0000bh		;4c0e DE_shadow = 0x000B
	
	4c11_start_of_djnz_loop:
	exx			;4c11
	ld a,(ix+002h)		;4c12 A = current sound ID
	cp 001h			;4c15
	jr z,$+14		;4c17 if (current sound ID == SOUND_ID_SILENCE) jump to 0x4C25
	; Post: current sound ID != SOUND_ID_SILENCE
	or a			;4c19
	call nz,04cbch		;4c1a if (current sound ID != 0) call 0x4CBC
	
	; C += 2. Next PSG channel frequency divider control register. See 
	; 4dc3_set_PSG_tone_frequency_divider.
	inc c			;4c1d ++C
	inc c			;4c1e ++C
	
	exx			;4c1f
	add ix,de		;4c20 IX = next PSG channel struct
	djnz $-17		;4c22 if (--B != 0) jump to 4c11_start_of_djnz_loop
	
	; All 3 PSG channel structs handled. Return.
	ret			;4c24


; We can get here from:
;   0x4C17 (jump) current sound ID == 1
	ld iy,0e034h		;4c25 IY = &engine_humming_base_frequency_divider_B
	ld a,(0e003h)		;4c29 A = game_state_ticker
	and 003h		;4c2c A &= 0x03 (only preserve bits 0 and 1)
	bit 0,a			;4c2e Test bit 0 (mask 0x01)
	jr nz,$+85		;4c30 if (game_state_ticker & 0x01) jump to 4c85_set_engine_humming_frequency_divider_and_set_volume_something
	
	; Post:
	;   bit 7 to 2: 0 (due to "and 003h" at 0x4C2C)
	;   bit      1: not fixed
	;   bit      0: 0 (due to conditional jump at 0x4C30)
	;
	; Hence: A can only be 0 or 2.
	cp 002h			;4c32 Weird: "and a" or "or a" would be faster+shorter.
	jr z,$+77		;4c34 if ((game_state_ticker & 0x03) == 0x02) jump to 0x4C81
	; Case: (game_state_ticker & 0x03) == 0x00
	ld a,(0e04fh)		;4c36 A = car_speed
	
	; HL = car_speed
	ld h,000h		;4c39 H = 0x00
	ld l,a			;4c3b L = car_speed
	
	; DE = car_speed
	ld e,l			;4c3c E = car_speed
	ld d,h			;4c3d D = 0x00
	
	; HL *= 4, so HL == 4 * car_speed
	add hl,hl		;4c3e
	add hl,hl		;4c3f
	
	; Recap: DE == car_speed, HL == 4 * car_speed
	ld a,(0e038h)		;4c40 A = is_accelerating
	cp 000h			;4c43 Weird: "or A" or "and A" would be shorter and faster.
	jr z,$+34		;4c45 if (is_accelerating == 0x00) jump to 0x4C67

	; Case: DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x01
	ld a,(0e04fh)		;4c47 A = car_speed
	cp 07eh			;4c4a Compute A - 0x7E and set flags.
	jr nc,$+11		;4c4c if (car_speed >= 0x7E) jump to 4c57_speed_at_least_0x7E
	
	; Case: DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x01, speed < 0x7E
	cp 030h			;4c4e
	jr nc,$+29		;4c50 if (car_speed >= 0x30) jump to 0x4C6D
	
	; Case: DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x01, car_speed <= 0x2F
	; 
	; HL *= 8, so HL == 32 * car_speed
	add hl,hl		;4c52
	add hl,hl		;4c53
	add hl,hl		;4c54
	
	; Case: DE == car_speed, HL == 32 * car_speed, is_accelerating == 0x01, car_speed <= 0x2F
	jr $+41			;4c55 jump to 0x4C7E



	; We can get here from:
	;   0x4C4C (jump) [from=self] DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x01, car_speed >= 0x7E
	4c57_speed_at_least_0x7E:
	; Why test this??? We can only get here when we are 
	; accelerating, so the following test is useless!
	ld a,(0e038h)		;4c57 A = is_accelerating
	cp 000h			;4c5a Weird: "or A" or "and A" would be shorter and faster.
	jr nz,$+5		;4c5c if (is_accelerating != 0x00) jump to 0x4C61
	; Case: is_accelerating == 0: decelerating. !UNREACHABLE CODE!
	add hl,hl		;4c5e HL *= 2, so HL == 8 * car_speed
	jr $+8			;4c5f jump to 0x4C67



	; We can get here from:
	;   0x4C5C (jump) [from=self] DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x01, car_speed >= 0x7E
	add hl,de		;4c61 HL += DE, so HL == 5 * car_speed
	ld de,004b0h		;4c62 DE = 0x04B0
	; Recap: DE == 0x04B0, HL == 5 * car_speed, is_accelerating == 0x01, car_speed >= 0x7E
	jr $+24			;4c65 jump to 0x4C7D



	; We can get here from:
	;   0x4C45 (jump) [from=self] DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x00, any car_speed
	;   0x4C5F (jump) [from=self] DE == car_speed, HL == 8 * car_speed, is_accelerating == 0x00, car_speed >= 0x7E (UNREACHABLE CODE)
	add hl,hl		;4c67 HL *= 2, so HL == 8 * car_speed
	ld de,00300h		;4c68 DE = 0x0300
	; Recap: DE == 0x0300, HL == 8 * car_speed, is_accelerating == 0x00, any car_speed
	jr $+18			;4c6b jump to 0x4C7D



	; We can get here from:
	;   0x4C50 (jump) DE == car_speed, HL == 4 * car_speed, is_accelerating == 0x01, 0x30 <= car_speed < 0x7E
	4c6d_speed_is_at_least_0x30_and_below_0x7E:
	ld a,(0e04fh)		;4c6d A = car_speed
	sub 030h		;4c70 A -= 0x30
	
	; HL = A, so HL == car_speed - 0x30
	ld l,a			;4c72 L = car_speed
	ld h,000h		;4c73 H = 0x00
	
	; HL *= 16, so HL == 16 * (car_speed - 0x30)
	add hl,hl		;4c75
	add hl,hl		;4c76
	add hl,hl		;4c77
	add hl,hl		;4c78
	
	; DE = 0x0500
	ld e,000h		;4c79
	ld d,005h		;4c7b
	; Recap: DE == 0x0500, HL == 16 * (car_speed - 0x30), 0x30 <= car_speed < 0x7E
	
	
	
	; We can get here from:
	;   0x4C65 (jump) DE == 0x04B0, HL ==  5 * (car_speed       ), is_accelerating == 0x01, car_speed >= 0x7E
	;   0x4C6B (jump) DE == 0x0300, HL ==  8 * (car_speed       ), is_accelerating == 0x00, any car_speed
	;   0x4C7B (fall) DE == 0x0500, HL == 16 * (car_speed - 0x30), is_accelerating == 0x01, 0x30 <= car_speed < 0x7E
	add hl,de		;4c7d HL += DE
	
	; We can get here from:
	;   0x4C7D (fall), 0x4C6B (jump) [from=self] is_accelerating == 0x00,     any car_speed        , HL ==  8 * (car_speed       ) + 0x0300
	;   0x4C55 (jump)                [from=self] is_accelerating == 0x01,         car_speed <= 0x2F, HL == 32 * (car_speed       )
	;   0x4C7D (fall), 0x4C67 (fall) [from=self] is_accelerating == 0x01, 0x30 <= car_speed <  0x7E, HL == 16 * (car_speed - 0x30) + 0x5000
	;   0x4C7D (fall), 0x4C65 (jump) [from=self] is_accelerating == 0x01,         car_speed >= 0x7E, HL ==  5 * (car_speed       ) + 0x04B0
	ld (0e036h),hl		;4c7e engine_humming_frequency_divider_offset = HL
	
	; We can get here from:
	;   0x4C34 (jump)
	;   0x4C7E (fall)
	ld iy,0e032h		;4c81 IY = &engine_humming_base_frequency_divider_A



; We can get here from:
;   0x4C30 (jump) IY == &engine_humming_base_frequency_divider_B, (game_state_ticker & 0x01) == 0x01, ticker is odd
;   0x4C81 (fall) IY == &engine_humming_base_frequency_divider_A, (game_state_ticker & 0x01) == 0x00, ticker is even
4c85_set_engine_humming_frequency_divider_and_set_volume_something:
	ld de,(0e036h)		;4c85 DE = engine_humming_frequency_divider_offset
	
	; HL = IY[0], load base engine humming frequency divider, i.e. 
	; when car has speed 0.
	; 
	; Seen:
	;   IY == 0xE032, HL == 0x0DEB (due to 0x4BB2)
	;   IY == 0xE034, HL == 0x0DEE (due to 0x4BB8)
	ld h,(iy+000h)		;4c89
	ld l,(iy+001h)		;4c8c
	
	; DE is a negative offset. Base engine humming frequency divider 
	; is high, meaning actual frequency is low. To get a higher 
	; pitch, we must lower the frequency divider, hence negative 
	; offset.
	sbc hl,de		;4c8f HL -= (DE + carry)
	call 04dc3h		;4c91 4dc3_set_PSG_tone_frequency_divider(channel=C, frequency_divider=HL)

	ld a,(0e083h)		;4c94 A = fuel_remaining
	cp 010h			;4c97 Compute A - 0x10 and set flags.
	jr c,$+21		;4c99 if (fuel_remaining < 0x10) jump to 4cae_set_volume_A_to_9.
	
	ld a,(E028_soundID_B)	;4c9b
	cp 003h			;4c9e
	jr z,$+14		;4ca0 if (A == 0x03) jump to 4cae_set_volume_A_to_9.
	
	cp 00ah			;4ca2
	jr z,$+14		;4ca4 if (A == 0x0A) jump to 4cb2_set_volume_A_to_0.
	
	cp 00dh			;4ca6
	jr z,$+10		;4ca8 if (A == 0x0D) jump to 4cb2_set_volume_A_to_0.
	
	ld e,00dh		;4caa E = 0x0D, new volume for PSG channel A.
	jr $+8			;4cac jump to 4cb4_set_volume_A.



; We can get here from:
;   0x4C99 (jump) low on fuel (less than 0x10)
;   0x4CA0 (jump) Sound ID == 0x03 (player grabbed a fuel heart)
4cae_set_volume_A_to_9:
	ld e,009h		;4cae E = 0x09, new volume for PSG channel A.
	jr $+4			;4cb0 jump to 0x4CB4: 4cb4_set_volume_A(volume=0x09)


; We can get here from:
;   0x4CA4 (jump) Sound ID == 0x0A (player skidding, controllable)
;   0x4CA8 (jump) Sound ID == 0x0D (player skidding out of control)
4cb2_set_volume_A_to_0:
	ld e,000h		;4cb2 E = 0x00, new volume for PSG channel A.
	
; We can get here from:
;   0x4CB0 (jump) E == 0x09
;   0x4CB2 (fall) E == 0x00
4cb4_set_volume_A:
	ld a,008h		;4cb4 A = 8, PSG register for volume of channel A.
	call 0093_WRTPSG	;4cb6 A: PSG reg, E: data
	
	jp 04c1dh		;4cb9



; We can get here from:
;   0x4C1A (call) IX in [0xE010, 0xE01A, 0xE0B] (sound struct), A=IX[2]
	bit 6,a			;4cbc bit 6: mask 0x40
	ld d,001h		;4cbe D = 1
	call z,04be1h		;4cc0 if (no noise wanted) 4be1_enable_or_disable_single_noise_channel(disable=True, channel=C)
	ld a,(ix+002h)		;4cc3 A = IX[2]
	or a			;4cc6 Set flags.
	jp m,04d35h		;4cc7 if (A & 0x80) jump to 0x4D35
	dec (ix+000h)		;4cca --IX[0], decrement sound ticks left
	ret nz			;4ccd if (sound ticks left for this PSG channel) return
	;
	; Post: Current frequency played long enough. Load next.
	; 
	; Let HL point to next sound opcode.
	ld l,(ix+003h)		;4cce
	ld h,(ix+004h)		;4cd1
	
	ld a,(hl)		;4cd4 A = sound_opcode
	cp 0ffh			;4cd5 Compute A - 0xFF and set flags.
	jr z,$+78		;4cd7 if (sound_opcode == 0xFF) jump to 0x4D25
	; Post: not the end of current sound ID.
	bit 7,(ix+002h)		;4cd9
	jp nz,04d5fh		;4cdd if (bit 7 special sound) jump to 0x4D5F
	
	and 0f0h		;4ce0 Only sound flags.
	cp 020h			;4ce2
	jr nz,$+9		;4ce4 if (sound_flags != 0x20) jump to 4ced_check_sound_flag_0x10
	
	; Post: sound flags == 0x20
	4ce6_store_sound_duration:
	ld a,(hl)		;4ce6 A = sound_opcode
	and 00fh		;4ce7 Remove flags.
	ld (ix+001h),a		;4ce9 Store
	
	inc hl			;4cec Point to next opcode.
	; Fall to 4ced_check_sound_flag_0x10.


; We can get here from:
;   0x4CE4 (jump) HL points to unhandled sound opcode, but some sound flags where already checked/handled.
;   0x4CEC (fall) HL points to unhandled sound opcode
4ced_check_sound_flag_0x10:
	ld a,(hl)		;4ced A = sound_opcode
	
	and 0f0h		;4cee Only sound flags.
	cp 010h			;4cf0
	jr nz,$+17		;4cf2 if (sound_flags != 0x10) jump to 0x4D03
	; Post: set noise frequency divider control register


; Set noise frequency divider to *(HL) & 0x1F.
4cf4_set_noise_frequency_divider:
	ld a,(hl)		;4cf4 (Re)load sound opcode.
	and 01fh		;4cf5 A = noise frequency divider
	ld e,a			;4cf7 E = A, noise frequency divider
	ld a,006h		;4cf8 A = 0x06: PSG noise frequency divider control register
	call 0093_WRTPSG	;4cfa A: PSG reg, E: data
	
	ld d,000h		;4cfd D = 0x00
	call 04be1h		;4cff 4be1_enable_or_disable_single_noise_channel(channel=reg_C, enable=True)
	
	inc hl			;4d02 Point to next opcode.


; We can get here from:
;   0x4CF2 (jump) HL points to unhandled sound opcode, but some sound flags where already checked/handled.
;   0x4D02 (fall) HL points to unhandled sound opcode
4d03_fixme:
	ld a,(hl)		;4d03 A = sound_opcode
	and 0f0h		;4d04 Only sound flags.
	ld b,a			;4d06 B = A
	
	; (A & 0xF0) ^ A == A & 0x0F, i.e. sound opcode without flags.
	xor (hl)		;4d07
	
	ld d,a			;4d08 D = A
	inc hl			;4d09 Point to next opcode.
	ld e,(hl)		;4d0a E = sound_opcode
	call 04dceh		;4d0b 4dce_load_new_sound_definition(HL)
	ex de,hl		;4d0e
	call 04dc3h		;4d0f 4dc3_set_PSG_tone_frequency_divider(channel=reg_C, frequency_divider=HL)
	
	ld a,b			;4d12 A = sound_opcode & 0xF0
	; Swap high and low nybble.
	rrca			;4d13
	rrca			;4d14
	rrca			;4d15
	rrca			;4d16



; We can get here from:
;   0x4D16 (fall) A == volume (sound_opcode & 0xF0)
;   0x4DAC (jump)
4d17_set_volume_and_sound_duration_and_ix8:
	ld h,a			;4d17 H = volume
	ld a,(ix+001h)		;4d18 A = sound_duration
	ld (ix+000h),a		;4d1b sound_duration_left = sound_duration
	add a,002h		;4d1e A += 2
	ld (ix+008h),a		;4d20 ???
	jr $+52			;4d23 jump to 4d57_set_volume(channel=reg_C, volume=H)


; We can get here from:
;   0x4CD7 (jump) sound_opcode == 0xFF (end of sound)
4d25_:
	xor a			;4d25 A = 0
	ld (ix+009h),a		;4d26
	ld d,001h		;4d29 D = 1
	call 04be1h		;4d2b 4be1_enable_or_disable_single_noise_channel(disable=True, channel=C)
	
	xor a			;4d2e A = 0
	ld (ix+002h),a		;4d2f
	ld h,a			;4d32
	jr $+36			;4d33 jump to 0x4D57



; We can get here from:
;   0x4CC7 (jump) IX[2] & 0x80 == 1 (i.e. bit 7 is set)
4d35_:
	dec (ix+000h)		;4d35 --sound_duration_left
	jp z,04cceh		;4d38 if (sound done) jump to 0x4CCE
	dec (ix+008h)		;4d3b
	ld a,(ix+008h)		;4d3e
	cp (ix+000h)		;4d41
	jr nz,$+7		;4d44 if (IX[8] != IX[0]) jump to 0x4D4B
	cp 003h			;4d46
	jr c,$+6		;4d48 if (IX[8] <= 2) jump to 0x4D4E
	ret			;4d4a
	
	; We can get here from:
	;   0x4D44 (jump)
	dec (ix+008h)		;4d4b --IX[8]
	
	; We can get here from:
	;   0x4D48 (jump)
	;   0x4D4B (fall)
	ld a,(ix+007h)		;4d4e A = note_number
	dec a			;4d51
	ret m			;4d52 if (note_number == 0) return
	ld (ix+007h),a		;4d53 ?Store decrease note_number?
	ld h,a			;4d56
	; Fall to 4d57_set_volume(channel=C, volume=H)



; Input:
;   C: PSG channel (1 == PSG channel A, 3 == PSG channel B, 5 == PSG channel C)
;   H: Value for the volume/amplitude register
; 
; We can get here from:
;   0x4D23 (jump) C == ?, H == ?
;   0x4D56 (fall) C == ?, H == ?
; 
;            | C == 1 | C == 3 | C == 5 |
; -----------+--------+--------+--------+
; ld a,c     |   0x01 |   0x03 |   0x05 |
;            |  0b001 |  0b011 |  0b101 |
; -----------+--------+--------+--------+
; rrca       |   0x80 |   0x81 |   0x82 |
; -----------+--------+--------+--------+
; add a,088h |   0x08 |   0x09 |   0x0A |
; -----------+--------+--------+--------+
4d57_set_volume(channel=C, volume=H):
	ld a,c			;4d57 A = C
	
	; Map [1,3,5] to [8,9,10].
	rrca			;4d58 
	add a,088h		;4d59 A += 0x88
	ld e,h			;4d5b
	
	jp 0093_WRTPSG		;4d5c A: PSG reg, E: data



4d5f_soundID_with_0x80:
	ld a,(hl)		;4d5f A = sound_opcode
	and 0f0h		;4d60 A &= 0xF0
	cp 0d0h			;4d62 Compute A - 0xD0 and set flags.
	ld a,(hl)		;4d64 A = sound_opcode
	jr nz,$+9		;4d65 if (sound_opcode >= 0xD0) jump to 0x4D6E
	
	; Store.
	and 00fh		;4d67 A &= 0x0F
	ld (ix+00ah),a		;4d69 IX[0x0A] = sound_opcode & 0x0F (low nybble)
	
	; Load new sound opcode.
	inc hl			;4d6c
	ld a,(hl)		;4d6d
	
	
	; We can get here from:
	;   0x4D65 (jump)
	;   0x4D6D (fall)
	cp 0f0h			;4d6e Compute sound_opcode - 0xF0 and update C/NC flag.
	jr c,$+9		;4d70 if (sound_opcode < 0xF0) jump to 0x4D79
	and 00fh		;4d72 A &= 0x0F
	ld (ix+006h),a		;4d74 IX[0x06] = sound_opcode & 0x0F (low nybble)
	inc hl			;4d77 ++HL, HL points to new sound opcode
	ld a,(hl)		;4d78 A = sound_opcode
	
	
	; We can get here from:
	;   0x4D70 (jump)
	;   0x4D78 (fall)
	cp 0e0h			;4d79 Compute A - 0xE0 and set flags.
	jr c,$+9		;4d7b if (A < 0xE0) jump to 0x4D84
	
	; Set octave offset.
	and 00fh		;4d7d A &= 0x0F
	ld (ix+005h),a		;4d7f IX[5] = A, octave offset
	
	; Load new sound opcode.
	inc hl			;4d82 ++HL, HL points to a new sound opcode
	ld a,(hl)		;4d83 A = sound_opcode
	
	; We can get here from:
	;   0x4D7B (jump)
	;   0x4D83 (fall)
	and 00fh		;4d84 A &= 0x0F (low nybble)
	ld b,a			;4d86 Save low nybble of sound_opcode
	ld a,(ix+00ah)		;4d87 A = IX[0x0A]
	jr z,$+7		;4d8a if (IX[0x0A] == 0) jump to 0x4D91
	
	4d8c_start_of_djnz_loop:
	add a,(ix+00ah)		;4d8c A += IX[0x0A]
	djnz $-3		;4d8f if (--B != 0) jump to 0x4D8C
	
	; We can get here from:
	;   0x4D8F (fall)
	;   0x4D8A (jump)
	ld (ix+001h),a		;4d91
	ld a,(hl)		;4d94
	call 04dceh		;4d95 4dce_load_new_sound_definition(HL)
	; Post: HL is increased by 1, IX[3] == L, IX[4] == H
	
	and 0f0h		;4d98 A &= 0xF0
	; Swap high and low nybble.
	rrca			;4d9a
	rrca			;4d9b
	rrca			;4d9c
	rrca			;4d9d
	
	ld b,a			;4d9e B = note_number
	sub 00ch		;4d9f A -= 0x0C
	ld (ix+007h),a		;4da1 IX[7] = note_number - 0x0C
	jr z,$+8		;4da4 if (note_number == 0x0C) jump to 0x4DAC
	
	ld a,(ix+006h)		;4da6 A = IX[6]
	ld (ix+007h),a		;4da9 IX[7] = A
	
	; We can get here from:
	;   0x4DA4 (jump) note_number == 0x0C, A == 0x00
	;   0x4DA9 (fall) note_number != 0x0C, A == IX[6]
	call 04d17h		;4dac 4d17_set_volume_and_sound_duration_and_ix8(volume=A)
	
	ld a,b			;4daf A = note_number (0==C, 1==C#, etc)
	ld hl,04dd6h		;4db0 HL = 4dd6_frequency_divider_table_for_octave_6
	call 0403bh		;4db3 HL += A
	
	; HL = frequency divider
	ld l,(hl)		;4db6
	ld h,000h		;4db7 All notes in octave 6 have MSB set to 0x00.
	
	ld a,(ix+005h)		;4db9 A = octave_offset
	or a			;4dbc
	jr z,$+6		;4dbd if (A == 0) jump to 4dc3_set_PSG_tone_frequency_divider((channel=C, frequency_divider=HL)
	
	; Shift HL (frequency divider) to requested octave.
	ld b,a			;4dbf DJNZ: set loop counter
	4dc0_start_of_djnz_loop:
	add hl,hl		;4dc0 HL *= 2
	djnz $-1		;4dc1 if (--B != 0) jump to 0x4DC0


; Set tone frequency divider of channel A/B/C to HL.
;
; Intended for C in [1, 3, 5]:
; 
;   C | PSG channel | MSB (4 bit) | LSB (8 bit) |
;   --+-------------+-------------+-------------+
;   1 | Channel A   | reg H       | reg L       |
;   3 | Channel B   | reg H       | reg L       |
;   5 | Channel C   | reg H       | reg L       |
; 
; 0x4C05: C=1, and switches to C=3 and C=5 inside DJNZ loop
; 
; We can get here from:
;   0x4C91 (call) [from=4c85_set_engine_humming_frequency_divider_and_set_volume_something]
;   0x4D0F (call) [from=4d03_fixme]
;   0x4DBD (jump) [from=4d5f_soundID_with_0x80]
;   0x4DC1 (fall) [from=4d5f_soundID_with_0x80]
4dc3_set_PSG_tone_frequency_divider:
	; Write MSB.
	ld a,c			;4dc3
	ld e,h			;4dc4
	call 0093_WRTPSG	;4dc5 Write H to PSG register defined by reg C.
	
	; Write LSB.
	ld a,c			;4dc8
	dec a			;4dc9
	ld e,l			;4dca
	jp 0093_WRTPSG		;4dcb Write L to PSG register defined by reg C - 1.



; We can get here from:
;   0x4D0B (call) [from=4d03_fixme]             HL is set by sound opcodes.
;   0x4D95 (call) [from=4d5f_soundID_with_0x80]
4dce_load_new_sound_definition:
	inc hl			;4dce ???
	ld (ix+003h),l		;4dcf IX[3] = L
	ld (ix+004h),h		;4dd2 IX[4] = H
	ret			;4dd5


; See 0x4DB0
4dd6_frequency_divider_table_for_octave_6:
	defb 0x6B		;4dd6 #00 Octave 6: C
	defb 0x65		;4dd7 #01 Octave 6: C#
	defb 0x5F		;4dd8 #02 Octave 6: D
	defb 0x5A		;4dd9 #03 Octave 6: D#
	defb 0x54		;4dda #04 Octave 6: E
	defb 0x50		;4ddb #05 Octave 6: F
	defb 0x4C		;4ddc #06 Octave 6: F#
	defb 0x47		;4ddd #07 Octave 6: G
	defb 0x43		;4dde #08 Octave 6: G#
	defb 0x40		;4ddf #09 Octave 6: A
4de0_actual_tune_table_start_is_at_4de2
	defb 0x3C		;4de0 #0A Octave 6: A#
	defb 0x39		;4de1 #0B Octave 6: B


;   0x77EB (call) HL == 0x???? (B == 0x??, C == 0x??), DE == 0xE0B3, A == 0x01
;   0x77F5 (call) HL == 0x78A5 (B == 0x01, C == 0x05), DE == 0xE036, A == 0x0F
;   0x780C (call)
;   0x7815 (call)
;   0x781F (call)
;   0x7831 (call) HL == 0x7893
;   0x7839 (call) HL == 0x78AC
;   0x783C (fall) DE = 0xE338
;   0x7857 (jump)
783f_copy_to_course_memory:
	push hl			;783f Store HL, restore at 0x7855.
	ld b,(hl)		;7840 DJNZ: loop count
	inc hl			;7841
	ld c,(hl)		;7842 LDIR: loop count
	inc hl			;7843
	
	7844_start_of_djnz_loop:
	push bc			;7844 Store BC, restore at 0x7852.
	ex af,af'		;7845
	ld a,016h		;7846 A = 0x16 (22)
	sub c			;7848 A -= C
	ld b,000h		;7849 B = 0
	ldir			;784b *DE++ = *HL++, C times (since B is 0)
	ld c,a			;784d C = A
	ex af,af'		;784e
	
	; DE += C (since B was zeroed at 0x7849).
	ex de,hl		;784f
	add hl,bc		;7850 HL += BC
	ex de,hl		;7851
	
	pop bc			;7852 Restore BC, was stored at 0x7844.
	djnz $-15		;7853 if (--B != 0) jump to 0x7844
	
	pop hl			;7855 Restore HL, stored at 0x783F.
	dec a			;7856 --A
	jr nz,$-24		;7857 if (A != 0) jump to 0x783F
	; Post: A == 0
	inc a			;7859 A = 1
	ret			;785a




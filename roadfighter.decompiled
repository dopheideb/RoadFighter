	ld a,(hl)		;41fd A = game_state_ticker
	and 01fh		;41fe A &= 0x1F
	ret nz			;4200 if (game_state_ticker & 0x1F) return
	; Post: game_state_ticker is a multiple of 0x20.
	
	inc hl			;4201 HL = &game_state_bits_or_counter_or_timer (0xE004, since previous value was 0xE003 set at 0x41FA)
	dec (hl)		;4202 --game_state_bits_or_counter_or_timer
	ld a,(hl)		;4203 A = game_state_bits_or_counter_or_timer
	cp 001h			;4204
	jr z,$+68		;4206 if (game_state_bits_or_counter_or_timer == 0x01) jump to 424a_game_state_03_substate_09_subsubstate_01
	bit 0,a			;4208 Test bit 0
	jr nz,$+13		;420a if (game_state_bits_or_counter_or_timer & 0x01 == 0x01) jump to 0x4217
	cp 002h			;420c 
	ld a,005h		;420e A = 0x05 Sound ID of yellow traffic light
	jr nz,$+4		;4210 if (game_state_bits_or_counter_or_timer != 0x02) jump to 0x4214
	; Post: game_state_bits_or_counter_or_timer == 0x02
	inc a			;4212 A = 0x06
	inc a			;4213 A = 0x07 Sound ID of green traffic light


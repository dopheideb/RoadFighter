6af4_subtract_0x14_fuel_and_stop_fuel_heart_sound_and_draw_speed_and_fuel_gauge:
	ld hl,0e083h		;6af4 HL = &fuel_remaining
	ld a,(hl)		;6af7 A = fuel_remaining
	sub 014h		;6af8 A -= 0x14 (20 in decimal)
	jr nc,$+3		;6afa if (fuel_remaining >= 0x14) jump to 0x6AFD
	; Don't allow negative fuel.
	xor a			;6afc A = 0x00

	; Store.
	ld (hl),a		;6afd fuel_remaining = A




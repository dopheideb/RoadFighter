	ld de,0490fh		;48c9 DE = 0x490F
	; 0x6200 is OUTSIDE VRAM, but BIOS applies mask 0x3FFF. 0x6200 
	; becomes 0x2200.
	ld hl,06200h		;48cc HL = 0x6200 (but practically 0x2200)
	call 45e0_copy2VRAM_3x	;48cf
	
	; Set up color table for Konami logo: white letters, transparant background.
	ld hl,00200h		;48d2 HL = 0x0200 (start at character 0x40)
	ld bc,000d8h		;48d5 BC = 0x00D8 (copy 0x1B (27) times, since we use 27 different characters)
	ld a,0f0h		;48d8 A  = 0xF0   (color 1: white, color 2: transparent)
	jp 045cfh		;48da 45cf_filvrm_color_or_pattern_generator(VRAM_start_address=HL, data_byte=A, count=BC)



; Write 4 lines to VRAM:
;   1. 3 characters for the top of capital K
;   2. 11 characters for the top part of the Konami logo
;   3. 12 characters for the bottom part of the Konami logo (include copyright symbol)
;   4. 12 characters to erase previous bottom part.
;
; Z flag is set if (and only if) konami_logo__scroll_ups_remaining == 0x00
; 
; We can get here from:
;   0x40B2 (call) [from=40ad_game_state_00_substate_01__konami_logo_and_line_and_software_letters]
48dd_write_upwards_scrolling_konami_logo:
	ld hl,(0e00eh)		;48dd HL = *(0xE00E)
	ld de,0ffe0h		;48e0 DE = 0xFFE0
	add hl,de		;48e3 HL -= 0x20
	ld (0e00eh),hl		;48e4 Store back. New value is 1 VDP line higher than previous.
	ld a,040h		;48e7 A = 0x40 (first character to copy to VRAM)
	ld b,003h		;48e9 B = 0x03 (top of capital K is 3 characters)
	call 04901h		;48eb 4901_WRTVRM_consecutive_characters(VRAM_start_address=konami_logo_vertical_center,first_character=0x40,count=0x03)
	
	; B = 0x0B (count for middle line)
	; C = 0x0C (count for bottom line, includes copyright character)
	ld bc,00b0ch		;48ee
	call 04901h		;48f1 4901_WRTVRM_consecutive_characters(VRAM_start_address=konami_logo_vertical_center,first_character=0x43,count=0x0B)
	
	ld b,c			;48f4 B = 0x0C
	call 04901h		;48f5 4901_WRTVRM_consecutive_characters(VRAM_start_address=konami_logo_vertical_center,first_character=0x4E,count=0x0C)
	; Note: B == 0 because of DJNZ loop in 0x4901, hence: BC == 0x000C
	;
	; Clear previous bottom line of Konami logo.
	xor a			;48f8 A = 0
	call 0056_FILVRM	;48f9 FILVRM(VRAM_start=HL, length=0x000C, value=0x00)
	
	ld hl,0e00ah		;48fc HL = &konami_logo__scroll_ups_remaining
	dec (hl)		;48ff --konami_logo__scroll_ups_remaining, and update Z/NZ flag.
	
	ret			;4900



; Copy a set consecutive characters to VRAM, much like LDIRMV.
;
;   A: first character
;   B: number of characters to copy to VRAM
;  HL: VRAM start address
;
; Original HL is incremented by 1 VDP line worth of characters (0x20).
; Original A is incremented by original B.
; 
; 
; 
; We can get here from:
;   0x48EB (call) [from=48dd_write_upwards_scrolling_konami_logo] B == 0x03, HL == *(0xE00E) - 0x20, A == 0x40
;   0x48F1 (call) [from=48dd_write_upwards_scrolling_konami_logo] B == 0x0B, HL == *(0xE00E) + 0x00, A == 0x43
;   0x48F5 (call) [from=48dd_write_upwards_scrolling_konami_logo] B == 0x0C, HL == *(0xE00E) + 0x20, A == 0x4E
4901_WRTVRM_consecutive_characters:
	push hl			;4901 Store original HL.
	
	4902_start_of_djnz_loop:
	call 004D_WRTVRM	;4902 WRTVRM(VRAM_adress=HL,value=A)
	inc hl			;4905
	inc a			;4906
	djnz $-5		;4907 if (--B != 0) jump to 0x4902
	
	pop de			;4909 Restore original HL.
	ld hl,00020h		;490a
	add hl,de		;490d
	
	ret			;490e




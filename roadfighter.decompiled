; We can get here from:
;   0x40D8 (call) [from=40cf_game_state_00_substate_03__draw_logo_konami_play_select_level_A_level_B] *(0xE004) == 0x20 (initial value, see 0x40C8)
;   0x49BF (fall) [from=49bf_draw_logo_konami_play_select_level_A_level_B_something                   *(0xE004) == 0x07
49c2_draw_logo_konami_play_select_level_A_level_B:
	ld de,0472ah		;49c2 DE = 472a_copyright_konami_1985_letters,play_select,level_A
	call 45f0_show_symbols	;49c5 Show "©KONAMI 1985" + "PLAY SELECT" + "LEVEL A"
	
	; Post: DE == 0x4751 == 4751_level_B
	; 
	; Why separate level A and B? Since we want to be able to blink 
	; them, independently. See routine 4607_hide_symbols and code 
	; 0x4189.
	call 45f0_show_symbols	;49c8 Show "LEVEL B".
	
	; Set up details about the "ROAD" part of the Road Fighter 
	; logo, and then draw "ROAD".
	; 
	;     Source:            DE = 0x4B0C
	;                             0x4B0C: 4b0c_road_pattern_names_end_of_first_line
	;     Destination:       HL = 0x3840 + (0x20 - *(0xE004))
	;                             0x3840: start of third row.
	;     Line element size: C = 0x11
	ld a,(0e004h)		;49cb A = *(0xE004)
	sub 020h		;49ce A -= 0x20
	neg			;49d0 A = -A
	add a,040h		;49d2 A += 0x40
	ld l,a			;49d4 L = A
	ld h,038h		;49d5 H = 0x38 (name table, upper band)
	ld de,04b0ch		;49d7 DE = 0x4B0C
	ld c,011h		;49da C = 0x11
	call 049ech		;49dc 49ec_copy_road_or_fighter_to_pattern_name_table
	
	; Set up details about the "FIGHTER" part of the Road Fighter 
	; logo, and then draw "FIGHTER".
	;
	;     Source:            DE = 0x4B2F
	;                             0x4B2F: 4b2f_fighter_pattern_names
	;     Destination:       HL = 0x38C0 + *(0xE004)
	;                             0x38C0: start of seventh row.
	;     Line element size: C = 0x15
	ld a,(0e004h)		;49df A = *(0xE004)
	add a,0c0h		;49e2 A += 0xC0
	ld l,a			;49e4 L = 0xC0 + *(0xE004)
	ld h,038h		;49e5 H = 0x38 (name table, upper band)
	ld de,04b2fh		;49e7 DE = 0x4B2F (4b2f_fighter_pattern_names)
	ld c,015h		;49ea C = 0x15
				;fall 49ec_copy_road_or_fighter_to_pattern_name_table



; We can get here from:
;   0x49DC (call) [from=49c2_draw_logo_konami_play_select_level_A_level_B] DE == 0x4B0C, HL == 0x38??, C == 0x11
;   0x49EA (fall) [from=49c2_draw_logo_konami_play_select_level_A_level_B] DE == 0x4B2F, HL == 0x38C0 + *(0xE004), C == 0x15
49ec_copy_road_or_fighter_to_pattern_name_table:
	ld b,003h		;49ec B = 3, loop over upper, middle, lower band.
				;fall 49ee_draw_road_fighter_logo___outer_loop_over_3_lines_of_the_word



; We can get here from:
;   0x49EC (fall) B == 3
;   0x4a22 (djnz)
49ee_draw_road_fighter_logo___outer_loop_over_3_lines_of_the_word:
	; B: Store DJNZ loop counter.
	; C: Store number of bytes to copy from DE to HL (name table)
	push bc			;49ee
	push hl			;49ef
	push de			;49f0
	
	; Determine the number pattern names to copy to the pattern name 
	; table (DJNZ loop counter):
	; 
	;     B = 0x20 - *(0xE004)
	ld a,(0e004h)		;49f1 A = *0xE004
	sub 020h		;49f4 A -= 0x20
	neg			;49f6 A = -A
	ld b,a			;49f8 B = number of pattern names to copy
				;fall 49f9_draw_road_fighter_logo___inner_loop_over_patters_of_a_single_line

	
	
; We can get here from:
;   0x49F8 (fall) 0x49DC DE == 0x4B0C, HL == 0x38??            , C == 0x11
;                 0x49EA DE == 0x4B2F, HL == 0x38C0 + *(0xE004), C == 0x15
;   0x4A14 (djnz)
49f9_draw_road_fighter_logo___inner_loop_over_patters_of_a_single_line:
	ld a,(de)		;49f9 A = *(DE)
	inc a			;49fa ++A
	jr z,$+25		;49fb if (*(DE) == 0xFF) jump to 0x4A14
	
	; Write 1 byte to the pattern name table.
	call 0053_SETWRT	;49fd [BIOS]: Set VDP for writing, HL=VRAM address
	push bc			;4a00
	ld a,(00006h)		;4a01 A = 0x98 (VDP reading port #0)
	ld c,a			;4a04 C = 0x98
	ld a,(de)		;4a05
	out (c),a		;4a06 Write to VDP.
	pop bc			;4a08
	
	; Update HL and DE.
	;
	; "ROAD":    HL and DE have to be DEcremented.
	; "FIGHTER": HL and DE have to be INcremented.
	inc hl			;4a09 ++HL
	inc de			;4a0a ++DE
	ld a,c			;4a0b A = C
	cp 015h			;4a0c Compute A - 0x15 and update Z/NZ flag.
	jr z,$+6		;4a0e if (C == 0x15) jump to 0x4A14
	; Post: C == 0x11 (since C was either 0x15 or 0x11)
	; 
	; C == 0x11 means we are busy with the "ROAD" part of the Road 
	; Fighter logo.
	;
	; The source (DE) is read backwards, the destination (HL) is 
	; written backwards. DE and HL were increased at 0x4A09 and 
	; 0x4A0A, but we have to reverse that (one dec), and then do the 
	; actual subtraction (another dec).
	dec de			;4a10 --DE
	dec de			;4a11 --DE
	dec hl			;4a12 --HL
	dec hl			;4a13 --HL
	
	; We can get here from:
	;   0x49FB (jump) 0xFF (end of data) reached, no-op loop
	;   0x4A0E (jump) DE and HL correctly incremented ("FIGHTER")
	;   0x4A13 (fall) DE and HL correctly decremented ("ROAD")
	djnz $-27		;4a14 if (--B != 0) jump to 0x49F9 (49f9_draw_road_fighter_logo___inner_loop_over_patters_of_a_single_line)
	
	
	; Restore most registers.
	pop de			;4a16 Restore source address.
	pop hl			;4a17 Restore VRAM destination address.
	pop bc			;4a18 Restore DJNZ loop counter.
	
	ld a,020h		;4a19 A = 0x20
	call 0403bh		;4a1b HL += A, go to next VRAM line.
	
	ld a,c			;4a1e A = C
	call 04040h		;4a1f DE += A, go to next source line.
	
	; Continue loop at 49ee_draw_road_fighter_logo___outer_loop_over_3_lines_of_the_word.
	djnz $-52		;4a22 if (--B != 0) jump to 0x49EE
	
	; Done. We looped over all 3 lines of the word "ROAD" or "FIGHTER".
	ret			;4a24




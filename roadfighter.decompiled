; Name tabla data: The "ROAD" part of the Road Fighter logo.
; 
; See 0x49D7. The pattern names of "ROAD" are traversed from back to 
; front. That is why 0x49D7 points to 0x4B0C (the end of "ROAD") instead 
; of 0x4AFC (the start of "ROAD"). It also explains why we "start" with 
; 0xFF at 0x4AFC: it is the end instead of the start.
; 
; The length of each element (1 line) is 0x11 bytes. See also 0x49DA.
4afc_road_pattern_names:
	defb 0xFF		;4afc #00 END
	defb 0x00		;4afd #01 First line of "ROAD".
	defb 0xC0		;4afe #02 R
	defb 0xC1		;4aff #03 R
	defb 0x00		;4b00 #04 
	defb 0xC4		;4b01 #05 O
	defb 0xC5		;4b02 #06 O
	defb 0x00		;4b03 #07 
	defb 0xC8		;4b04 #08 A
	defb 0xC9		;4b05 #09 A
	defb 0x00		;4b06 #0A
	defb 0xC0		;4b07 #0B D
	defb 0xC1		;4b08 #0C D
	defb 0x00		;4b09 #0D
	defb 0x00		;4b0a #0E
	defb 0x00		;4b0b #0F
4b0c_road_pattern_names_end_of_first_line:
	defb 0x00		;4b0c #10 See 0x49D7. End of first line.

	defb 0xFF		;4b0d END
	defb 0x00		;4b0e Middle line of "ROAD".
	defb 0xD6		;4b0f R
	defb 0xD7		;4b10 R
	defb 0x00		;4b11
	defb 0xD8		;4b12 O
	defb 0xD9		;4b13 O
	defb 0x00		;4b14
	defb 0xDA		;4b15 A
	defb 0xDB		;4b16 A
	defb 0x00		;4b17
	defb 0xD8		;4b18 D
	defb 0xD9		;4b19 D
	defb 0x00		;4b1a
	defb 0x00		;4b1b
	defb 0x00		;4b1c
	defb 0x00		;4b1d

	defb 0xFF		;4b1e END
	defb 0x00		;4b1f Last line of "ROAD".
	defb 0xC2		;4b20 R
	defb 0xC3		;4b21 R
	defb 0x00		;4b22
	defb 0xC6		;4b23 O
	defb 0xC7		;4b24 O
	defb 0x00		;4b25
	defb 0xCA		;4b26 A
	defb 0xCB		;4b27 A
	defb 0x00		;4b28
	defb 0xCC		;4b29 D
	defb 0xC7		;4b2a D
	defb 0x00		;4b2b
	defb 0x00		;4b2c
	defb 0x00		;4b2d
	defb 0x00		;4b2e




	bit 6,a			;42b3
	jr z,$+7		;42b5 if (z) jump to 0x42BC
	ld a,007h		;42b7 A = 0x07 Sound of green traffic light
	call 04b6eh		;42b9 4b6e_sound_something_with_D_is_0
	ld a,048h		;42bc
	jp 04167h		;42be 4167_increase_substate_and_set_E004_to_regA

	djnz $+20		;42c1 if (--B != 0) jump to 0x42D5
4294_game_state_04_substate_05:
	call 0440ch		;42c3 440c_decrement_timer_and_do_return_magic
	; Post: timer ran out.
	ld a,(0e002h)		;42c6
	bit 6,a			;42c9
	jp nz,042f8h		;42cb
	
	ld hl,00102h		;42ce Game state 0x02, substate 0x01
	ld (0e000h),hl		;42d1 game_state = 0x02, game_substate = 0x01
	ret			;42d4



4294_game_state_04_substate_06:
	call 04429h		;42d5 4429_blacken_whole_coarse_row_or_just_first_character_then_hide_all_or_nearly_all_sprites
	ret p			;42d8
	call 068aah		;42d9 68aa_push_much_stuff_to_VRAM
	call 044d0h		;42dc 44d0_fixme
	call 042edh		;42df 42ed_show_state_something
	call 0526bh		;42e2 526b_copy_13_sprites_from_RAM_to_VRAM
	ld a,078h		;42e5
	ld (0e004h),a		;42e7
	jp 0416ah		;42ea 416a_increase_substate



; We can get here from:
;   0x42DF (call) [from=4294_game_state_04_substate_06]
;   0x41A4 (call) [from=4197_game_state_03_substate_03]
42ed_show_state_something:
	ld de,0471fh		;42ed 471f_stage_letters
	call 045f0h		;42f0 45f0_show_symbols
	dec l			;42f3
	dec l			;42f4
	jp 044edh		;42f5



; We can get here from:
;   0x4134 (jump) [from=412d_game_state_01__waiting_for_player_to_start_the_game] Ran out of time to choose level A/B.
;   0x4263 (jump) [from=424a_game_state_03_substate_09_subsubstate_01] Just switched from state 03,substate 09,subsubstate 01 to state 04.
;   0x42CB (jump) [from=4270_game_state_04__demo] (*0xE002 & 0x40) == 0x40
;   0x4317 (jump) [from=4306_game_state_05_substate_01]
;   0x4346 (jump) [from=4341_game_over]
42f8_increase_game_state_set_substate_to_00_set_game_state_bits_or_counter_or_timer_to_0x18:
	ld a,018h		;42f8 A = 0x18

; We can get here from:
;   0x42F7 (fall)
;   0x410F (jump) [from=410e_game_state_00_substate_04__timer_ran_out] A == 0
42fa_increase_game_state_set_substate_to_00_set_game_state_bits_or_counter_or_timer_to_regA:
	ld (0e004h),a		;42fa game_state_bits_or_counter_or_timer = A
	ld hl,0e000h		;42fd HL = &game_state
	inc (hl)		;4300 ++game_state
	; Fall to 4301_set_game_substate_to_00.



; Set the game substate to 0x00.
;
; Notes:
;   Register A is always 0x00 after returning.
;	
; We can get here from:
;   0x4157 (jump) [from=414f_set_game_state_to_regA_and_reset_timer]
;   0x4300 (fall)
4301_set_game_substate_to_00:
	xor a			;4301 A = 0x00
	ld (0e001h),a		;4302 game_substate = 0x00
	ret			;4305
	


; We can get here from:
;   0x4096 (jump) [from=4082_increment_ticker__read_input__jump_to_state_handler]
4306_game_state_05:
	djnz $+28		;4306 if (--B != 0) jump to 0x4322

4306_game_state_05_substate_01:
	call 05224h		;4308 5224_handle_race_substate
	ld a,(0e00dh)		;430b A = have_reached_checkpoint_and_all_moving_objects_are_gone
	and a			;430e Update Z/NZ flag.
	jp nz,04319h		;430f if (have_reached_checkpoint_and_all_moving_objects_are_gone) jump to 0x4319
	;
	; Post: have_reached_checkpoint_and_all_moving_objects_are_gone == false
	;
	ld a,(0e045h)		;4312
	or a			;4315 Update Z/NZ flag.
	ret nz			;4316
	jr $-31			;4317 jump to 0x42F8
	
	; We can get here from:
	;   0x430F (jump) have_reached_checkpoint_and_all_moving_objects_are_gone == true
	ld a,008h		;4319 A = 8 (playing)
	call 414f_set_game_state_to_regA_and_reset_timer	;431b
	ld (0e004h),a		;431e Store timer
	ret			;4321
	
; We can get here from:
;   0x4306 (djnz)
4306_game_state_05_substate02:
	jp 0527dh		;4322 527d_fixme



; We can get here from:
;   0x4096 (jump) [from=4082_increment_ticker__read_input__jump_to_state_handler]
4325_game_state_06__player_car_crashed:
	ld a,(0e083h)		;4325 A = fuel_remaining
	or a			;4328
	jr z,$+24		;4329 if (fuel_remaining == 0) jump to 0x4341 (game over)
	; Post: still fuel remaining
	;
	call 051c5h		;432b 51c5_car_crashed_something
	ld a,001h		;432e A = 0x01
	ld (0e045h),a		;4330
	
	ld hl,0433ah		;4333 HL = 0x433A
	push hl			;4336 ?WHY? Return to 0x433A?
	
	call 0573ah		;4337 573a_copy_coarse_to_VRAM
	
	; We can get here from:
	;   0x???? (????) See 0x4336
	;   0x4337 (fall)
	ld hl,00105h		;433a HL = 0x0105
	ld (0e000h),hl		;433d game_state = 0x05, game_substate = 0x01, player can accelerate
	
	ret			;4340



; We can get here from:
;   0x4329 (jump)
4341_game_over:
	ld a,095h		;4341 A = 0x95 Sound ID of "GAME OVER".
	call 04b6eh		;4343 4b6e_sound_something_with_D_is_0
	jr $-78			;4346 Jump to 0x42F8



; We can get here from:
;   0x4096 (jump) [from=4082_increment_ticker__read_input__jump_to_state_handler]
4348_game_state_07__no_fuel_remaining:
	push bc			;4348
	call 0526bh		;4349 526b_copy_13_sprites_from_RAM_to_VRAM
	
	; Show minicar (in dark red)
	ld a,006h		;434c A = 0x06, sprite color: dark red
	ld hl,03b03h		;434e Sprite #00 (minicar), color attribute.
	call 004D_WRTVRM	;4351 WRTVRM(VRAM_address=0x3B03, value=0x06)

	pop bc			;4354
	djnz $+15		;4355 if (--B != 0) jump to 0x4364

4348_game_state_07_substate_01:
	call 0440ch		;4357 440c_decrement_timer_and_do_return_magic
	; Post: timer ran out.
	ld hl,0e002h		;435a
	ld a,(hl)		;435d
	and 0bfh		;435e
	ld (hl),a		;4360
	jp 0414eh		;4361 414e_set_game_state_to_00_and_reset_timer

; We can get here from:
;   0x4355 (djnz)
4364_game_state_07_substate_00:
	call 04429h		;4364 4429_blacken_whole_coarse_row_or_just_first_character_then_hide_all_or_nearly_all_sprites
	ret p			;4367
	ld de,0475eh		;4368 475e_game_over_letters
	call 045f0h		;436b 45f0_show_symbols
	ld a,0d8h		;436e
	jp 04167h		;4370 4167_increase_substate_and_set_E004_to_regA
	


; We can get here from:
;   0x4096 (jump) [from=4082_increment_ticker__read_input__jump_to_state_handler]
4373_game_state_08__post_reaching_checkpoint_or_goal:
	push bc			;4373 Store B.
	call 0526bh		;4374 526b_copy_13_sprites_from_RAM_to_VRAM
	call 0597dh		;4377 597d_update_minicar_vpos_and_color
	pop bc			;437a Restore B.
	djnz $+13		;437b if (--B != 0) jump to 0x4388
	; Post: B == 0

437d_game_state_08_substate_01__draw_stages_overview_map:
	call 04429h		;437d 4429_blacken_whole_coarse_row_or_just_first_character_then_hide_all_or_nearly_all_sprites
	ret p			;4380
	call 0744ch		;4381 744c_draw_stages_overview_map
	xor a			;4384 A = 0x00
	jp 04167h		;4385 4167_increase_substate_and_set_E004_to_regA


	
	; We can get here from:
	;   0x437B (djnz)
	djnz $+5		;4388 if (--B != 0) jump to 0x438D
438a_game_state_08_substate_02:
	jp 0747dh		;438a 747d_game_state_08_substate_02



	djnz $+5		;438d if (--B != 0) jump to 0x4392
438f_game_state_08_substate_03__blink_minicar_in_stages_overview_at_correct_checkpoint_or_goal:
	jp 07495h		;438f 7495_game_state_08_substate_03__blink_minicar_in_stages_overview_at_correct_checkpoint_or_goal



	djnz $+41		;4392 if (--B != 0) jump to 0x43BB
4392_game_state_08_substate_04:
	ld hl,0e043h		;4394 HL = &stage
	inc (hl)		;4397 Next stage!
	ld a,(hl)		;4398 Load new stage number.
	cp 007h			;4399 Only 6 stages, so 7 means we should wrap around.
	ld bc,00004h		;439b BC = 0x0004
	jr nz,$+10		;439e if (stage number != 7) jump to 0x43A8
	
	; Reached goal. Wraparound from stage 6 to stage 1.
	ld bc,00303h		;43a0 BC = 0x0303
	ld a,001h		;43a3 A = 1
	ld (hl),a		;43a5 Set stage number to 1
	dec hl			;43a6 HL = &num_stage_wraparounds (0xE042)
	inc (hl)		;43a7 ++num_stage_wraparounds
	
	; We can get here from:
	;   0x439E (jump) A==next_stage, C==0x04 (game state), B==0x00 (game substate) [No stage number wraparound.]
	;   0x43A7 (fall) A==1,          C==0x03 (game state), B==0x03 (game substate) [Stage number wraparound, but handled.]
	;
	; Reset the timer. We will overwrite game state and game 
	; substate at 0x43AB.
	;
	; Note: 0x414F returns with A == 0x00
	call 0414fh		;43a8 414f_set_game_state_to_regA_and_reset_timer
	
	ld (0e000h),bc		;43ab Store game state and game sub state.
	ld (0e00dh),a		;43af have_reached_checkpoint_and_all_moving_objects_are_gone = false
	call 0504ch		;43b2 504c_init_stage
	
	; Reset minicar's vertical position to beginning of stage.
	ld a,06ch		;43b5 A = 0x6C
	ld (e10e_mcar_vpos),a	;43b7 *(0xE10E) = 0x6C
	
	ret			;43ba



	call 0440ch		;43bb 440c_decrement_timer_and_do_return_magic
	; Post: timer ran out.
	ld a,018h		;43be
	jp 04167h		;43c0 4167_increase_substate_and_set_E004_to_regA



; Check 0x408D: 0x43C3 is pushed onto the stack as a return value.
; 
; We can get here from:
;   0x4096 (jump) [from=4082_increment_ticker__read_input__jump_to_state_handler]
43c3_game_state_handler:
	; A = 46c3_read_joystick_and_keyboard
	call 046c3h		;43c3 46c3_read_joystick_and_keyboard
	; Post: A is unchanged

	ld hl,0e03ah		;43c6 HL = 0xE03A
	call 046bch		;43c9 46bc_save_pressed_keys_in_HL__save_newly_pressed_keys_in_HL_minus_1

	or a			;43cc Update Z/NZ flag.
	ret z			;43cd if (no key pressed at all) return

	ld hl,0e004h		;43ce HL = 0xE004: state related bits
	ld (hl),000h		;43d1 state_related_bits = 0x00
	ld l,(hl)		;43d3 L = 0x00, so HL == 0xE000: HL points to game state
	ld de,0e03bh		;43d4 DE = &level
	ld b,(hl)		;43d7 B = game state

	djnz $+27		;43d8 if (--B != 0) jump to 0x43F3
	; Post: game state == 0x01: game is startable.



43da_game_state_01:
	and 030h		;43da A &= 0x30 (mask for space/select/trigger 1/trigger 2)
	jr z,$+43		;43dc if (space+select+trigger+trigger1 are all not pressed) jump to 0x4407 (4407_flip_least_significant_bit_in_DE)

	; Space or select or trigger 1 or trigger 2 is pressed.
	ld a,(de)		;43de A = level
	or a			;43df Update Z/NZ flag.
	ld a,040h		;43e0 A = 0x40
	jr z,$+4		;43e2 if (*(DE) == 0) jump to 0x43E6
	ld a,060h		;43e4 A = 0x60
	
	; We can get here from:
	;   0x43E2 (jump) A == 0x40
	;   0x43E4 (fall) A == 0x60
	ld (0e002h),a		;43e6 Store game flags.

	ld (hl),003h		;43e9 Switch to game state #03: start game
	inc hl			;43eb
	ld c,000h		;43ec C = 0x00
	ld (hl),c		;43ee Switch to game substate #00.
	dec c			;43ef C = 0xFF
	jp 05032h		;43f0 5032_draw_0_or_1_hand_pointing_to_right_symbols_in_front_of_level_A_and_B



; We can get here from:
;   0x43D8 (djnz) HL == 0xE000, game state != 0x01
43f3_switch_to_game_state_01:
	ld (hl),001h		;43f3 game state = 0x01
	ld a,01bh		;43f5 A = 0x1B (silence, on all 3 PSG channels)
	call 04b6eh		;43f7 4b6e_sound_something_with_D_is_0

	ld a,007h		;43fa A = 0x07
	ld (0e004h),a		;43fc *(0xE004) = 0x07
	call 049bfh		;43ff 49bf_draw_logo_konami_play_select_level_A_level_B_something

	xor a			;4402 A = 0x00
	ld (0e004h),a		;4403 *(0xE004) = 0x00
	ret			;4406



4407_flip_least_significant_bit_in_DE:
	ld a,(de)		;4407
	xor 001h		;4408 Flip last bit.
	ld (de),a		;440a
	ret			;440b



; 1. Decrement timer
; 2. timer == 0: return to caller (normal "ret")
;    timer != 0: return to parent of caller.
;
; For example when timer reaches 0 here:
;   call 0440ch;40c2 Timer is decremented, no more, no less.
;   call 049a6h;40c5 Will execute normally.

; For example when timer does not reache 0 here:
;   call 0440ch;40c2 Timer is decremented, also returns.
;   call 049a6h;40c5 Will NOT be executed.
; 
; Equivalent inline code:
;   ld hl,0e004h;40c2
;   dec (hl)    ;40c5
;   ret nz      ;40c6
440c_decrement_timer_and_do_return_magic:
	ld hl,0e004h		;440c HL = 0xE004
	dec (hl)		;440f --*(0xE004)
	ret z			;4410 if (timer == 0) return
	
	; Z80 pushed the program counter (PC) when this subroutine was 
	; called. (Actually the PC right after the call.) So, that PC is 
	; popped from the stack. The value is not important; the 
	; popping/removing is.	
	pop hl			;4411
	
	; Return to the PARENT OF THE CALLER.
	ret			;4412



4413_clear_some_memory:
	ld hl,0e03fh		;4413 HL = 0xE03F
	ld bc,0010fh		;4416 BC = 0x010F (LDIR count)

	; DE = 0xE040
	ld d,h			;4419 D = 0xE0
	ld e,l			;441a E = 0x3F
	inc e			;441b E = 0x40
	
	ld (hl),000h		;441c *HL = 0x00
	ldir			;441e Clear memory starting at 0xE040
	
	ld hl,0e042h		;4420 HL = &num_stage_wraparounds
	xor a			;4423 A = 0x00
	ld (hl),a		;4424 num_stage_wraparounds = 0
	inc hl			;4425 HL = &stage
	inc a			;4426 A = 0x01
	ld (hl),a		;4427 stage = 1
	ret			;4428


; Blacken 1 row (or only the first character of 1 row) of the coarse.
; 
; Input:
;   0xE004 The row to blacken. 0x18: top row, 0x01: botton row.

; Returns:
;   S flag:
;     P (positive): This routine is not yet done; more lines have to be made black.
;     M (negative): This routine is done. The coarse is now completely black.
; 
; We can get here from:
;   0x4197 (call) [from=4197_game_state_03_substate_03]
;   0x42D5 (call) [from=4294_game_state_04_substate_06]
;   0x4364 (call) [from=4364_game_state_07_substate_00]
;   0x437D (call) [from=437d_game_state_08_substate_01__draw_stages_overview_map]
4429_blacken_whole_coarse_row_or_just_first_character_then_hide_all_or_nearly_all_sprites:
	ld hl,0e004h		;4429 HL = &game_state_bits_or_counter_or_timer
	dec (hl)		;442c --game_state_bits_or_counter_or_timer
	ret m			;442d if (game_state_bits_or_counter_or_timer < 0) return
	ld a,017h		;442e A = 0x17
	sub (hl)		;4430 A -= game_state_bits_or_counter_or_timer
	
	; HL = 0x3800 + 0x20 * A
	; 
	; Let HL point to row A (0 based) of the VDP name table.
	;
	; Note: 0x01C0 * 32 == 0x3800
	ld hl,001c0h		;4431 HL = 0x01C0.
	add a,l			;4434
	ld l,a			;4435 HL += A
	add hl,hl		;4436
	add hl,hl		;4437
	add hl,hl		;4438
	add hl,hl		;4439
	add hl,hl		;443a

	ld a,(0e000h)		;443b A = game_state
	cp 003h			;443e Compute A - 0x03 and update Z/NZ flag.
	ld bc,0001fh		;4440 BC = 0x0001
	jr z,$+11		;4443 if (game_state == 3) jump to 0x444E
	
	; Only for game states 4,7,8.
	ld a,(0e002h)		;4445
	bit 6,a			;4448 Test demo/playing bit.
	jr z,$+4		;444a if (is_demo) jump to 0x444E
	ld c,017h		;444c BC = 0x0017
	
	; Make 1 coarse row black, or the first character.
	;
	; We can get here from:
	;   0x4443 (jump) BC == 0x0001 (just the first character of the coarse row)
	;   0x444A (jump) BC == 0x0001 (just the first character of the coarse row)
	;   0x444C (fall) BC == 0x0017 (whole coarse row)
	xor a			;444e A = 0x00 (all black character)
	call 0056_FILVRM	;444f filvrm(start_address=HL, length=BC, data_byte=A)
	
	; Hide all sprites except sprite #00 (leaves minicar sprite 
	; untouched).
	ld hl,03b04h		;4452 HL = 0x3B04 (sprite attributes for sprite #01)
	call 0446ah		;4455 446a_hide_all_sprites_starting_at_HL_by_using_special_single_0xD0
	
	; Game state #03: No-one is racing, so hide all sprites, 
	; including the minicar.
	ld a,(0e000h)		;4458 A = game_state
	cp 003h			;445b
	call z,04467h		;445d if (game_state == 0x03) 4467_hide_all_sprites_by_using_special_single_0xD0
	
	ld b,01ch		;4460 BC = 0x1C
	ld hl,0e112h		;4462 HL = 0xE112 (sprite #01)
	jr $+17			;4465 jump to 0x4476 (4476_hide_sprite_djnz_loop)



; We can get here from:
;   0x445D (call) [from=4429_blacken_whole_coarse_row_or_just_first_character_then_hide_all_or_nearly_all_sprites]
;   0x4584 (call) [from=4584_clear_name_table_and_set_sprite_00_vpos_to_D0]
4467_hide_all_sprites_by_using_special_single_0xD0:
	ld hl,03b00h		;4467 HL = 0x3B00 (sprite attributes for sprite #00)

; Hide all sprites starting at a certain sprite address.
; 
; Input:
;   HL: The VRAM sprite attribute table table address of the first 
;       sprite to hide.
; 
; About 0xD0 (208): TMS9918.pdf states:
; 
;   "Sprite processing is terminated if the VDP finds a value of 208 
;   (D016) in the vertical position field of any entry in the Sprite 
;   Attribute table. This permits the Sprite Attribute Table to be 
;   shortened to the minimum size required; it also permits the user to 
;   blank out part or all of the sprites by simply changing one byte in 
;   VRAM."
; 
; We can get here from:
;   0x4467 (fall) [from=4467_hide_all_sprites_by_using_special_single_0xD0]                                        HL == 0x3B00 (sprite attributes for sprite #00)
;   0x4455 (call) [from=4429_blacken_whole_coarse_row_or_just_first_character_then_hide_all_or_nearly_all_sprites] HL == 0x3B04 (sprite attributes for sprite #01)
446a_hide_all_sprites_starting_at_HL_by_using_special_single_0xD0:
	ld a,0d0h		;446a A = 0xD0 (SPECIAL value for vertical position)
	call 004D_WRTVRM	;446c sprite_attribute[XX].vpos = 0xD0
	xor a			;446f A = 0x00
	ret			;4470



; ?No callers?
4471_hide_all_sprites:
	ld b,01ch		;4471 B = 0x1C (loop count)
	ld hl,0e10eh		;4473 HL = 0xE10E (minicar sprite)
				;fall 4476_hide_sprite_djnz_loop

	
; We can get here from:
;   0x4465 (jump) B == 0x1C, HL == 0xE112 (sprite: shadow of player car)
;   0x4473 (fall) B == 0x1C, HL == 0xE10E (sprite: minicar)
4476_hide_sprite_djnz_loop:
	; The screen has 24 lines of 8 pixels each, i.e. the screen is 
	; 192 (0xC0) pixels high. Setting the vpos to 0xC8 simply means: 
	; hide.
	ld (hl),0c8h		;4476 Set vpos of the sprite.
	
	; HL += 4, move to next sprite.
	inc hl			;4478
	inc hl			;4479
	inc hl			;447a
	inc hl			;447b

	djnz $-6		;447c if (--B != 0) jump to 0x4776 (4476_hide_sprite_djnz_loop)
	ret			;447e



; Add to score and update hiscore.
;
; Add     1 * (E & 0xF) to score
; Add    10 * (E >> 4)  to score
; Add   100 * (D & 0xF) to score
; Add  1000 * (D >> 4)  to score
; 
; Input:
;   D: BCD score to add
;   E: BCD score to add times 100
;
; Routine                                                             |  D   |  E   | Result
; --------------------------------------------------------------------+------+------+--------------------
; 5501_if_distance_travelled_changed__add_to_score_and_update_hiscore | 0x00 | 0x03 | Add 3 to score.
; --------------------------------------------------------------------+------+------+--------------------
; 775f_grabbed_fuel_heart                                             | 0x03 | 0x00 | Add 300 to score.
; 775f_grabbed_fuel_heart                                             | 0x05 | 0x00 | Add 500 to score.
; 775f_grabbed_fuel_heart                                             | 0x08 | 0x00 | Add 800 to score.
; 775f_grabbed_fuel_heart                                             | 0x10 | 0x00 | Add 1000 to score.
; --------------------------------------------------------------------+------+------+--------------------
; 
; We can get here from:
;   0x551A (call) [from=5501_if_distance_travelled_changed__add_to_score_and_update_hiscore]
;   0x7789 (call) [from=775f_grabbed_fuel_heart]
447f_add_to_score_and_update_hiscore:
	ld c,000h		;447f C = 0x00
	ld a,(0e002h)		;4481
	; Bit 6 (mask 0x40) in 0xE002 means:
	;     0: demo
	;     1: player is playing
	; 
	; When doubled (add a,a), 0x40 becomes 0x80: the sign bit is set 
	; (sign negative). When in demo, we will always have sign 
	; positive.
	add a,a			;4484
	ret p			;4485 if (demo) return
	
	; NOT a demo.
	ld hl,0e03fh		;4486 HL = &bcd_score__tens_and_units
	ld a,(hl)		;4489 A = bcd_score__tens_and_units
	add a,e			;448a A += E
	daa			;448b Compensate for BCD.
	ld (hl),a		;448c bcd_score__tens_and_units = A
	
	inc l			;448d HL = &bcd_score__thousands_and_hundreds
	ld a,(hl)		;448e A = bcd_score__thousands_and_hundreds
	adc a,d			;448f A += D and add carry from tens
	daa			;4490 Compensate for BCD.
	ld (hl),a		;4491 bcd_score__thousands_and_hundreds = A

	inc hl			;4492 HL = bcd_score__hundredthousands_and_tenthousands
	ld a,(hl)		;4493 A = bcd_score__hundredthousands_and_tenthousands
	adc a,c			;4494 A += C and add carry
	daa			;4495 Compensate for BCD.
	ld (hl),a		;4496 bcd_score__hundredthousands_and_tenthousands = A
	jr nc,$+16		;4497 if (no score overflow) jump to 0x44A7
	
	; Score overflowed, fix hiscore to 999,999.
	; 
	; Note: We are storing 0xE03D twice, and 0xE03C and 0xE03E once.
	ld bc,09999h		;4499
	ld (0e03ch),bc		;449c
	ld (0e03dh),bc		;44a0
	ret			;44a4
	
	; ?Unreachable code?
	jr $+52			;44a5 jump to 0x44D9



	; We can get here from:
	;   0x4497 (jump) Score did not overflow
	;
	; A: score (tenthousands and hundredthousands)
	ex de,hl		;44a7
	ld hl,0e044h		;44a8
	cp (hl)			;44ab
	jr c,$+11		;44ac if (A < *HL) jump to 0x44B7
	
	; Reached score of multiple of 50000.
	ld a,(hl)		;44ae
	add a,005h		;44af A += 5
	daa			;44b1 Compensate for BCD
	jr nc,$+4		;44b2 if (not reached max) jump to 0x44B6
	ld a,0ffh		;44b4 A = 0xFF, cap
	
	; We can get here from:
	;   0x44B2 (jump) A is multiple of 5
	;   0x33B4 (fall) A = 0xFF (capped)
	ld (hl),a		;44b6 Store
	
	; We can get here from:
	;   0x44AC (jump)
	;   0x44B6 (fall)
	ld b,003h		;44b7 B = 3 (for djnz at 0x44C4)
	ld hl,0e03eh		;44b9
	ex de,hl		;44bc
	; DE = 0xE03E (hiscore, last of 3 bytes)
	; HL = 0xE041 (score, last of 3 bytes)
	
	44bd_start_of_djnz:
	ld a,(de)		;44bd Load highscore part
	sub (hl)		;44be Subtract current score part
	jr c,$+7		;44bf if (current score part higher than hiscore part) jump to 44c6_copy_score_to_highscore
	ret nz			;44c1 if (current score part less than hiscore) return
	; Current score part equal hiscore part; it is a tie. Check next 
	; score part.
	dec l			;44c2
	dec e			;44c3
	djnz $-7		;44c4 if (--B != 0) jump to 0x44BD

	44c6_copy_score_to_highscore:
	ld bc,00003h		;44c6 LDDR count: 0x0003
	ld e,03eh		;44c9 E = 0x3E
	ld l,041h		;44cb L = 0x41
	lddr			;44cd Copy *HL to *DE BC times, decrementing HL and DE.
	ret			;44cf



; We can get here from:
;   0x41A1 (call) [from=4197_game_state_03_substate_03]
;   0x42DC (call) [from=4270_game_state_04__demo]
44d0_fixme:
	call 044f4h		;44d0 44f4_draw_minimap_speed_fuel
	ld de,0470dh		;44d3 DE = 470d_hiscore_letters
	call 045f0h		;44d6 45f0_show_symbols
	; Fall to 44d9_draw_score_and_hiscore

; We can get here from:
;   0x44D6 (fall) [from=44d0_fixme]                            C == 0xFF (due to calling 45f0_show_symbols)
;   0x6B5F (call) [from=6b5e_car_state_03__reached_checkpoint] C == ?
44d9_draw_score_and_hiscore:
	ld de,0e03eh		;44d9 DE = 0xE03E
	ld hl,03838h		;44dc HL = 0x3838 (name table, start of hiscore)
	call 044e6h		;44df 44e6_fixme

	ld l,098h		;44e2 HL = 0x3898 (name table, start of score)
	ld e,041h		;44e4 DE = 0xE041
	
	44e6_fixme:
	; We can get here from:
	;   0x44DF (call) [from=self] DE == 0xE03E, HL == 0x3838 (name table, start of hiscore)
	;   0x44E4 (fall) [from=self] DE == 0xE041, HL == 0x3898 (name table, start of score)
	ld b,003h		;44e6 B = 0x03
	jr $+77			;44e8 jump to 0x4535 (4535_write_score_or_hiscore)


?No callers?
44ea_fixme:
	ld hl,03836h		;44ea HL = 0x3836
	ld de,0e043h		;44ed DE = &stage
	ld b,001h		;44f0 B = 0x01
	jr $+67			;44f2 jump to 0x4535 (4535_write_score_or_hiscore)



; 0x38B9  . . . . . . . .   . . . . . . . .   . . . . . . . .   . . . . . . . .
;         . . . . . . . .   . . . . . . . .   . . . . . . . .   . . . . . . . .
;         . . . . . . . .   . . . . . . . .   . . . . . . . .   . . . . . . . .
;         . . . . . . . .   . . . . . . . .   . . . . . . . .   . . . . . . . .
;         . . . . . . . .   . . . . . . . .   . . . . . . . .   . . . . . . . .
;         . . . . . . . .   . . . . . . . .   . . . . . . . .   . . . . . . . .
;         x x x x x x x x   x x x x x x x x   x x x x x x x x   x x x x x x x x 
;         x x x x x x x x   x x x x x x x x   x x x x x x x x   x x x x x x x x 
;
; 0x38D9  x x . . . . . .   . . . . . . . .   . x x . . . . .   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x x x x . .   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x x x x x x   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x x x x . .   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x . . . . .   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x . . . . .   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x . . . . .   . . . . . . x x
;         x x . . . . . .   . . . . . . . .   . x x . . . . .   . . . . . . x x
44f4_draw_minimap_speed_fuel:
	44f4_draw_minimap_row_00:
	ld hl,038b9h		;44f4 HL = 0x38B9
	ld a,06fh		;44f7 A = 0x6F
	ld bc,00004h		;44f9 Copy count = 4
	call 0056_FILVRM	;44fc Copy character 0x6F 4 times.

	44ff_draw_minimap_row_01:
	ld l,0d9h		;44ff HL = 0x38D9
	ld de,0452dh		;4501 DE = 0x452D
	ld bc,00004h		;4504 Copy count = 4
	call 45a7_copy2vram	;4507 Copy 4 character IDs from 0x452D to name table at 0x38D9.
	
	450a_draw_minimap_8_lines:
	ld l,0f9h		;450a HL = 0x38F9
	ld b,008h		;450c B = 0x08
	push bc			;450e
		ld de,04531h	;450f DE = 0x4531
		ld bc,00104h	;4512 BC = 0x0104
		call 04575h	;4515 4575_copy2nametable_multiple_partial_rows(source_RAM=DE,destination_VRAM=HL, col_count=C, row_count=B)
	pop bc			;4518
	djnz $-11		;4519 if (--B != 0) jump to 0x450E

	451b_draw_minimap_bottom:
	ld l,0f9h		;451b 0xF9 == 7 * 0x20 + 0x19, last row (7), column 25
	ld a,072h		;451d A = 0x72, character 0x72 is a cyan line
	ld c,004h		;451f C = 4 (copy count)
	call 0056_FILVRM	;4521
	
	; Draw "SPEED FUEL".
	ld de,0476ah		;4524 "SPEED FUEL"
	call 045f0h		;4527 45f0_show_symbols
	
; We can get here from:
;   0x4527 (fall)
;   0x6b02 (jump) crashed
452a_jump_to_draw_speed_and_fuel_gauge:
	jp 0740bh		;452a 740b_draw_speed_and_fuel_gauge



; Row 0x01 (0 based) of the minimap.
;
; Used at 0x4501.
	defb 0x70		;452d #00 Left border
	defb 0x01		;452e #01 All ?black?/?transparent?
	defb 0x60		;452f #02 Purple flag
	defb 0x71		;4530 #03 Right border

; Row 0x02 (0 based) of the minimap.
; Row 0x03 (0 based) of the minimap.
; Row 0x04 (0 based) of the minimap.
; Row 0x05 (0 based) of the minimap.
; Row 0x06 (0 based) of the minimap.
; Row 0x07 (0 based) of the minimap.
; Row 0x08 (0 based) of the minimap.
; Row 0x09 (0 based) of the minimap.
;
; Used at 0x450F.
	defb 0x70		;4531 #00 Left border
	defb 0x73		;4532 #01 Road
	defb 0x01		;4533 #02 All ?black?/?transparent?
	defb 0x71		;4534 #03 Right border



; Input:
;   PO flag: return immediately if PO flag is set. ?I.e. if max score/hiscore?
;   HL: destination VRAM address
;   DE: pointer to byte value to write
;   C: mask, either 0x00 or 0xFF
;   B: loop count
; 
; We can get here from:
;   0x44E8 (jump) [from=44d9_draw_score_and_hiscore,0x44DF] PO == ?, HL == 0x3838, DE == 0xE03E (hiscore BCD), B == 3, C == mask
;   0x44E8 (jump) [from=44d9_draw_score_and_hiscore,0x44E8] PO == ?, HL == 0x3898, DE == 0xE041 (  score BCD), B == 3, C == mask
;   0x44F2 (jump) [from=44ea_fixme]                         PO == ?, HL == 0x3836, DE == 0xE043 (stage      ), B == 1, C == mask (?DEAD CODE?)
4535_write_score_or_hiscore:
	ret po			;4535 if (parity or overflow) return
	nop			;4536 Weird. Useless code.
	
	; We can get here from:
	;   0x4536 (fall) [from=self]
	;   0x455E (djnz) [from=self]
	4537_start_of_djnz_loop:
	; A = *(DE) >> 4, i.e. the high nybble of *(DE) of score (tens/thousands/hundredthousands).
	ld a,(de)		;4537
	rra			;4538
	rra			;4539
	rra			;453a
	rra			;453b
	and 00fh		;453c

	jr z,$+4		;453e if (A == 0) jump to 0x4542
	ld c,0ffh		;4540 C = 0xFF
	
	; We can get here from:
	;   0x453E (jump) C is caller defined
	;   0x4540 (fall) C == 0xFF
	dec b			;4542 --B
	jr nz,$+4		;4543 if (B != 0) jump to 0x4547
	ld c,0ffh		;4545 C = 0xFF
	
	; We can get here from:
	;   0x4543 (jump)
	;   0x4545 (fall) C == 0xFF
	inc b			;4547 ++B, reverse the inc we did at 0x4542.
	add a,010h		;4548 A += 0x10 (pattern '0' is at name table offset #10)
	and c			;454a A &= C
	call 004D_WRTVRM	;454b WRTVRM(VRAM_address=HL, value=A)
	
	inc hl			;454e Next name table entry.
	; A = *(DE) & 0x0F, i.e. the low nybble of *(DE) of score (units/hundreds/tenthousands).
	ld a,(de)		;454f
	and 00fh		;4550

	jr z,$+4		;4552 if (z) jump to 0x4556
	ld c,0ffh		;4554 C = 0xFF
	add a,010h		;4556 A += 0x10 (pattern '0' is at name table offset #10)
	and c			;4558 A &= C
	call 004D_WRTVRM	;4559 WRTVRM(VRAM_address=HL, value=A)
	dec de			;455c Next hiscore entry.
	inc hl			;455d Next name table entry.
	djnz $-39		;455e if (--B != 0) jump to 0x4537
	
	; Whole (hi)score written.
	ret			;4560



; Compute VDP address of coordinates in HL.
; 
; Input: HL
;   H: horizontal position (of whatever)
;   L: vertical   position (of whatever)
; 
; We can get here from:
;   0x6B34 (call) [from=6b1c_out_of_fuel_and_no_more_speed]
;   0x6DA2 (call) [from=6da2_clear_carry_flag_if_HL_is_asphalt]
4561_compute_vdp_address_of_HL_coordinates:
	ld a,l			;4561 A = L
	
	; Computes:
	;   A >>= 6 (i.e. divide by 64) (Each VDP band is 64 pixels high.)
	;   H >>= 3 (i.e. divide by  8) (Each character is 8 pixels wide.)
	;
	; Carry is not of interest here, because of 0x456F.
	rra			;4562 rotate right A through carry
	rra			;4563 rotate right A through carry
	rra			;4564 rotate right A through carry
	rra			;4565 rotate right A through carry
	rr h			;4566 rotate right H
	rra			;4568 rotate right A through carry
	rr h			;4569 rotate right H
	rra			;456b rotate right A through carry
	rr h			;456c rotate right H
	
	ld l,h			;456e L = H
	and 003h		;456f A &= 0x03 (keep lower 2 bits, i.e. bit 0 and bit 1)
	add a,038h		;4571 A += 0x38
	ld h,a			;4573 H = A
	ret			;4574



; Input:
;   B: Repeat count
;   C: Number of bytes to copy
;   DE: RAM address
;   HL: VRAM address
;
; We can get here from:
;   0x4515 (call) [from=44f4_draw_minimap_speed_fuel]  B==0x01, C==0x04, DE==0x4531, HL==0x38F9
;   0x7467 (call) [from=744c_draw_stages_overview_map] B==0x15, C==0x05, DE==0x76EC, HL==0x382B
4575_copy2nametable_multiple_partial_rows:
	4575_start_of_djnz_loop:
	
	push bc			;4575 Store BC, restore at 0x457B.
	ld b,000h		;4576 B = 0
	call 45a7_copy2vram	;4578 45a7_copy2vram(from_ram_addr=DE, to_vram_addr=HL, num_bytes=BC)
	pop bc			;457b Restore BC, stored at 0x4575.
	
	; Go to next VRAM row.
	ld a,020h		;457c A = 0x20
	call 0403bh		;457e HL += A

	djnz $-12		;4581 if (--B != 0) jump to 0x4575 (4575_start_of_djnz_loop)
	
	ret			;4583



; We can get here from:
;   0x411D (call) [from=411a_game_state_00_substate_00]
;   0x49AB (call) [from=49a6_setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo]
4584_clear_name_table_and_set_sprite_00_vpos_to_D0:
	call 04467h		;4584 4467_hide_all_sprites_by_using_special_single_0xD0
	ld hl,03800h		;4587 HL = 0x3800 (VRAM destination, name table)
	ld bc,00300h		;458a B = 0x300 (fill count)
	xor a			;458d A = 0
	; A  - Data byte
	; BC - Length of the area to be written
	; HL - Start address
	jp 0056_FILVRM		;458e



; SETWRT_wrapper
; 
; Input:
;   HL: VRAM address
; 
; Output:
;   C_shadow == 0x98 (VDPs writing port #0)
;
; We can get here from:
;   0x4611 (call) [from=4611_copy2VRAM]
4591_setwrt_wrapper:
	ex af,af'		;4591
	call 0053_SETWRT	;4592 [BIOS]: Set VDP for writing to VRAM, HL=VRAM address
	exx			;4595 Exchange BC, DE, HL with their shadow counter parts.
	; https://map.grauw.nl/resources/msxsystemvars.php says:
	; 
	; Address 0x0006 (VDP.DR) is the base port address for VDP data read.
	ld a,(00006h)		;4596 A = 0x98 (VDP reading port #0)
	ld c,a			;4599 C = A
	exx			;459a Exchange BC, DE, HL with their shadow counter parts.
	ex af,af'		;459b
	ret			;459c



; SETRD_WRAPPER
; 
; Input:
;   HL: VRAM address
; 
; Output:
;   C_shadow = 0x98 (VDPs reading port #0)
459d_setrd_wrapper:
	call 0050_SETRD		;459d [BIOS]: Set VDP for reading from VRAM, HL=VRAM address
	exx			;45a0 Exchange BC, DE, HL with their shadow counter parts.
	ld a,(00007h)		;45a1 A = 0x98 (VDP writing port #0)
	ld c,a			;45a4 C = A
	exx			;45a5 Exchange BC, DE, HL with their shadow counter parts.
	ret			;45a6


; Copy BC bytes from DE (RAM) to HL (VRAM).
;
; ?is this similar to BIOS call LDIRVM (0x005C).?
; 
; Input:
;   BC: Number of bytes to copy
;   DE: RAM address
;   HL: VRAM address
; We can get here from:
;   0x42AD (call) [from=42a1_game_state_04_substate_04]
;   0x4507 (call) [from=44f4_draw_minimap_speed_fuel]
;   0x4578 (call) [from=4575_copy2nametable_multiple_partial_rows]
;   0x45c2 (call) [from=45a7_copy2vram]
;   0x5279 (call) [from=5273_copy_sprites_from_RAM_to_VRAM]
;   0x6B4A (call) [from=6b1c_out_of_fuel_and_no_more_speed]
;   0x73CA (call) [from=73b2_draw_speed_or_fuel_gauge]
;   0x73E6 (call) [from=73b2_draw_speed_or_fuel_gauge]
;   0x73F7 (call) [from=73b2_draw_speed_or_fuel_gauge]
45a7_copy2vram:
	call 0053_SETWRT	;45a7 [BIOS]: Set VDP for writing, HL=VRAM address
	ld a,(00006h)		;45aa A = 0x98, i.e. get VDP's writing port #0.
	
	
	; All registers are used, so use a shadow register (c to be 
	; precise) to store the VDP writing port #0.
	exx			;45ad
	ld c,a			;45ae C = 0x98
	exx			;45af
	
	ld a,(de)		;45b0 A = *(DE)
	exx			;45b1
	out (c),a		;45b2 Write *(DE) to VDP's writing port.
	exx			;45b4
	inc de			;45b5 Increase source RAM address.
	; Note: destination VRAM address is auto incremented by the VDP.
	dec bc			;45b6 Decrement byte counter.
	ld a,b			;45b7
	or c			;45b8
	jr nz,$-9		;45b9 if (BC != 0) jump to 0x45B0
	ret			;45bb



	exx			;45bc
	ld b,003h		;45bd B = 3 (copy to all 3 bands, top+middle+bottom)

	45bf_start_of_djnz:
	exx			;45bf
	push bc			;45c0
	push de			;45c1
	call 45a7_copy2vram	;45c2
	ld de,00800h		;45c5 DE = 0x0800
	add hl,de		;45c8 HL += DE, advance to next band
	pop de			;45c9
	pop bc			;45ca
	exx			;45cb
	djnz $-13		;45cc if (--B != 0) jump to 0x45BF
	ret			;45ce



; We can get here from:
;   0x410B (jump) [from=40ef_draw_road_fighter_logo]                 HL = 0x06B0 (vram address), BC = 0x0058, A = ?
;   0x4787 (jump) [from=4773_copy_symbols_to_VRAM]                   HL = 0x0080 (vram address), BC = 0x0160, A = 0xF0
;   0x48A1 (call) [from=489a_zero_first_0x10_patterns_and_colors]    HL = 0x2000 (vram address), BC = 0x0080, A = 0x00
;   0x48B1 (call) [from=489a_zero_first_0x10_patterns_and_colors]    HL = 0x0000 (vram address), BC = 0x0008, A = 0x00 (inside djnz loop!)
;   0x48DA (jump) [from=48c9_copy_konami_logo_characters_to_vram_3x] HL = 0x0200 (vram address), BC = 0x00D8, A = 0xF0
;   0x697D (call) [from=68aa_push_much_stuff_to_VRAM]                HL = ???
;   0x69F8 (call) [from=6995_stage_04_and_05_something]              HL = 0x0430 (vram address), BC = 0x0038, A = 0x66
;   0x6A03 (jump) [from=6995_stage_04_and_05_something]              HL = 0x0498 (vram address), BC = 0x0038, A = 0x66
;   0x6A27 (call) [from=6a06_fixme]                                  HL = 0x0748 (vram address), BC = 0x0001, A = ?
45cf_filvrm_color_or_pattern_generator:
	ld d,003h		;45cf Loop over all 3 (color or pattern generator) tables (top, middle and bottom section)
	
	; We can get here from:
	;   0x45CF (fall) 1st         (color or pattern generator) table
	;   0x45DD (jump) 2nd and 3rd (color or pattern generator) table
	push bc			;45d1
	push de			;45d2
	
	; HL: Start address
	; A: Data byte
	; BC: Length of the area to be written
	call 0056_FILVRM	;45d3
	ld de,00800h		;45d6 Next section is always 0x800 further
	add hl,de		;45d9 Go to next section.
	pop de			;45da
	pop bc			;45db
	dec d			;45dc --D
	jr nz,$-12		;45dd jump to 0x45D1
	
	ret			;45df



; Both the pattern table and color table are 3 times 0x800 long (0x1800). 
; We can get here from:
;   0x477C (call) [from=4773_copy_symbols_to_VRAM]                                       DE = 0x478A, HL = 0x2080 (pattern generator table)
;   0x48CF (call) [from=48c9_copy_konami_logo_characters_to_vram_3x]                     DE = 0x490F, HL = 0x6200 (pattern generator table)
;   0x49B7 (call) [from=49a6_setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo] DE = 0x4A25, HL = 0x2600 (pattern generator table), 4a25_road_fighter_logo_patterns
;   0x68B0 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x5DEC, HL = 0x2200 (pattern generator table)
;   0x68B9 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x5F25, HL = 0x0200 (color table)
;   0x68C2 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x5FEC, HL = 0x2680 (pattern generator table)
;   0x68CB (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x601D, HL = 0x0680 (color table)
;   0x68DF (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x601F, HL = 0x06A8 (color table)
;   0x68E8 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x5FF7, HL = 0x26C8 (pattern generator table)
;   0x68F1 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x6022, HL = 0x06C8 (color table)
;   0x6905 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x6022, HL = 0x0708 (color table)
;   0x690E (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x6008, HL = 0x2748 (pattern generator table)
;   0x6917 (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x602D, HL = 0x0748 (color table)
;   0x692B (call) [from=68aa_push_much_stuff_to_VRAM]                                    DE = 0x6031, HL = 0x0798 (color table)
;   0x6992 (jump) [from=6989_stage_02_something]                                         DE = 0x63AC, HL = 0x2588 (pattern generator table)
;   0x699B (call) [from=6995_stage_04_and_05_something]                                  DE = 0x63AC, HL = 0x2400 (pattern generator table)
;   0x69AF (call) [from=6995_stage_04_and_05_something]                                  DE = 0x67C2, HL = 0x0588 (color table)
;   0x69B8 (call) [from=6995_stage_04_and_05_something]                                  DE = 0x6645, HL = 0x2400 (pattern generator table)
;   0x69CC (call) [from=6995_stage_04_and_05_something]                                  DE = 0x6737, HL = 0x0400 (color table)
;   0x69D5 (call) [from=6995_stage_04_and_05_something]                                  DE = 0x6737, HL = 0x0468 (color table)
;   0x69DE (call) [from=6995_stage_04_and_05_something]                                  DE = 0x6697, HL = 0x24D0 (pattern generator table)
;   0x69E7 (call) [from=6995_stage_04_and_05_something]                                  DE = 0x69E1, HL = 0x04D0 (color table)
;   0x6A43 (call) [from=6a30_stage_01_and_02_and_03_and_06_something]                    DE = 0x6A51 + 4*A + 0, HL = 0x2400 (pattern generator table)
;   0x6A4E (jump) [from=6a30_stage_01_and_02_and_03_and_06_something]                    DE = 0x6A51 + 4*A + 2, HL = 0x0400 (color table)
;   0x7452 (call) [from=744c_draw_stages_overview_map]                                   DE = 0x74BC, HL = 0x2400 (pattern generator table)
;   0x745B (call) [from=744c_draw_stages_overview_map]                                   DE = 0x7638, HL = 0x0400 (color table)
45e0_copy2VRAM_3x:
	ld b,003h		;45e0 DJNZ: loop counter
	
	45e2_start_of_djnz_loop:
	push bc			;45e2
	push de			;45e3 Compressed VRAM data
	call 4611_copy2VRAM	;45e4
	ld de,00800h		;45e7 DE = 0x0800
	add hl,de		;45ea HL += DE
	pop de			;45eb
	pop bc			;45ec
	djnz $-11		;45ed if (--B != 0) jump to 0x45E2
	ret			;45ef


; Show predefined symbol set on screen, by adjusting the name table.
; 
; Input:
;   HL:
;     Start VRAM address
;   DE:
;     Character ID's
; 
;   Special character ID's:
;     0xFF: marks end: stop copying/showing more symbols
;     0xFE: marks end of current set of symbols, start again with a new VRAM address and set of character ID's
; 
; We can get here from:
;   0x4186 (jump) [from=418e_game_state_03_substate_01]                    DE == 0x4751 "LEVEL A" / "LEVEL B"
;   0x42F0 (call) [from=42ed_show_state_something]                         DE == 0x471f "STAGE"
;   0x436B (call) [from=4364_game_state_07_substate_00]                    DE == 0x475e "GAME OVER"
;   0x44D6 (call) [from=44d0_fixme]                                        DE == 0x470D "HISCORE"
;   0x4527 (call) [from=44f4_draw_minimap_speed_fuel]                      DE == 0x476A "SPEED FUEL"
;   0x49C5 (call) [from=49c2_draw_logo_konami_play_select_level_A_level_B] DE == 0x472A "©KONAMI 1985", "PLAY SELECT", "LEVEL A"
;   0x49C8 (call) [from=49c2_draw_logo_konami_play_select_level_A_level_B] DE == 0x4751 "LEVEL B"
45f0_show_symbols:
	ld c,0ffh		;45f0 C = 0xFF, don't mask the letters/symbols, see 0x4600.



; We can get here from:
;   0x45F0 (fall) C == 0xFF: show symbols
;   0x4609 (jump) C == 0x00: hide symbols
45f2_fill_name_table:
	; HL = DE, DE += 2
	ex de,hl		;45f2
	ld e,(hl)		;45f3
	inc hl			;45f4
	ld d,(hl)		;45f5
	ex de,hl		;45f6
	inc de			;45f7
	; Fall to 45f8_draw_or_hide_characters(start=DE, mask=C)



; Draw or hide characters.
; 
; Input:
;   HL: VRAM destination address
;   DE: Start of characters (end at value 0xFF)
;    C: Mask to apply:
;         0x00: Hide characters
;         0xFF: Show characters
; 
; We can get here from:
;   0x45F7 (fall)
;   0x4605 (jump) end of this draw loop
;   0x5049 (jump) DE == 0x475B, C == 0x00 (hide characters)
45f8_draw_or_hide_characters:
	ld a,(de)		;45f8
	inc de			;45f9
	ld b,a			;45fa
	inc b			;45fb
	ret z			;45fc *(DE@45f8) == 0xFF: we have reached the last entry, stop processing.
	
	inc b			;45fd
	jr z,$-12		;45fe DE contained 0xFE: we have reached the end of this entry, start with next entry at 0x45F2.
	
	and c			;4600 Either 0xFF (see 0x45F0) or 0x00 (see 0x4607).
	call 004D_WRTVRM	;4601 WRTVRM(VRAM_address=HL, value=A)
	inc hl			;4604
	jr $-13			;4605 Jump to 45f8_draw_or_hide_characters(start=DE, mask=C)


; We can get here from:
;   0x4189 (jump)
4607_hide_symbols:
	ld c,000h		;4607 C = 0
	jr $-23			;4609 Jump to 0x45F2



; We can get here from:
;   0x461F (jump)
460b_hl=*de_and_inc_de_twice_and_decompress_and_copy_to_VRAM:
	ex de,hl		;460b
	ld e,(hl)		;460c E = *(HL)
	inc hl			;460d ++HL
	ld d,(hl)		;460e D = *(HL)
	ex de,hl		;460f
	inc de			;4610 ++DE
	; Fall to subroutine 0x4611 (decompress patterns and copy to VRAM)



; Input:
;   HL: destination VRAM address
;   DE: input, opcode first, then data
;     DE[0]:
;       0x00     : Return immediately
;       0x01-0x7F: Copy DE[0] bytes to VRAM, starting from DE[1]
;       0x80     : Change HL (VRAM destination address) to DE[1] (word) and restart routine
;       0x81-0xFF: Copy DE[0]&0x7F times byte DE[1] to VRAM
;     DE[1..]: data to copy to VRAM
; 
; We can get here from:
;   0x45E4 (call) [from=45e0_copy2VRAM_3x]
;   0x4610 (fall) [from=self] HL changed
4611_copy2VRAM:
	call 04591h		;4611 4591_setwrt_wrapper, C_shadow = 0x98 (VDP writing port #0)
	
	; We can get here from:
	;   0x462A (jump)
	;   0x4634 (jump)
	ld a,(de)		;4614 A = *(DE)
	and a			;4615 Set flags.
	ret z			;4616 if (A == 0) return, end of sequence.
	inc de			;4617 
	ld b,a			;4618 DJNZ: loop count = A
	and 07fh		;4619 A &= 0x7F (i.e. clear bit 7)
	cp b			;461b Compute A - B and set flags.
	jr z,$+16		;461c if (DE[0] & 0x80 == 0) jump to 0x462C
	and a			;461e Set flags.
	jr z,$-20		;461f if (DE[0] == 0x80) jump to 460b_hl=*de_and_inc_de_twice_and_decompress_and_copy_to_VRAM
	; Post: DE[0] >= 0x81
	ld b,a			;4621 B = A, set number of times to loop/djnz.
	
	4622_start_of_djnz_loop:
	ld a,(de)		;4622
	inc de			;4623
	exx			;4624
	out (c),a		;4625 Copy to VRAM
	exx			;4627
	djnz $-6		;4628 if (--B != 0) jump to 0x4622
	jr $-22			;462a jump to 0x4614
	
	; Copy the same byte B times to VRAM.
	; We can get here from:
	;   0x461C (jump)
	ld a,(de)		;462c
	inc de			;462d
	
	462e_start_of_djnz_loop:
	exx			;462e
	out (c),a		;462f Copy to VRAM
	exx			;4631
	djnz $-4		;4632 if (--B != 0) jump to 0x462E
	jr $-32			;4634 jump to 0x4614



; Mirror sprites horizontally.
; 
; Input:
;   HL: sprite pattern address in VRAM (source)
;   DE: sprite pattern address in VRAM (destination)
;   C: number of "sprite column patterns" to copy
; 
; Note: Road Fighter uses 16x16 sprites (single pixel), so each pattern 
; is 0x20 bytes. If the 8x8 sprites patterns are A B C D, then the 
; screen displays it as:
; 
;   A | C
;   --+--
;   B | D
; 
; So [A, B] form a column (not a row). Likewise, [C, D] form a column.
; 
; We want to horizontally mirror a 16x16 sprite, like this:
; 
;   Swap columns:             Reverse bits:
;   
;   } | {         { | }       76543210 | hgfedcba         01234567 | abcdefgh
;   --+--   -->   --+--   ,   ---------+---------   -->   ---------+---------
;   ] | [         [ | ]       ponmlkji | xwvutsrq         ijklmnop | qrstuvwx
;
; We can get here from:
;   0x464F (jump) [from=self] C != 0, so copy next "sprite column pattern"
;   0x693C (call) [from=68aa_push_much_stuff_to_VRAM]
;     HL == 0x1880
;     DE == 0x1950
;     C  == 0x06   (number of 16x16 sprites to mirror)
;
;     The following horizontal mirroring is done:
;     
;       C | Source | Pattern | Col | Description                    || Destination | Pattern | Col | Destination description
;       --+--------+---------+-----+--------------------------------++-------------+---------+-------------------------------------
;       6 | 0x1880 | #10/16  | 1st | Shadow of player car facing NE || 0x1950      | #28/40  | 2nd | Shadow of player car facing NW
;       6 | 0x1890 | #10/16  | 2nd | Shadow of player car facing NE || 0x1940      | #28/40  | 1st | Shadow of player car facing NW
;       --+--------+---------+-----+--------------------------------++-------------+---------+-------------------------------------
;       5 | 0x18A0 | #14/20  | 1st |           player car facing NE || 0x1970      | #2C/44  | 2nd |           player car facing NW
;       5 | 0x18B0 | #14/20  | 2nd |           player car facing NE || 0x1960      | #2C/44  | 1st |           player car facing NW
;       --+--------+---------+-----+--------------------------------++-------------+---------+-------------------------------------
;       4 | 0x18C0 | #18/24  | 1st | Shadow of player car facing  E || 0x1990      | #30/48  | 2nd | Shadow of player car facing  W
;       4 | 0x18D0 | #18/24  | 2nd | Shadow of player car facing  E || 0x1980      | #30/48  | 1st | Shadow of player car facing  W
;       --+--------+---------+-----+--------------------------------++-------------+---------+-------------------------------------
;       3 | 0x18E0 | #1C/28  | 1st |           player car facing  E || 0x19B0      | #34/52  | 2nd |           player car facing  W
;       3 | 0x18F0 | #1C/28  | 2nd |           player car facing  E || 0x19A0      | #34/52  | 1st |           player car facing  W
;       --+--------+---------+-----+--------------------------------++-------------+---------+-------------------------------------
;       2 | 0x1900 | #20/32  | 1st | Shadow of player car facing SE || 0x19D0      | #38/56  | 2nd | Shadow of player car facing SW
;       2 | 0x1910 | #20/32  | 2nd | Shadow of player car facing SE || 0x19C0      | #38/56  | 1st | Shadow of player car facing SW
;       --+--------+---------+-----+--------------------------------++-------------+---------+-------------------------------------
;       1 | 0x1920 | #20/36  | 1st |           player car facing SE || 0x19F0      | #3C/60  | 2nd |           player car facing SW
;       1 | 0x1930 | #20/36  | 2nd |           player car facing SE || 0x19E0      | #3C/60  | 1st |           player car facing SW

4636_mirror_sprites_horizontally:
	push de			;4636 Store DE, restore at 0x4648.
	
	; 1 "sprite column pattern" consists of 2 sprite pattern, hence 
	; 0x10 bytes. So we need to mirror 0x10 bytes if we want to 
	; mirror a whole column.
	; 
	; We can get here from:
	;   0x4646 (jump)
	ld b,010h		;4637 DJNZ: loop count == 0x10
	
	4639_start_of_djnz_loop:
	call 04679h		;4639 4679_vram_copy_reverse_bits_to_vram_de(vram_source=HL, vram_destination=DE)
	inc hl			;463c
	inc e			;463d
	djnz $-5		;463e if (--B != 0) jump to 0x4639
	
	; DE -= 0x20, set destination to previous column.
	ld a,e			;4640
	sub 020h		;4641 A -= 0x20
	ld e,a			;4643

	bit 4,e			;4644 Bit 4: mask 0x10
	jr z,$-15		;4646 if (destination column == 1st) jump to 0x4637
	; Post: destination column == 2nd. That means we mirrors the 
	; whole 16x16 sprite.

	pop de			;4648 Restore DE, stored at 0x4636.
	; DE += 0x20
	ld a,020h		;4649 A = 0x20
	call 04040h		;464b DE += A
	dec c			;464e
	jr nz,$-25		;464f if (C ! = 0) jump to 0x4636

	ret			;4651



; Mirror a number of VRAM patterns, in all three VDP 
; patterns band. Mirror in vertical axis.
; 
; Input:
;   HL: source VRAM address (must be the first VDP pattern band)
;   DE: destination VRAM address (must be the first VDP pattern band)
;   C: count - the number of patterns mirror
4652_mirror_VRAM_patterns_in_vertical_axis:
	; B = 3, the number of VDP bands.
	ld b,003h		;4652 B = 3
	
	4654_djnz_vdp_band_loop:
	push bc			;4654
	push hl			;4655 Store HL, restore at 0x4663.
	push de			;4656
	
	4657_pattern_loop:
	; Each pattern consists of 8 bytes.
	ld b,008h		;4657 DJNZ@465E: B = 8
		
		4659_djnz_pattern_line_loop:
		call 04679h	;4659 4679_vram_copy_reverse_bits_to_vram_de
		inc hl		;465c Increase source VRAM address
		inc de		;465d Increase destination VRAM address
		djnz $-5	;465e if (--B != 0) jump to 0x4659 (4659_djnz_pattern_line_loop)
	
	; 1 pattern done, decrease number of patterns left.
	dec c			;4660
	
	jr nz,$-10		;4661 if (not done) jump to 0x4657 (4657_pattern_loop)

	pop hl			;4663 Restore HL, was stored as DE at 0x4656.
	
	; Switch to next VDP band.
	ld de,00800h		;4664 DE = 0x0800
	add hl,de		;4667
	
	ex de,hl		;4668 
	pop hl			;4669
	pop bc			;466a Restore BC, was stored at 0x4654.
	djnz $-23		;466b if (--B != 0) jump to 0x4654 (4654_djnz_vdp_band_loop)
	
	ret			;466d



466e_reverse_bits_of_register_a:
	push bc			;466e Save BC.
	ld c,a			;466f C = A
	ld b,008h		;4670 B = 8
	
	; ?Is the carry zero here?
	
	; Assume c = 'abcdefgh', each letter an unknown bit.
	; Assume a = 'stuvwxyz', each letter an unknown bit.
	;         
	;         | After rr c                  | After rla
	; --------+-----------------------------+------------------
	; Round 0 | c = '*abcdefg', carry = 'h' | carry = 's', a = 'tuvwxyzh'
	; Round 1 | c = 's*abcdef', carry = 'g' | carry = 't', a = 'uvwxyzhg'
	; Round 2 | c = 'ts*abcde', carry = 'f' | carry = 'u', a = 'vwxyzhgf'
	; Round 3 | c = 'uts*abcd', carry = 'e' | carry = 'v', a = 'wxyzhgfe'
	; Round 4 | c = 'vuts*abc', carry = 'd' | carry = 'w', a = 'xyzhgfed'
	; Round 5 | c = 'wvuts*ab', carry = 'c' | carry = 'x', a = 'yzhgfedc'
	; Round 6 | c = 'xwvuts*a', carry = 'b' | carry = 'y', a = 'zhgfedcb'
	; Round 7 | c = 'yxwvuts*', carry = 'a' | carry = 'z', a = 'hgfedcba'
	;                                                           ^^^^^^^^
	;                                                           All bits reversed!
	4672_loop:
	rr c			;4672 Rotate right reg c via carry.
	rla			;4674 Rotate left  reg a via carry.
	djnz $-3		;4675 if (--B != 0) jump to 0x4672
	
	pop bc			;4677 Restore BC
	ret			;4678



; HL: VRAM source
; DE: VRAM destination
4679_vram_copy_reverse_bits_to_vram_de:
	call 004A_RDVRM		;4679 A = vram[HL]
	call 0466eh		;467c 466e_reverse_bits_of_register_a
	ex de,hl		;467f
	call 004D_WRTVRM	;4680 vram[HL] = A
	ex de,hl		;4683
	ret			;4684



; We can get here from:
;   0x4072 (call) [404f_entry_point] interrupt_sentry == 1
4685_setup_PSG_and_VDP:
	; PSG: disable noise, all 3 channels.
	; PSG: enable tone, all 3 channels.
	ld a,0b8h		;4685 A = 0xB8
	call 04bf6h		;4687 4bf6_configure_and_store_PSG_sound_and_noise_generator_control_register
	
	ld a,01bh		;468a A = 0x1B (silence, on all 3 PSG channels)
	call 0407fh		;468c jumps to 4b6e_sound_something_with_D_is_0
	
	; Clear whole 0x4000 (16KiB) of VRAM.
	xor a			;468f A = 0x00
	ld h,a			;4690 H = 0x00
	ld l,a			;4691 L = 0x00
	ld bc,04000h		;4692 BC = 0x4000
	; HL == 0x0000: Address
	; BC == 0x4000: Length
	; A  == 0x00  : Data
	call 0056_FILVRM	;4695


; We can get here from:
;   0x411A (call) [from=411a_game_state_00_substate_00]
;   0x4695 (fall)
4698_setup_VDP_registers:
	ld hl,046a9h		;4698 HL = 0x46A9
	ld d,008h		;469b D = 8, loop 8 times
	ld c,000h		;469d C = 0
	
	; We are going to loop 8 times, starting with VDP register 0. 
	; This means we will write the following VDP registers:
	;
	; (Source: https://www.msx.org/wiki/Category:VDP_Registers) 
	;   VDP register 0 (D==8): Screen mode, video output,interruption line, color bus setting
	;   VDP register 1 (D==7): Screen mode, sprites size, Vblank, Display, VRAM mode setting
	;   VDP register 2 (D==6): Pattern layout table setting (Foreground)
	;   VDP register 3 (D==5): Colors table setting
	;   VDP register 4 (D==4): Patterns generator table setting
	;   VDP register 5 (D==3): Sprites attribute table setting
	;   VDP register 6 (D==2): VDP Table Base Address Registers
	;   VDP register 7 (D==1): Text and screen margin color setting
	;
	; We can get here from:
	;   0x469D (fall)      HL == 0x46A9
	;   0x46A6 (jump/loop) HL is increased by 1
	ld b,(hl)		;469f
	call 0047_WRTVDP	;46a0 B: data to write, C: Number of the register (=0)
	inc hl			;46a3
	inc c			;46a4
	dec d			;46a5
	jr nz,$-7		;46a6 if (loop counter != 0) jump to 0x469F
	ret			;46a8
	
	; Data for VDP register #00.
	;   0x01 (0): disable external VDP input
	;   0x02 (1): M3=1: Graphics/Screen 2 Mode (since M1=0,M2=0)
	;   0x04 (0): Reserved, must be 0.
	;   0x08 (0): Reserved, must be 0.
	;   0x10 (0): Reserved, must be 0.
	;   0x20 (0): Reserved, must be 0.
	;   0x40 (0): Reserved, must be 0.
	;   0x80 (0): Reserved, must be 0.
	defb 0x02		;46a9
	
	; Data for VDP register #01, contains 8 VDP option control bits.
	;   0x01 (0): MAG0 sprites (1X)
	;   0x02 (1): Size 1 sprites (16 x 16 bit)
	;   0x04 (0): Reserved, must be 0.
	;   0x18 (00): M1=0,M2=0: Graphics/Screen 2 Mode (since M3=1)
	;   0x20 (1): Enables VDP interrupt.
	;   0x40 (1): Enable the active display.
	;   0x80 (1): Selects 16K bytes of VRAM (instead of 4K).
	defb 0xE2		;46aa
	
	; Data for VDP register #02, name table base address.
	;   0x0F (    1110): 0x0E * 0x400 == 0x3800
	;   0x10 (   0    ): Reserved, must be 0.
	;   0x20 (  0     ): Reserved, must be 0.
	;   0x40 ( 0      ): Reserved, must be 0.
	;   0x80 (0       ): Reserved, must be 0.
	defb 0x0E		;46ab
	
	; Data for VDP register #03, color table base address.
	;   Non screen 2 mode:
	;   mask=0xFF (01111111): 0x7F * 0x40 == 0x1FC0
	;   
	;   Screen 2 mode (http://www.msxblog.es/wp-content/uploads/2009/09/vdpprogrammersguide.pdf):
	;   mask=0x7F ( 1111111): Must be 1 in screen 2 mode.
	;   mask=0x80 (0       ): Color table base address is 0x0000.
	defb 0x7F		;46ac
	
	; Data for VDP register #04, pattern generator base address.
	;   Non screen 2 mode:
	;   0x07 (     111): 0x07 * 0x800 == 0x3800
	;   0x08 (    0   ): Reserved, must be 0.
	;   0x10 (   0    ): Reserved, must be 0.
	;   0x20 (  0     ): Reserved, must be 0.
	;   0x40 ( 0      ): Reserved, must be 0.
	;   0x80 (0       ): Reserved, must be 0.
	;
	;   Screen 2 mode (http://www.msxblog.es/wp-content/uploads/2009/09/vdpprogrammersguide.pdf):
	;   0x07 (     111): Pattern generator base address is 0x2000.
	;   0xF8 (00000   ): Must be 0 in screen 2 mode.
	defb 0x07		;46ad
	
	; Data for VDP register #05, sprite attribute table base address.
	;   mask=0x7F ( 1110110): 0x76 * 0x80 == 0x3B00
	;   mask=0x80 (0       ): Reserved, must be 0.
	defb 0x76		;46ae
	
	; Data for VDP register #06, sprite pattern generator base address.
	;   0x03 (     011): 0x03 * 0x800 == 0x1800
	;   0x08 (    0   ): Reserved, must be 0.
	;   0x10 (   0    ): Reserved, must be 0.
	;   0x20 (  0     ): Reserved, must be 0.
	;   0x40 ( 0      ): Reserved, must be 0.
	;   0x80 (0       ): Reserved, must be 0.
	defb 0x03		;46af
	
	; Data for VDP register #07, text color.
	;   0x0F (    0100): backdrop color, 0x04 == dark blue
	;   0xF0 (1110    ): text color, 0x0E == gray
	defb 0xE4		;46b0



; MSX2+: Set the VRAM page (3 high order bits of the address counter).
; 
; Note: register 14 does not exist in the MSX 1 (TMS9929A for instance).
; 
; We can get here from:
;   0x49A8 (call) [from=49a6_setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo] B == 0xE0
46b1_write_B_to_vdp_register_14:
	ld c,00eh		;46b1 C = 0x0E, VDP register to write to. 14 decimal.
	jp 04038h		;46b3 4038_wrtvdp_jump(data=B, register_number=0x0E)



; Read keyboard/joystick, and stored in 0xE009 (= &pressed_keys).
;
; Keys that weren't pressed in the previous interrupt, but are pressed 
; now, are stored in 0xE008 
; (= &pressed_keys_but_not_during_previous_interrupt).
; 
; We can get here from:
;   0x4023 (call) [from=4013_H_KEYINT_hook]
46b6_read_and_save_joystick_and_keyboard:
	call 046c3h		;46b6 46c3_read_joystick_and_keyboard
	ld hl,0e009h		;46b9 HL = pressed_keys
	; Fall to 46bc_save_pressed_keys_in_HL__save_newly_pressed_keys_in_HL_minus_1.



; We can get here from:
;   0x43C9 (call) [from=43c3_game_state_handler]                  HL == 0xE03A
;   0x46B9 (fall) [from=46b6_read_and_save_joystick_and_keyboard] HL == 0xE009 (pressed_keys)
46bc_save_pressed_keys_in_HL__save_newly_pressed_keys_in_HL_minus_1:
	ld c,(hl)		;46bc C = previous keyboard/joystick input
	ld (hl),a		;46bd Save new keyboard/joystick input

	xor c			;46be Compute all differences between previous and current input
	and (hl)		;46bf Select only differences in currently pressed input.
	
	; HL: 0xE009 -> 0xE008 (= &pressed_keys_but_not_during_previous_interrupt)
	; HL: 0xE03A -> 0xE039 (?)
	dec hl			;46c0
	ld (hl),a		;46c1 Save newly pressed keys.

	ret			;46c2



; Output: register A, with the following bit meaning:
;   0x01 Status of "Up"
;   0x02 Status of "Down"
;   0x04 Status of "Left"
;   0x08 Status of "Right"
;   0x10 Status of "Space" / trigger 1
;   0x20 Status of "Select" / trigger 2
46c3_read_joystick_and_keyboard:	
	; PSG Register 0x0F (15):
	;   This register makes it possible to control the pins of the general ports to read 
	;   via register 14 as well as the state of the LED "code" or "kana" depending on the 
	;   type of keyboard.
	;
	; 0x8F:
	;   yes 0x80 (bit 7) LED control of the "Code" or "Kana" key. (1 to turn off)
	;   no  0x40 (bit 6) selection of the general port readable via register 14 (1 for port 2)
	;   no  0x20 (bit 5) pin control 8 of the general port 2 (0 for standard joystick mode)
	;   no  0x10 (bit 4) pin control 8 of the general port 1 (0 for standard joystick mode)
	;   yes 0x08 (bit 3) pin control 7 of the general port 2*
	;   yes 0x04 (bit 2) pin control 6 of the general port 2*
	;   yes 0x02 (bit 1) pin control 7 of the general port 1*
	;   yes 0x01 (bit 0) pin control 6 of the general port 1*
	;
	; Read joystick A, turn LED off.
	ld e,08fh		;46c3 A = 0x8F (data to write to PSG reg 15)
	ld a,00fh		;46c5 A = 0x0F (PSG reg)
	call 0093_WRTPSG	;46c7 A: PSG reg, E: data
	
	
	
	; PSG Register 0x0E (14):
	;
	; Bit 0 = Pin 1 state of the selected general port (Up if joystick)
	; Bit 1 = Pin 2 state of the selected general port (Down if joystick)
	; Bit 2 = Pin 3 state of the selected general port (Left if joystick)
	; Bit 3 = Pin 4 state of the selected general port (Right if joystick)
	;
	; Bit 4 = Pin 6 state of the selected general port (Trigger 1 if joystick)
	; Bit 5 = Pin 7 state of the selected general port (Trigger 2 if joystick)
	; Bit 6 = 1 for JIS, 0 for JP50on (only valid for Japanese MSX)
	; Bit 7 = CASRD (Reading signal on cassette)
	ld a,00eh		;46ca A = 0x0E
	di			;46cc
	call 0096_RDPSG		;46cd The value read is stored in register A.
	ei			;46d0
	cpl			;46d1 Flip all bits (because joystick port is active low).
	and 03fh		;46d2 up, down, left, right, trigger 1, trigger 2.
	push af			;46d4 Save joystick state.
	
	
	
	;;;
	; Read keyboard.
	;;;
	
	; Note: the player can use both keyboard and joystick A at the 
	; same time. The keys read from the keyboard are therefore 
	; mapped to the same bits as the joystick, so we can OR them at 
	; the end.
	
	; Get status of "Select" key.
	; 
	; Line 7:
	; 0x80   0x40   0x20      0x10 0x08 0x04   0x02 0x01
	; Return Select	Backspace Stop Tab  Escape F5   F4
	;        ?End?
	ld a,007h		;46d5 A = 0x07, the line of the keyboard matrix to get.
	call 0141_SNSMAT	;46d7 Get specified line from the keyboard matrix.
	cpl			;46da Flip all bits (because keyboard matrix is active low).
	rrca			;46db Rotate right, bit 0 goes to both bit 7 and the carry bit.
	and 020h		;46dc A &= 0x20 ("Select" key)
	ld e,a			;46de E = A
	
	
	
	; Get status of spacebar and arrow keys.
	;
	; Line 8:
	; 0x80 0x40 0x20 0x10 0x08 0x04 0x02 0x01
	;        |    ^
	; --->   |    |  <---  DEL  INS HOME SPACE
	;        V    |
	ld a,008h		;46df A = 8, the line of the keyboard matrix to get.
	call 0141_SNSMAT	;46e1 Get specified line from the keyboard matrix.
	cpl			;46e4 Flip all bits (because keyboard matrix is active low).
	rrca			;46e5 rotate right: space right down up left del ins home
	rrca			;46e6 rotate right: home space right down up left del ins
	ld b,a			;46e7 Save A
	and 004h		;46e8 A &= 0x04, get status of "Left" key
	or e			;46ea A |= E, add status of "Select" key (0x20 or 0x00)
	ld c,a			;46eb
	; Post: Bit meaning of register C:
	;   0x04 Status of "Left" key
	;   0x20 Status of "Select" key
	
	ld a,b			;46ec home space right down up left del ins
	rrca			;46ed ins home space left down up right del
	rrca			;46ee del ins home space right down up left
	ld b,a			;46ef Save
	and 018h		;46f0 Get status of "Space" key (0x10) and "Right" key (0x08).
	or c			;46f2 Add status of "Left" and "Select" key
	ld c,a			;46f3 Save
	; Post: Bit meaning of register C:
	;   0x04 Status of "Left" key
	;   0x08 Status of "Right" key
	;   0x10 Status of "Space" key
	;   0x20 Status of "Select" key
	
	ld a,b			;46f4 del ins home space right down up left
	rrca			;46f5 left del ins home space right down up
	and 003h		;46f6 Get status of "Down" key and "Up" key
	or c			;46f8 Add status of "Left"+"Right"+"Space"+"Select"
	; Post: Bit meaning of register A:
	;   0x01 Status of "Up" key
	;   0x02 Status of "Down" key
	;   0x04 Status of "Left" key
	;   0x08 Status of "Right" key
	;   0x10 Status of "Space" key
	;   0x20 Status of "Select" key
	
	pop bc			;46f9 B = joystick A state (see push at 0x46D4)
	or b			;46fa Combine input from keyboard and joystick
	; Post: Bit meaning of register A:
	;   0x01 Status of "Up"
	;   0x02 Status of "Down"
	;   0x04 Status of "Left"
	;   0x08 Status of "Right"
	;   0x10 Status of "Space"  / trigger 1
	;   0x20 Status of "Select" / trigger 2
	
	ret			;46fb



46fc_line_and_software_letters:
	defw 0x394A		;46fc VRAM destination: name table, below Konami logo
	
	defb 0x0C		;46fe Copy count
	defb 0x5A		;46ff Write character 0x5A (line) 0x0C (12) times to name table.
	
	defb 0x80		;4700 Special opcode: change HL
	; HL = 0x396C
	defb 0x6C		;4701 L = 0x6C
	defb 0x39		;4702 H = 0x39
	; Post: VRAM destination: name table, below line below Konami logo
	
	defb 0x88		;4703 Copy 0x08 character IDs to the name table. 0x08 == 0x88 & 0x7F.
	
	; "SOFTWARE"
	defb 0x33		;4704 "S"
	defb 0x2F		;4705 "O"
	defb 0x26		;4706 "F"
	defb 0x34		;4707 "T"
	defb 0x37		;4708 "W"
	defb 0x21		;4709 "A"
	defb 0x32		;470a "R"
	defb 0x25		;470b "E"

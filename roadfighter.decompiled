; Color sets for the Road Fighter logo. There are four sets, each with 2 
; byte elements:
; 
;   byte #00: dark color
;   byte #01: light color.
;  
; Total size: 4 element * 2 bytes per element == 8 bytes
; 
; Used at 0x40F2.
4112_road_fighter_logo_blink_colors:
	defb 0x40		;4112 #00.0 FG=dark blue        , BG=transparent
	defb 0x70		;4113 #00.1 FG=light blue (cyan), BG=transparent
	defb 0x60		;4114 #01.0 FG=dark red         , BG=transparent
	defb 0x90		;4115 #01.1 FG=light red        , BG=transparent
	defb 0xA0		;4116 #02.0 FG=dark yellow      , BG=transparent
	defb 0xF0		;4117 #02.1 FG=light yellow     , BG=transparent
	defb 0x60		;4118 #03.0 FG=dark red         , BG=transparent
	defb 0x90		;4119 #03.1 FG=light red        , BG=transparent




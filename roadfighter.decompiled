	add hl,bc		;5688
	
	jr $+13			;5689 jump to 0x5696
	
	
	
	; We can get here from:
	;   0x5680 (jump) [from=self]
	ld b,004h		;568b DJNZ@5694: B = 0x04
	ld de,0e06eh		;568d DE = 0xE06E
	
	5690_start_of_djnz_loop:
	ld a,(hl)		;5690
	ld (de),a		;5691
	dec de			;5692
	inc hl			;5693
	djnz $-4		;5694 if (--B != 0) jump to 0x5690 (5690_start_of_djnz_loop)
	
	; We can get here from:
	;   0x5689 (jump) [from=self]
	;   0x5694 (fall) [from=self]
	ld (0e094h),hl		;5696
	jp 0553ah		;5699 553a_post_routine_for_all_stages_something



; Data, see 0x5621. Stage 4+5.
	defw 0x7C92		;569c #00
	defw 0x7CA1		;569e #01
	defw 0x7CB0		;56a0 #02 Stage 4+5, left scenery.
	defw 0x7D7C		;56a2 #03

; Data, see 0x5669. Only for stage 5? Railroad track
	defw 0x7D94		;56a4 #00
	defw 0x7DC5		;56a6 #01 7dc5_shoreline_pattern_names
	defw 0x7E26		;56a8 #02
	defw 0x7D94		;56aa #03



; Stage 6
; 
; We can get here from:
;   0x5523 (call) Jump table entry for stage 6.
56ac_stage_06_specific_code:
	ld de,0e058h		;56ac DE = 0xE058
	call 056cch		;56af 56cc_fixme
	
	ld b,00ah		;56b2 B = 0x0A
	call 056ceh		;56b4 56ce_fixme
	
	ld hl,(0e090h)		;56b7
	inc hl			;56ba
	inc hl			;56bb
	ld (0e090h),hl		;56bc
	ld a,(hl)		;56bf
	
	; Check for special value 0xFF.
	inc a			;56c0
	jr nz,$+8		;56c1 if (nz) jump to 0x56C9
	
	; Special value 0xFF detected.
	ld hl,07fe4h		;56c3 HL = 0x7FE4
	ld (0e090h),hl		;56c6 *(0xE090) = 0x7FE4
	
	; We can get here from:
	;   0x56C1 (jump) not special value.
	;   0x56C6 (fall) special value.
	jp 05534h		;56c9



; We can get here from:
;   0x5566 (call) [from=5563_stage_03_specific_code] DE == 0xE058
;   0x56AF (call) [from=56ac_stage_06_specific_code] DE == 0xE058
56cc_fixme:
	ld b,00ch		;56cc B = 0x0C (12)

; We can get here from:
;   0x56CC (fall) Stage == 3, DE == 0xE058, B == 0x0C
;   0x56CC (fall) Stage == 6, DE == 0xE058, B == 0x0C
;   0x56B4 (call) Stage == 6, DE == ?,      B == 0x0A
56ce_fixme:
	ld hl,(0e090h)		;56ce HL = *(0xE090)

	; HL points to a BIG endian word (weird!). Dereference and store 
	; back in HL.
	ld a,(hl)		;56d1 A = *(HL)
	inc hl			;56d2 ++HL
	ld l,(hl)		;56d3 L = *(HL)
	ld h,a			;56d4 H = A

	ld a,(0e043h)		;56d5 A = stage
	cp 003h			;56d8 Compute stage - 3 and set flags.
	jr z,$+17		;56da if (stage == 3) jump to 0x56EB
	
	; Stage == 6 (since stage==3 jumped away)
	;
	; HL *= 2
	sla l			;56dc L <<= 1
	rl h			;56de H <<= 1 (actually a rotate left)
	ld a,080h		;56e0 A = 0x80
	jr c,$+4		;56e2 if (c) jump to 0x56E6
	ld a,00fh		;56e4 A = 0x0F



	; We can get here from:
	;   0x56E2 (jump)           A == 0x80, B == 0x0C
	;   0x56E4 (fall) [stage 6] A == 0x0F, B == 0x0C or 0x0A
	;   0x56F1 (jump)           A == 0x9B, B == 0x0C
	;   0x56F5 (jump)           A == 0x04, B == 0x0C
56e6_start_of_djnz_loop:
	ld (de),a		;56e6 *(DE) = A
	inc de			;56e7 --DE
	djnz $-19		;56e8 if (--B != 0) jump to 0x56D5
	ret			;56ea



	; We can get here from:
	;   0x56DA (jump) Stage == 3
	; HL *= 2
	sla l			;56eb L <<= 1
	rl h			;56ed H <<= 1 (actually a rotate left)

	ld a,09bh		;56ef A = 0x9B
	jr c,$-11		;56f1 if (c) jump to 0x56E6
	ld a,004h		;56f3 A = 0x04
	jr $-15			;56f5 jump to 0x56E6



; We can get here from:
;   0x5537 (call) [from=5537_post_routine_for_stage_01_02_04_06]
;   0x5642 (call) [from=5642_stage_05_specific_code]
;   0x5890 (jump) [from=585f_read_and_handle_new_track_data_pointer_1]
;   0x58A8 (jump) [from=585f_read_and_handle_new_track_data_pointer_1]
56f7_fixme:
	ld a,(0e07ah)		;56f7 A = current_track_layout
	; Special value 0xFE is seen at:
	;   Stage 1: 0x78E4
	;   Stage 2: 0x7ACC
	;   Stage 3: 0x7ACC
	;   Stage 4: 0x7EA7
	;   Stage 5: 0x7E7C-0x7E82
	;   Stage 6: 0x7ED0
	cp 0feh			;56fa Compute A - 0xFE and update Z/NZ flag.
	jr nz,$+5		;56fc if (current_track_layout != 0xFE) jump to 0x5701
	call 050bfh		;56fe 50bf_setup_stage_specific_stuff_and_jump_to_stage_specific_code

	; We can get here from:
	;   0x56FC (jump) current_track_layout != 0xFE (call to 0x50BF is SKIPPED)
	;   0x56FE (fall) current_track_layout == 0xFE (call to 0x50BF is DONE)
	call 0590eh		;5701 590e_update_left_side_of_the_road

	ld a,(0e07ah)		;5704 A = current_track_layout
	and 00fh		;5707 A = current_track_layout__modifier
	call 04045h		;5709 PC = PC[2 * A]

	; Jump table for 0x5709.
	defw 0x5768		;570c #00 5768_update_first_line_of_track_data_in_RAM
	defw 0x5810		;570e #01 5810_handle_track_layout_data__track_must_bend
	defw 0x5810		;5710 #02 5810_handle_track_layout_data__track_must_bend
	defw 0x57A7		;5712 #03 57a7_fixme
	defw 0x57A7		;5714 #04 57a7_fixme



; We can get here from:
;   0x5540 (call) [from=553a_post_routine_for_all_stages_something]
5716_fixme:
	ld hl,(0e046h)		;5716 HL = *(0xE046)
	ld bc,0ffeah		;5719 BC = -0x16
	add hl,bc		;571c HL -= 0x16 (22)
	ld (0e046h),hl		;571d
	ld bc,0e170h		;5720 BC = 0xE170
	and a			;5723 Reset carry flag, for sbc.
	sbc hl,bc		;5724 HL -= BC
	jr nz,$+8		;5726 if (*(0xE046) != 0xE186) jump to 0x572E
	
	; Reset *0xE046 to value 0xE380: the last row of coarse pattern 
	; name table.
	ld hl,0e380h		;5728 HL = 0xE380
	ld (0e046h),hl		;572b
	
	; Copy 1 line of new coarse to current coarse.
	ld de,(0e046h)		;572e
	ld hl,0e058h		;5732 HL = 0xE058
	ld bc,00016h		;5735 LDIR: loop count == 22
	ldir			;5738 do { *(DE++) = *(HL++) } while (--BC)
	; Fall to 573a_copy_coarse_to_VRAM.



; We can get here from:
;   0x41C5 (call) [from=41c2_game_state_03_substate_06]
;   0x4337 (call) [from=4325_game_state_06__player_car_crashed]
;   0x5738 (fall) [from=5716_fixme]
573a_copy_coarse_to_VRAM:
	ld hl,03801h		;573a HL = 0x3801, VDP name table, character 1 (character 0 is elsewhere set to black)
	ld a,018h		;573d A = 0x18, 24 character per line
	ld de,(0e046h)		;573f DE = course_pattern_names
	
	; We can get here from:
	;   0x573F (fall) A == 0x18, HL = 0x3801
	;   0x5764 (jump)
	ex af,af'		;5743 Store A. Restore at 0x5763.
	call 0053_SETWRT	;5744 [BIOS]: Set VDP for writing, HL=VRAM address
	ld a,(00006h)		;5747
	ld c,a			;574a C = VDP I/O port
	ld b,016h		;574b DJNZ: loop count == 0x16 (22)
	
	574d_start_of_djnz_loop:
	ld a,(de)		;574d
	out (c),a		;574e
	inc de			;5750
	djnz $-4		;5751 if (--B != 0) jump to 0x573D
	
	ld a,0e3h		;5753 A = 0xE3
	cp d			;5755 Compute A - D and set flags.
	jr nz,$+10		;5756 if (D != 0xE3) jump to 0x5760
	
	ld a,096h		;5758 A = 0x96
	cp e			;575a
	jr nz,$+5		;575b if (DE != 0xE396) jump to 0x5760
	; Post: DE is past last value of coarse pattern names, i.e. stop 
	; copying.
	ld de,0e186h		;575d DE = E186_coarse_pattern_name_table
	
	; We can get here from:
	;   0x5756 (jump)
	;   0x573D (fall) DE == 0xE186
	ld c,020h		;5760 C = 0x20 (32)
	add hl,bc		;5762 HL += 0x20
	ex af,af'		;5763 Restore A. Stored at 0x5743.
	dec a			;5764
	jr nz,$-34		;5765 if (A != 0) jump to 0x5743
	; Post: A == 0
	ret			;5767



; We can get here from:
;   0x5709 (jump) index #00 of jump table
5768_update_first_line_of_track_data_in_RAM:
	; if (--track_layout_lines_left == 0) jump to 0x585F
	ld hl,0e07bh		;5768 HL = &track_layout_lines_left
	dec (hl)		;576b --track_layout_lines_left
	jp z,0585fh		;576c if (track_layout_lines_left == 0) jump to 0x585F

	ld hl,(0e06fh)		;576f HL = track_data_pointer
	ld a,(hl)		;5772
	inc a			;5773
	; Post: if *(HL) == 0xFF (special value) then A == 0
	jr nz,$+8		;5774 if (nz) jump to 0x577C
	
	; track_data_pointer == 0xFF, so reset track data pointer.
	ld hl,05998h		;5776 HL = 0x5998
	ld (0e06fh),hl		;5779
	
	; We can get here from:
	;   0x5774 (jump) HL == track_data_pointer
	;   0x5779 (fall) HL == 0x5998
	
	; DE = &(start_of_track_of_top_row)
	ld a,(0e07dh)		;577c A = number of horizontal scenery characters before track start (top row)
	ld de,0e058h		;577f DE = 0xE058 (?start of pattern names of top row?)
	add a,e			;5782
	ld e,a			;5783
	


; We can get here from:
;   0x5783 (fall) [from=5768_update_first_line_of_track_data_in_RAM]
;   0x584B (call) [from=5810_handle_track_layout_data__track_must_bend]
5784_copy_track_something:
	; Copy left border of track.
	ldi			;5784 *(DE++) = *(HL++), --BC
	
	; B = current_track_layout__num_lanes & 0x03
	; 
	; Hence, B in [0,1,2,3] (although 0 and 3 are not used).
	; 
	; B == 0 means: must copy 1 lane: not used, but it is (somehwat playable)
	; B == 1 means: must copy 2 lanes
	; B == 2 means: must copy 3 lanes
	; B == 3 means: must copy 4 lanes: not used, game freezes is used (through poking)
	ld a,(0e07ah)		;5786 A = current_track_layout
	rra			;5789 A >>= 1
	rra			;578a A >>= 1, total: 2
	rra			;578b A >>= 1, total: 3
	rra			;578c A >>= 1, total: 4, low nybble now contains former high nybble.
	and 003h		;578d Keep only new bits 0 and 1 (former bits 4 and 5).
	ld b,a			;578f B = A
	
	; Note: -(A - 2) == 2 - A
	;
	; current_track_layout & 0x30 == 0x10 --> B == 1 --> A == 1
	; current_track_layout & 0x30 == 0x20 --> B == 2 --> A == 0
	sub 002h		;5790 A -= 0x02
	neg			;5792
	
	; A *= 3
	;
	; current_track_layout & 0x30 == 0x10 --> B == 1 --> A == 3
	; current_track_layout & 0x30 == 0x20 --> B == 2 --> A == 0
	ld c,a			;5794 C = A
	add a,a			;5795 A *= 2
	add a,c			;5796 A += C
	
	; Compute which track data to start copying.
	;
	; current_track_layout & 0x30 == 0x10 --> B == 1 --> A == 3 --> HL + 3 (skip 1 lane)
	; current_track_layout & 0x30 == 0x20 --> B == 2 --> A == 0 --> HL + 0 (skip 0 lanes)
	call 0403bh		;5797 HL += A
	
	; Compute the LDIR loop count (BC):
	;
	;     C = 3 * (B + 1)
	;     (and set B = 0 afterwards)
	;
	; current_track_layout & 0x30 == 0x10 --> B == 1 --> C == 6
	; current_track_layout & 0x30 == 0x20 --> B == 2 --> C == 9
	inc b			;579a ++B
	ld a,b			;579b A = B
	add a,a			;579c A *= 2
	add a,b			;579d A += B
	ld c,a			;579e C = A
	ld b,000h		;579f B = 0
	
	; Copy the correct amount of lane data from the correct starting point.
	ldir			;57a1 do { *(DE++) = *(HL++) } while (--BC)

	; Store track data pointer.
	ld (0e06fh),hl		;57a3 track_data_pointer = HL

	ret			;57a6



; Target of jump table entries at 0x5712 and 0x5714.
57a7_fixme:
	; Determine which character must be used as left side of the 
	; track (white or white with black dash).
	ld hl,05808h		;57a7 HL = 5808_vertical_pattern_of_left_side_of_straight_track
	ld a,(0e07bh)		;57aa A = track_layout_lines_left
	and 007h		;57ad A = track_layout_lines_left & 0x07 (keep bits 0+1+2)
	call 0403bh		;57af HL += A
	
	; DE = 0xE058 + *(0xE07D)
	;
	; Determine memory location of left side of straight track.
	ld a,(0e07dh)		;57b2 A = horizontal offset of left side of track
	ld de,0e058h		;57b5 DE = 0xE058
	add a,e			;57b8
	ld e,a			;57b9
	
	; Copy the character ID of the left side of the track to the 
	; VRAM buffer.
	ldi			;57ba *(DE++) = *(HL++)
	; Post: DE == 0xE059


	; Copy track data to VRAM buffer.
	;   Source:      HL == track_data_pointer + (9 - *(0xE081)
	;   Destination: DE == 0xE059 (left most track)
	;   Count:       BC == *(0xE081)
	ld hl,(0e06fh)		;57bc LDIR: source: track_data_pointer
	ld a,(0e081h)		;57bf A = *(0xE081)
	ld c,a			;57c2 LDIR: count: *(0xE081)
	sub 009h		;57c3 A -= 9
	neg			;57c5 A = -A, so A == 9 - *(0xE081)
	call 0403bh		;57c7 HL += A
	ld b,000h		;57ca B = 0 (only C is used in LDIR)
	ldir			;57cc do { *(DE++) = *(HL++) } while (--BC)

	inc hl			;57ce
	inc hl			;57cf
	ld (0e06fh),hl		;57d0 track_data_pointer = HL

	ld hl,0e07bh		;57d3 HL = &track_layout_lines_left
	ld a,(hl)		;57d6 A = track_layout_lines_left
	sub 001h		;57d7
	ld (hl),a		;57d9
	jp m,0585fh		;57da if (m) jump to 0x585F (585f_read_and_handle_new_track_data_pointer_1)

	ld a,(hl)		;57dd
	and 007h		;57de
	ret nz			;57e0
	ld a,(hl)		;57e1
	and a			;57e2
	ret z			;57e3
	ld a,(0e07ah)		;57e4 A = current_track_layout
	ld hl,0e081h		;57e7
	inc (hl)		;57ea
	and 00fh		;57eb A = current_track_layout__modifier
	cp 003h			;57ed Compute A - 0x03 and update Z/NZ flag.
	jr z,$+4		;57ef if (current_track_layout__modifier == 0x03) jump to 0x57F3
	dec (hl)		;57f1
	dec (hl)		;57f2

	; We can get here from:
	;   0x57EF (jump) [from=self]
	;   0x57F2 (fall) [from=self]
	ld a,(0e07ah)		;57f3 A = current_track_layout
	ld b,a			;57f6 B = current_track_layout
	and 00fh		;57f7 A = current_track_layout__modifier
	add a,a			;57f9 A *= 2
	ld hl,0593ah		;57fa HL = 593a_track_names
	call 0403bh		;57fd HL += A

	; HL = *(HL)
	ld a,(hl)		;5800
	inc hl			;5801
	ld h,(hl)		;5802
	ld l,a			;5803

	ld (0e06fh),hl		;5804 track_data_pointer = HL
	ret			;5807



; Vertical pattern of left side of straight track:
;   3 times regular
;   1 time with black dash
5808_vertical_pattern_of_left_side_of_straight_track:
	defb 0xE7		;5808 #00 ?Left side of track, plain white?
	defb 0xE7		;5809 #01
	defb 0xE6		;580a #02 ?Left side of track, with black dash?
	defb 0xE7		;580b #03
	defb 0xE7		;580c #04
	defb 0xE7		;580d #05
	defb 0xE6		;580e #06
	defb 0xE7		;580f #07



; This routines handles the track layout data, defined by table 0x5161:
;   Stage 01: 0x78C4
;   Stage 02: 0x7AAA
;   Stage 03: 0x7AAA
;   Stage 04: 0x7E83
;   Stage 05: 0x7E60
;   Stage 06: 0x7EA8
;
; We can get here from:
;   0x5709 (jump) [from=56f7_fixme] Jump table entry #01: Track must bend to the left
;   0x5709 (jump) [from=56f7_fixme] Jump table entry #02: Track must bend to the right
5810_handle_track_layout_data__track_must_bend:
	; if (--track_layout_lines_left == 0x00) jump to 0x5852
	ld hl,0e07bh		;5810 HL = &track_layout_lines_left
	dec (hl)		;5813 --track_layout_lines_left
	jr z,$+62		;5814 if (track_layout_lines_left == 0x00) jump to 0x5852
	;
	; Post: track_layout_lines_left != 0x00
	;
	; if (track_layout_lines_left & 0x07 != 0x00) jump to 0x583E
	ld a,(hl)		;5816 A = track_layout_lines_left
	and 007h		;5817 A = track_layout_lines_left & 0x07, keep lower 3 bits
	jr nz,$+37		;5819 if (track_layout_lines_left & 0x07 != 0x00) jump to 0x583E
	;
	; Post: track_layout_lines_left & 0x07 == 0x00.
	;
	; Since 0xE07B is decreased when a new track line is added, the 
	; following code will hit after 8 add track lines. (Track layout 
	; lines are always a multiple of 8.)
	;
	ld a,(0e07ah)		;581b A = current_track_layout
	and 00fh		;581e A = current_track_layout__modifier
	ld hl,0e07dh		;5820 HL = 0xE07D
	inc (hl)		;5823 Track starts 1 character more to the right.
	cp 002h			;5824 Compute A - 0x02 and update Z/NZ flag.
	jr z,$+4		;5826 if (current_track_layout__modifier == 0x02) jump to 0x582A
	dec (hl)		;5828 Undo 0x5823.
	dec (hl)		;5829 Track starts 1 character more to the left.
	
	; We can get here from:
	;   0x5826 (jump)
	;   0x5829 (fall)
	ld a,(0e07ah)		;582a A = current_track_layout
	ld b,a			;582d B = current_track_layout
	and 00fh		;582e A = current_track_layout__modifier
	add a,a			;5830 A *= 2 (elements at 0x593A are pointers)

	; 0x593A is a list of 5 pointers to (track) data: [0x5998, 0x59C1, 0x5A19, 0x5A1B, 0x59C3]
	ld hl,0593ah		;5831 HL = 593a_track_names
	call 0403bh		;5834 HL = 593a_track_names + A

	; HL = *(HL)
	ld a,(hl)		;5837
	inc hl			;5838
	ld h,(hl)		;5839
	ld l,a			;583a

	ld (0e06fh),hl		;583b track_data_pointer = HL

	; We can get here from:
	;   0x5819 (jump) [from=self]
	;   0x583B (fall) [from=self]
	ld hl,(0e06fh)		;583e HL = track_data_pointer
	ld a,(0e07dh)		;5841 A = *(0xE07D)

	; DE = 0xE058 + A
	ld de,0e058h		;5844 DE = 0xE058 (?upcoming_coarse_line?)
	add a,e			;5847
	ld e,a			;5848

	ldi			;5849 *(DE++) = *(HL++)
	call 05784h		;584b 5784_copy_track_something
	ld (0e06fh),hl		;584e track_data_pointer = HL
	ret			;5851
	
	; We can get here from:
	;   0x5814 (jump)
	ld a,(0e07ah)		;5852 A = current_track_layout
	and 00fh		;5855 A = current_track_layout__modifier
	ld hl,0e07dh		;5857 HL = 0xE07D
	cp 001h			;585a Compute A - 0x01 and update Z/NZ flag.
	jr z,$+3		;585c if (current_track_layout__modifier == 0x01) jump to 0x585F
	inc (hl)		;585e



; We can get here from:
;   0x576C (jump) [from=5768_update_first_line_of_track_data_in_RAM]
;   0x57DA (jump) [from=57a7_fixme]
;   0x585C (jump] [from=5810_handle_track_layout_data__track_must_bend]
;   0x585E (fall) [from=5810_handle_track_layout_data__track_must_bend]
585f_read_and_handle_new_track_data_pointer_1:
	; Copy 2 byte from ?data pointer 1?.
	ld hl,(0e071h)		;585f LDIR: source
	ld de,0e07ah		;5862 LDIR: destination: &current_track_layout
	ld bc,00002h		;5865 LDIR: count
	ldir			;5868 do { *(DE++) = *(HL++) } while (--BC)
	ld (0e071h),hl		;586a

	ld a,(0e07ah)		;586d A = current_track_layout
	ld b,a			;5870 B = current_track_layout
	and 00fh		;5871 A = &current_track_layout__modifier
	cp 002h			;5873 Compute A - 0x02 and update Z/NZ flag.
	jr nz,$+6		;5875 if (&current_track_layout__modifier != 0x02) jump to 0x587B
	
	; Move left side of the road 1 character to the left.
	ld hl,0e07dh		;5877 HL = 0xE07D
	dec (hl)		;587a --*(HL)
	
	; We can get here from:
	;   0x5875 (jump) [from=self]
	;   0x587A (fall) [from=self]
	add a,a			;587b A *= 2, entries are 2 bytes (i.e. words)
	ld hl,0593ah		;587c HL = 593a_track_names
	call 0403bh		;587f HL = 593a_track_names + A
	ld a,(hl)		;5882 A = 593a_track_names[A]
	inc hl			;5883 ++HL

	; The entries of table 0x593A are pointers. Dereference.
	; 
	; HL = *(HL)
	ld h,(hl)		;5884
	ld l,a			;5885

	ld (0e06fh),hl		;5886 track_data_pointer = HL
	ld a,b			;5889 A = current_track_layout (see 0x5870)
	and 00fh		;588a A = current_track_layout__modifier
	sub 003h		;588c A = current_track_layout__modifier - 3
	cp 002h			;588e Compute A - 0x02 and update C/NC flag.
	jp nc,056f7h		;5890 if (current_track_layout__modifier not in [3,4]) jump to 0x56F7 (56f7_fixme)
	;
	; Post: current_track_layout__modifier in [3, 4]
	ex af,af'		;5893 A' = current_track_layout__modifier - 3
	ld a,b			;5894 A = current_track_layout (see 0x5870)
	
	; A = current_track_layout__num_lanes
	rra			;5895
	rra			;5896
	rra			;5897
	rra			;5898
	and 00fh		;5899

	ld b,a			;589b B = current_track_layout__num_lanes
	ex af,af'		;589c A = current_track_layout__modifier - 3 (see 0x5893)
	add a,b			;589d A = current_track_layout__modifier - 3 + current_track_layout__num_lanes
	ld hl,058abh		;589e HL = 58ab_track_width_table (this table is right after this routine)
	call 0403bh		;58a1 HL += A
	ld a,(hl)		;58a4
	ld (0e081h),a		;58a5
	jp 056f7h		;58a8 56f7_fixme



; Number of bytes of track to copy to VRAM buffer.
; 
; Direct code references:
;   0x589E [from=585f_read_and_handle_new_track_data_pointer_1]: Value is stored in 0xE081.
58ab_track_width_table:
	defb 0x04		;58ab #00
	defb 0x07		;58ac #01
	defb 0x06		;58ad #02
	defb 0x09		;58ae #03



; We can get here from:
;   0x5534 (call) Stage 1 and 6
;   0x5545 (call) Stage 2
58af_update_coarse_something_for_stage_1_2_6:
	ld hl,0e07fh		;58af HL = 0xE07F
	dec (hl)		;58b2
	jr z,$+12		;58b3 if (z) jump to 0x58BF
	
	ld hl,0e086h		;58b5 HL = 0xE086
	ld a,(hl)		;58b8
	cp 001h			;58b9
	ret z			;58bb
	
	dec (hl)		;58bc
	jr $+47			;58bd jump to 0x58EC
	
	
	
	; We can get here from:
	;   0x58B3 (jump) HL == 0xE07F
	ld (hl),008h		;58bf *(0xE07F) = 0x08
	
	; Advance some data pointer.
	ld hl,(0e073h)		;58c1 HL = *(0xE073)
	inc hl			;58c4
	ld (0e073h),hl		;58c5
	
	ld a,(hl)		;58c8
	inc a			;58c9 ++A
	jr z,$+29		;58ca if (special value 0xFF) jump to 0x58E7
	
	dec a			;58cc --A
	and 00fh		;58cd A &= 0x0F
	add a,a			;58cf A *= 2
	ld hl,(0e075h)		;58d0
	call 0403bh		;58d3 HL += A
	ld a,(hl)		;58d6
	inc hl			;58d7
	ld h,(hl)		;58d8
	ld l,a			;58d9
	ld b,(hl)		;58da
	inc hl			;58db
	ld c,(hl)		;58dc
	ld (0e085h),bc		;58dd
	inc hl			;58e1
	ld (0e087h),hl		;58e2
	jr $+7			;58e5 jump to 0x58EC
	
	
	
	; We can get here from:
	;   0x58CA (jump) Seen special value 0xFF.
	ld a,008h		;58e7
	ld (0e086h),a		;58e9
	
	; We can get here from:
	;   0x58E5 (jump)
	;   0x58E9 (fall)
	ld hl,(0e073h)		;58ec
	ld a,(hl)		;58ef
	
	; Return if special value 0xFF.
	inc a			;58f0
	ret z			;58f1 if (special value 0xFF) return
	dec a			;58f2
	
	; (A /= 16) *= 2
	rra			;58f3
	rra			;58f4
	rra			;58f5
	rra			;58f6
	and 00fh		;58f7
	add a,a			;58f9 A *= 2
	
	; Set LDIR destination.
	; 
	; DE = 0xE058 + A
	ld de,0e058h		;58fa DE = 0xE058 ?22 pattern names?
	add a,e			;58fd
	ld e,a			;58fe
	
	; Set LDIR count to *(0xE085).
	ld a,(0e085h)		;58ff
	ld c,a			;5902
	ld b,000h		;5903 B = 0x00
	
	ld hl,(0e087h)		;5905 LDIR: source
	ldir			;5908 do { *(DE++) = *(HL++) } while (--BC)
	
	ld (0e087h),hl		;590a
	ret			;590d



; We can get here from:
;   0x5701 (call) [from=56f7_fixme]
590e_update_left_side_of_the_road:
	; The left side of the road changes, so copy current values 
	; "downwards" in time, i.e.:
	;   *(0xE0AE) -->copy to--> (0xE0AF)
	;   (...)
	;   *(0xE098) -->copy to--> (0xE099)
	ld hl,0e0aeh		;590e LDDR: source
	ld de,0e0afh		;5911 LDDR: destination
	ld bc,00017h		;5914 LDDR: count (0x18)
	lddr			;5917 do { *(DE--) = *(HL--) } while (--BC)
	; Post: HL = 0xE097
	
	; Calculate the new left side of the road and store in 0xE098.
	
	; C = current_track_layout__modifier
	ld a,(0e07ah)		;5919
	and 003h		;591c Keep only bit 0 and 1.
	ld c,a			;591e
	
	; left_side_of_road_ish_table[0] = (*(0xE07D) << 2) | current_track_layout__modifier
	ld a,(0e07dh)		;591f
	sla a			;5922 A *= 2
	sla a			;5924 A *= 2
	or c			;5926 A |= current_track_layout__modifier
	inc hl			;5927 HL = &left_side_of_road_ish_table
	ld (hl),a		;5928 left_side_of_road_ish_table[0] = A

	ret			;5929



; Initializes the next coarse line (0xE058, 22 bytes) with the pattern 
; specified by the value in 0xE089 (the stage specific default pattern 
; ID).
; 
; We can get here from:
;   0x551D (call) [from=551d_init_next_coarse_line_and_jump_to_stage_specific_routine]
592a_init_next_coarse_line:
	ld hl,0e058h		;592a HL = 0xE058
	ld de,0e059h		;592d DE = &stage_specific_default_coarse_pattern_ID
	ld a,(0e089h)		;5930 A = stage_specific_default_coarse_pattern_ID
	ld (hl),a		;5933
	ld bc,00015h		;5934 LDIR: loop count (21)
	ldir			;5937 do { *(DE++) = *(HL++) } while (--BC)
	ret			;5939



; Data. Pointers.
;
; Direct code references:
;   0x57FA
;   0x5831
;   0x587C
593a_track_names:
	defw 0x5998		;593a Track names: straight ahead
	defw 0x59C1		;593c Track names: moving to right
	defw 0x5A19		;593e Track names: moving to left
	defw 0x5A1B		;5940 Track names: moving to left
	defw 0x59C3		;5942 Track names: moving to right



; We can get here from:
;   0x553A (call) [from=553a_post_routine_for_all_stages_something]
5944_if_finish_in_sight_then_write_checkpoint_or_goal_to_RAM_buffer:
	ld hl,(0e078h)		;5944 HL = distance travelled (high+mid byte)
	ld bc,00f09h		;5947 DE = distance where checkpoint/goal is
	and a			;594a Clear carry flag.
	sbc hl,bc		;594b HL -= BC (carry flag is not set)
	ret nz			;594d if (checkpoint/goal is not in sight) return

	ld hl,(0e046h)		;594e HL = pointer to coarse pattern names, index 0x00
	ld bc,0001ch		;5951 BC = 0x001C
	add hl,bc		;5954 HL = pointer to coarse pattern names, index 0x1C
	ex de,hl		;5955 DE = pointer to coarse pattern names, index 0x1C

	ld hl,0596dh		;5956 HL = 596d_start_of_check_point_pattern_ids
	ld c,00bh		;5959 C = 0x0B (length of "CHECK POINT")
	ld a,(0e043h)		;595b A = stage
	cp 006h			;595e
	jr nz,$+10		;5960 if (stage != 6) jump to 0x596A
	ld hl,05978h		;5962 HL = 5978_start_of_goal
	ld c,005h		;5965 C = 0x05 (length of "GOAL ")
	inc de			;5967 Manually center "GOAL ".
	inc de			;5968 Manually center "GOAL ".
	inc de			;5969 Manually center "GOAL ".
	
	; We can get here from:
	;   0x5960 (jump) stage 1/2/3/4/5, HL points to "CHECK POINT"
	;   0x5969 (fall) stage 6        , HL points to "GOAL"
	ldir			;596a Copy "CHECK POINT"/"GOAL".
	ret			;596c
	


596d_start_of_check_point_pattern_ids:
	defb 0x23		;596d #00 C (start of "CHECK POINT")
	defb 0x28		;596e #01 H
	defb 0x25		;596f #02 E
	defb 0x23		;5970 #04 C
	defb 0x2b		;5971 #05 K
	defb 0x00		;5972 #06 (space/black)
	defb 0x30		;5973 #07 P
	defb 0x2f		;5974 #08 O
	defb 0x29		;5975 #09 I
	defb 0x2e		;5976 #0A N
	defb 0x34		;5977 #0B T
	
5978_start_of_goal:
	defb 0x27		;5978 #00 G (start of "GOAL")
	defb 0x2f		;5979 #01 O
	defb 0x21		;597a #02 A
	defb 0x2c		;597b #03 L
	defb 0x3B		;597c #04 (space/black)



597d_update_minicar_vpos_and_color:
	; HL = 4 * distance_travelled
	ld hl,(0e078h)		;597d HL = distance_travelled (middle and high byte)
	add hl,hl		;5980 HL *= 2
	add hl,hl		;5981 HL *= 2

	ld a,h			;5982 A = H
	ld hl,e10e_mcar_vpos	;5983 HL = 0xE10E
	sub 06ch		;5986 A -= 0x6C
	neg			;5988 A = -A
	ld (hl),a		;598a Store vpos of minicar

	ld l,011h		;598b HL = 0xE111 (minicar sprite color)
	
	; Check game ticker.
	ld a,(0e003h)		;598d A = game_state_ticker
	and 00fh		;5990 A &= 0x0F
	ret nz			;5992 if ((game_state_ticker & 0x0F) != 0) return
	
	; (game_state_ticker & 0x0F) == 0
	ld a,006h		;5993 minicar color = dark red
	
	; Alternate between dark red and transparent
	xor (hl)		;5995 A ^= *(HL)
	ld (hl),a		;5996 *(HL) = A
	
	ret			;5997



; The names of the characters/patterns that make up the default track. 
; There are 3 sets:
; 
;     1. 3 lanes of straight ahead track.
;     2. 3 lanes of track, moving to the RIGHT.
;     3. 3 lanes of track, moving to the LEFT.
; 
; Note, the sets are displayed in ASCII, descending. But during the 
; games, the sets are build from top to bottom (since new lines of track 
; are put at the top of the screen, and the already present track is 
; copied downwards. So, the ASCII version below appear to go right when 
; the actual track goes left (and vice versa).
;
; Code references:
;   0x593A - All 5 elements points to this data (with different offsets).
;
; Every byte is a VDP name, so every byte here represents an 8x8 
; image/character/pattern.

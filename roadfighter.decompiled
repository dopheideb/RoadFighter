; We can get here from:
;   0x553D (call) [from=553a_post_routine_for_all_stages_something]
54af_oil_something:
	ld hl,0e0b4h		;54af HL = 0xE0B4
	ld a,(hl)		;54b2 A = *(0xE0B4)
	or a			;54b3 Set Z/NZ flag.
	jr nz,$+44		;54b4 if (nz) jump to 0x54E0

	ld hl,(0e0b2h)		;54b6 HL = &oil_details.distance_high_byte
	ld a,(0e079h)		;54b9 A = high byte of distance travelled
	cp (hl)			;54bc Compute A - oil_details.distance_high_byte and update Z/NZ flag.
	ret nz			;54bd if (A - oil_details.distance_high_byte != 0x00) return
	
	; Oil (water?) on the road.
	inc hl			;54be HL = oil_details.type
	ld a,(hl)		;54bf A == 0x00 means black oil, A == 0x01 means blue oil.
	inc hl			;54c0 HL = next oil_details
	ld (0e0b2h),hl		;54c1 &oil_details = HL
	
	; 0x54F9-0x54FC (index #00), 4 patterns forming black oil tile.
	; 0x54FD-0x5500 (index #01), 4 patterns forming blue oil tile.
	ld hl,054f9h		;54c4
	add a,a			;54c7 A *= 2
	add a,a			;54c8 A *= 2
	call 0403bh		;54c9 HL += A
	ld (0e0b5h),hl		;54cc

	ld a,002h		;54cf A = 2
	ld (0e0b4h),a		;54d1
	ld a,(0e098h)		;54d4 A = *(0xE098)
	rra			;54d7 A >>= 1
	rra			;54d8 A >>= 1
	and 03fh		;54d9 A &= 0x3F (so rotation was actually a shift right).
	add a,002h		;54db A += 2
	ld (0e0b7h),a		;54dd
	
	; We can get here from:
	;   0x54B4 (jump)
	;   0x54DD (fall)
	ld hl,(0e0b5h)		;54e0
	ld a,(0e0b7h)		;54e3
	ld de,0e058h		;54e6
	call 04040h		;54e9 DE += A
	ld bc,00002h		;54ec LDIR: copy count == 0x02
	ldir			;54ef do { *(DE++) = *(HL++) } while (--BC)

	ld (0e0b5h),hl		;54f1
	ld hl,0e0b4h		;54f4
	dec (hl)		;54f7
	ret			;54f8



; Data, see 0x54C4. Oil tiles.
;
; Black oil. Visualization:
;   . . . . . . . .   . . . . . . . .
;   . . . . . . . .   . . . . . . . .
;   . . . . . . . .   . . . . . . . .
;   . . . . . . . .   x x x x . . . .
;   . . . . . . . x   x x x x x . . .
;   . . . . . . x x   x x . . x x . .
;   . . . . . . x x   x x x . x x x .
;   . . . . . x x x   x x x x . x x .
;

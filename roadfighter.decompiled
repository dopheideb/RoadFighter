	xor a			;51d1 A = 0x00
	ld (0e0b9h),a		;51d2 grabbed_fuel_hearts_streak_count = 0x00
	
	jp 07020h		;51d5 7020_moving_object__compute_and_set_next_pair_of_initial_values



; Set sprites #03 upto and including sprite #0E to vpos 0xC8. (It sets 
; hpos, pattern and color to 0xC8, but that is besides the meaning of 
; this routine.)

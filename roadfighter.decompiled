; Copy sprites attributes array from RAM to VRAM.
; 
; Input
;   BC: number of bytes to copy (not the number of sprites)
;
; We can get here from:
;   0x526E (jump) BC == 0x0034 (copy 13 sprites)
;   0x5270 (fall) BC == 0x0078 (copy 30 sprites)
5273_copy_sprites_from_RAM_to_VRAM:
	ld de,0e10eh		;5273 DE = 0xE10E, the start of sprites in RAM.
	ld hl,03b00h		;5276 0x3B00 == sprite attribute table
	call 45a7_copy2vram	;5279
	ret			;527c



; We can get here from:
;   0x4322 (jump) [from=4306_game_state_05_substate_02]
527d_fixme:
	call 05270h		;527d 5270_copy_30_sprites_from_RAM_to_VRAM
	call 06a70h		;5280 6a70_handle_newly_pressed_left_and_right_and_jump_to_correct_car_state_routine
	call 06ca1h		;5283 6ca1_fixme
	call 0738ch		;5286 738c_update_distance_travelled
	call 05501h		;5289 5501_if_distance_travelled_changed__add_to_score_and_update_hiscore
	jp 0528fh		;528c ?WHY, it is the next op, isn't it?

; We can get here from:
;   0x528c (jump) [from=527d_fixme] Basically an expensive fall.
	ld b,00bh		;528f B = 0x0B
	ld hl,0e116h		;5291 HL = 0xE116 sprite attributes of ?opponent cars?

	5294_start_of_djnz_loop:
	inc hl			;5294 
	inc hl			;5295
	inc hl			;5296
	inc hl			;5297
	ld a,(hl)		;5298
	sub 0c0h		;5299 A -= 0xC0
	cp 020h			;529b Compute A - 0x20 and update C/NC flag.
	jr c,$+14		;529d if (0xC0 <= (*HL) <= 0xDF) jump to 0x52AB
	ld a,(hl)		;529f
	sub 006h		;52a0 A -= 0x06
	ld (hl),a		;52a2
	inc hl			;52a3
	inc hl			;52a4
	inc hl			;52a5
	inc hl			;52a6
	ld (hl),a		;52a7
	; We can get here from:
	;   0x52A7 (fall)
	;   0x52A8 (jump)
	djnz $-20		;52a8 if (--B != 0) jump to 0x5294
	ret			;52aa

	; We can get here from:
	;   0x529D (jump)
	ld a,b			;52ab A = B
	cp 001h			;52ac Compute A - 1 and set flags.
	jp z,0416ah		;52ae if (A == 1) jump to 416a_increase_substate
	ld a,004h		;52b1 A = 4
	call 0403bh		;52b3 HL += 4
	jr $-14			;52b6 jump to 0x52A8



; Set the demo stage pseudo randomly to stage 1 or 2 or 3.
;   50% chance for stage 1
;   25% chance for stage 2
;   25% chance for stage 3

; We can get here from:
;   0x415A (call) [from=415a_game_state_02_substate_02]
52b8_set_demo_stage_pseudo_randomly:
	; num_stage_wraparounds = 0
	xor a			;52b8 A = 0x00
	ld hl,0e042h		;52b9 HL = &num_stage_wraparounds
	ld (hl),a		;52bc *(0xE042) = 0x00
	
	; Make C pseudo random.
	ld a,r			;52bd Add pseudo randomness.
	add a,h			;52bf A += 0xE0, futile since (0xE0 & 3) == 0
	ld c,a			;52c0 C = A
	
	; Make A (the stage to be) in [1,2,3,4], pseudo randomly.
	ld a,(0e003h)		;52c1 A = game_state_ticker (which has some randomness here)
	add a,c			;52c4 A += C, adds "randomness".
	and 003h		;52c5 A &= 0x03, A is "randomly" chosen to be in [0,1,2,3].
	inc a			;52c7 ++A
	; Post: A in [1,2,3,4] (but "random" due to 0x52BD)
	
	; There is no demo for stage 4. Rewrite stage 4 to be actually 
	; stage 1.
	cp 004h			;52c8 Compute A - 4 and update Z/NZ flag.
	jr nz,$+4		;52ca if (A != 4) jump to 0x52CE

	; Post: A == 4
	ld a,001h		;52cc A = 1
	
	; We can get here from:
	;   0x52CA (jump) A in [1,2,3]
	;   0x52CC (fall) A == 1
	inc hl			;52ce HL = &stage (0xE043)
	ld (hl),a		;52cf stage = A
	ret			;52d0



; ?Used during demo?
; 
; We can get here from:
;   0x4139 [from=4139_game_state_02_substate_01]
52d1_fudge_currently_pressed_keys_to_keep_near_left_side_of_the_road:
	ld a,(0e049h)		;52d1 A = car_state
	cp 004h			;52d4
	jr nz,$+14		;52d6 if (car_state != CAR_STATE_SKIDDING) jump to 0x52E4
	
	; Car state: skidding (still recoverable by steering)
	ld a,(0e0b1h)		;52d8 A = skid_ticks_remaining
	cp 015h			;52db Compute A - 0x15 and update C/NC flag.
	jr nc,$+7		;52dd if (skid_ticks_remaining >= 0x15) jump to 0x52E4. 0x15 == 21
	
	; Case: skid_ticks_remaining < 0x15
	;
	; pressed_keys_but_not_during_previous_interrupt = (KEY_STATE_RIGHT | KEY_STATE_LEFT)
	ld a,00ch		;52df A = (KEY_STATE_RIGHT | KEY_STATE_LEFT)
	ld (0e008h),a		;52e1 pressed_keys_but_not_during_previous_interrupt = (KEY_STATE_RIGHT | KEY_STATE_LEFT)
	
	; We can get here from:
	;   0x52D6 (jump) car_state != skidding
	;   0x52DD (jump) car_state == skidding, skid_ticks_remaining >= 0x15
	;   0x52E1 (fall) car_state == skidding, skid_ticks_remaining <  0x15
	ld a,(0e0aah)		;52e4 Left side of the road of row 19, where the demo car (almost) is.
	and 0fch		;52e7 A &= 0xFC (clears bit 0 and 1)
	add a,a			;52e9 A *= 2
	add a,01ah		;52ea A += 0x1A
	ld c,a			;52ec C = A

	ld a,(0e04eh)		;52ed A = car_hpos
	sub c			;52f0 A -= C
	add a,001h		;52f1 A += 1
	cp 007h			;52f3 Compute A - 7 and set flags.
	jr c,$+23		;52f5 if (car_hpos < C + 6) jump to 0x530C (530c_no_steering_needed)
	; Post: steering needed, to the left or to the right.
	
	ld a,(0e04eh)		;52f7 A = car_hpos
	cp c			;52fa Compute A - C and update C/NC flag.
	ld b,008h		;52fb B = 8 (steer right)
	jr c,$+4		;52fd if (car_hpos < C ) jump to 0x5301
	ld b,004h		;52ff B = 4 (steer left)
	
	; We can get here from:
	;   0x52FD (jump) B == KEY_STATE_RIGHT
	;   0x52FF (fall) B == KEY_STATE_LEFT
	ld a,(0e009h)		;5301 A = pressed_keys
	or b			;5304 A |= B
	
	; We can get here from:
	;   0x5304 (fall) A == pressed_keys | B
	;   0x530D (jump) A == 0x00
	ld b,010h		;5305 B = KEY_STATE_SPACE
	or b			;5307 A |= B, "space"/trigger 1 is marked/fudged as currently pressed.
	ld (0e009h),a		;5308 pressed_keys = A
	ret			;530b

	; We can get here from:
	;   0x52F5 (jump)
	530c_no_steering_needed:
	xor a			;530c A = 0x00, don't steer right nor left.
	jr $-8			;530d jump to 0x5305



; Dead data? 
	defb 0x3E		;530f ???
	defb 0x04		;5310 ???




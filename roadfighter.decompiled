; The length of each element (1 line) is 0x15 bytes. See also 0x49EA.
4b2f_fighter_pattern_names:
	; Start of the first line.
	defb 0xC0		;4b2f #00 F
	defb 0xCD		;4b30 #01 F
	defb 0x00		;4b31 #02
	defb 0xCE		;4b32 #03 I
	defb 0x00		;4b33 #04
	defb 0xC4		;4b34 #05 G

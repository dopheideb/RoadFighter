	;     0x62 |          0x5C |                            0xFE |                                   0x0E | C      | Left side of player's car overlaps 2 pixels with right side of the oil drum.
	;     0x63 |          0x5C |                            0xFF |                                   0x0F | C      | Left side of player's car overlaps 1 pixels with right side of the oil drum.
	;     0x64 |          0x5C |                            0x00 |                                   0x10 | NC     | Left side of player's car is 0 pixels away from right side of the oil drum.
	;     0x65 |          0x5C |                            0x01 |                                   0x11 | NC     | Left side of player's car is 1 pixel  away from right side of the oil drum.
	; ---------+---------------+---------------------------------+----------------------------------------+--------+-----------------------------------------------------------------------------
	jr c,$+63		;546a if (overlap) jump to 0x54A9 (54a9_disabe_oil_drum_and_reset_car_and_stop_fuel_heart_sound_and_draw_speed_and_fuel_gauge)
	
	; We can get here from:
	;   0x545E (jump) [from=self]
	;   0x546A (fall) [from=self]
	; 
	; DE = oil_drum.vertical_speed
	ld hl,0e10ah		;546c HL = oil_drum.vertical_speed__lo_byte
	ld e,(hl)		;546f
	inc hl			;5470 HL = oil_drum.vertical_speed__hi_byte
	ld d,(hl)		;5471
	
	; oil_drum.vpos_word += oil_drum.vertical_speed
	ld hl,(0e106h)		;5472 HL = oil_drum.vpos_word
	add hl,de		;5475
	ld (0e106h),hl		;5476
	
	; DE = oil_drum.horizontal_speed
	ld hl,0e10ch		;5479 HL = oil_drum.horizontal_speed__lo_byte
	ld e,(hl)		;547c
	inc hl			;547d HL = oil_drum.horizontal_speed__hi_byte
	ld d,(hl)		;547e
	
	; oil_drum.hpos_word += oil_drum.horizontal_speed
	ld hl,(0e108h)		;547f HL = oil_drum.hpos_word
	add hl,de		;5482
	ld (0e108h),hl		;5483
	
	; Copy vpos to RAM sprite #0C.
	ld hl,0e107h		;5486 HL = oil_drum.vpos
	ld de,0e13eh		;5489 DE = &sprite_attrs_0C + 0
	ldi			;548c *(DE++) = *(HL++), --BC
	; Post: DE == &sprite_attrs_0C + 1 (hpos)
	
	; Copy hpos to RAM sprite #0C.
	inc hl			;548e HL = oil_drum.hpos
	ldi			;548f *(DE++) = *(HL++), --BC
	; Post: DE == &sprite_attrs_0C + 2 (pattern)
	
	; Set pattern depending on the game state ticker.
	;   0x6C: oil drum is north     /south      oriented
	;   0x70: oil drum is north east/south west oriented
	;   0x74: oil drum is       east/      west oriented
	;   0x78: oil drum is south east/north west oriented
	ld a,(0e003h)		;5491 A = game_state_ticker
	and 00ch		;5494 A = game_state_ticker & (0x08 | 0x04)
	add a,06ch		;5496 A += 0x6C
	ld (de),a		;5498 sprite_attrs_0C.pat = A
	
	; Set the color of RAM sprite #0C to medium red (0x08).
	inc de			;5499 DE = &sprite_attrs_0C + 3
	ld a,008h		;549a A = 0x08
	ld (de),a		;549c sprite_attrs_0C.color = 0x08
	
	ret			;549d



; We can get here from:
;   0x543D (jump) [from=5434_handle_oil_drum]
;   0x54A9 (call) [from=54a9_disable_oil_drum_and_reset_car_and_stop_fuel_heart_sound_and_draw_speed_and_fuel_gauge]
549e_oil_drum__disable:
	ld hl,0e105h		;549e HL = oil_drum
	ld (hl),000h		;54a1 oil_drum.is_active = 0x00
	
	; Set oil drum sprite vpos outside the visible screen.
	ld a,0e0h		;54a3 A = 0xE0
	ld (0e13eh),a		;54a5 sprite_attrs_0C.vpos = 0xE0
	
	ret			;54a8



; We can get here from:

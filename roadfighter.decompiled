; Player car has crashed.
; 
; We can get here from:
;   0x6A7D (jump table entry #01) [from=6a70_handle_newly_pressed_left_and_right_and_jump_to_correct_car_state_routine]
6abb_car_state_01__crashed:
	pop hl			;6abb ?Remove return address? ?Return to grand parent?
	ld a,(0e003h)		;6abc A = game_state_ticker
	and 007h		;6abf A &= 0x07
	ret nz			;6ac1 if (game_state_ticker & 0x07 != 0) return

	; We get here in only 1 out of 8 frames.
	ld hl,0e04ah		;6ac2 HL = &car_crashed_timer
	dec (hl)		;6ac5 --car_crashed_timer
	jr z,$+25		;6ac6 if (car_crashed_timer == 0x00) jump to 0x6ADF
	; Post: Not yet time for respawn.
	ld a,(hl)		;6ac8 A = car_crashed_timer
	cp 00bh			;6ac9 Compute A - 0x0B and set flags.
	ld a,008h		;6acb A = 0x08
	jr z,$+9		;6acd if (car_crashed_timer == 0x0B) jump to 0x6AD6
	inc a			;6acf ++A
	cp (hl)			;6ad0 Compute A - car_crashed_timer and update Z/NZ flag.
	ret nz			;6ad1
	
	ld a,009h		;6ad2 A = 0x09
	jr $-31			;6ad4 jump to 0x6AB5 (6ab5_set_car_orientation_to_regA)

	; We can get here from:
	;   0x6ACD (jump) [from=self]
	; 
	; Play the crash sound.
	push af			;6ad6 Store A (0x08)
	ld a,04fh		;6ad7 A = 0x4F
	call 04b6eh		;6ad9 4b6e_sound_something_with_D_is_0
	pop af			;6adc Restore A (0x08)
	
	jr $-40			;6add jump to 0x6AB5 (6ab5_set_car_orientation_to_regA)
	
	
	
	; We can get here from:
	;   0x6AC6 (jump) [from=self] car_crashed_timer == 0x00
	call 06af4h		;6adf 6af4_subtract_0x14_fuel_and_stop_fuel_heart_sound_and_draw_speed_and_fuel_gauge
	ld a,006h		;6ae2 A = 0x06
	ld (0e049h),a		;6ae4 car_state = CAR_STATE_RESPAWN
	
	ld a,010h		;6ae7 A = 0x10
	ld (0e004h),a		;6ae9 game_state_bits_or_counter_or_timer = 0x10
	ld a,(0e083h)		;6aec A = fuel_remaining
	or a			;6aef Update Z/NZ flag.
	jr z,$+44		;6af0 if (fuel_remaining == 0) jump to 6b1c_out_of_fuel_and_no_more_speed (GAME OVER)
	; Still some fuel remaining.
	pop hl			;6af2 Remove return address, return to grandparent.
	ret			;6af3




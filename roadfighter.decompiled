; Stage N, data pointer 1: track layout.
;
; The track layout stage table is at 0x5161. Values:
;   Stage 01: 0x78C4
;   Stage 02: 0x7AAA
;   Stage 03: 0x7AAA (indeed the same layout as stage 02, it is not a copy-paste error)
;   Stage 04: 0x7E83
;   Stage 05: 0x7E60
;   Stage 06: 0x7EA8
;
; First byte:
;   High nybble: (starting) track width (in number of lanes - 1)
;     0x10: 2 lanes
;     0x20: 3 lanes
;   Low nybble: track modifier
;     0x00: Straigh ahead (no modifier)
;     0x01: Track bends to left
;     0x02: Track bends to the right
;     0x03: Track expands from 2 to 3 lanes, right side expands
;     0x04: Track squeezes from 3 to 2 lanes, right side squeezes
;
;      | High nybble                                  | High nybble
;      | 0x10                                         | 0x20
; -----+----------------------------------------------+--------------------
; 0x00 | 0x10: 2 lanes, straight ahead                | 0x20: 3 lanes, straight ahead
; 0x01 | 0x11: 2 lanes, bending left                  | 0x21: 3 lanes, bending left
; 0x02 | 0x12: 2 lanes, bending right                 | 0x22: 3 lanes, bending right
; 0x03 | 0x13: 2 lanes, expanding to 3 lanes to right | 0x23: ?unused?
; 0x04 | 0x14: ?unused?                               | 0x24: 3 lanes, squeezing to 2 lanes from right



; Direct code references:
;   Table 0x5161, offset 0x00: 0x5161 (for stage 1)
78c4_track_layout__stage_1:
	defb 0x10		;78c4 2 lanes, straight ahead, 0x18 lines.
	defb 0x19		;78c5

	defb 0x11		;78c6 2 lanes, bending left, 0x20 lines.
	defb 0x21		;78c7

	defb 0x13		;78c8 2 lanes, expanding to 3 lanes to right, 0x17 times.
	defb 0x18		;78c9

	defb 0x20		;78ca 3 lanes, straight ahead, 0x50 times.
	defb 0x51		;78cb


	defb 0xFF		;4772 END



; Copy the following characters/symbols to VRAM (including color):
; 
;   0-9
;   copyright symbol
;   hand pointing to the right
;   A-C
;   E-I
;   K-P
;   R-T
;   V-W
;   Y
4773_copy_symbols_to_VRAM:
	call 0489ah		;4773 489a_zero_first_0x10_patterns_and_colors
	
	ld de,0478ah		;4776 DE = 0x478A
	ld hl,02080h		;4779 HL = 0x2080 (VRAM destination, pattern table, starting at character 0x10)
	call 45e0_copy2VRAM_3x	;477c
	
	ld a,0f0h		;477f A = 0xF0 (0xF: white, 0x0: transparent)
	ld hl,00080h		;4781 HL = 0x0080 (vram destination, color table)
	ld bc,00160h		;4784 BC = 0x0160 (copy count)
	jp 045cfh		;4787 45cf_filvrm_color_or_pattern_generator




; Compressed pattern data, seen at 0x4776.
	defb 0x8B, 0x00		;478a . . . . . . . .   01 Character 0x10.
	defb 0x1C		;478c . . . x x x . .   02
	defb 0x22		;478d . . x . . . x .   03
	defb 0x63		;478e . x x . . . x x   04
	defb 0x63		;478f . x x . . . x x   05
	defb 0x63		;4790 . x x . . . x x   06
	defb 0x22		;4791 . . x . . . x .   07
	defb 0x1C		;4792 . . . x x x . .   08

	defb 0x00		;4793 . . . . . . . .   09 Character 0x11.
	defb 0x18		;4794 . . . x x . . .   0a
	defb 0x38		;4795 . . x x x . . .   0b
	defb 0x04, 0x18		;4796 . . . x x . . .   01
				;4797 . . . x x . . .   02
				;4797 . . . x x . . .   03
				;4797 . . . x x . . .   04
	defb 0xCC, 0x7E		;4798 . x x x x x x .   01

	defb 0x00		;479a . . . . . . . .   02 Character 0x12.
	defb 0x3E		;479b . . x x x x x .   03
	defb 0x63		;479c . x x . . . x x   04
	defb 0x03		;479d . . . . . . x x   05
	defb 0x0E		;479e . . . . x x x .   06
	defb 0x3C		;479f . . x x x x . .   07
	defb 0x70		;47a0 . x x x . . . .   08
	defb 0x7F		;47a1 . x x x x x x x   09

	defb 0x00		;47a2 . . . . . . . .   0a Character 0x13.
	defb 0x3E		;47a3 . . x x x x x .   0b
	defb 0x63		;47a4 . x x . . . x x   0c
	defb 0x03		;47a5 . . . . . . x x   0d
	defb 0x0E		;47a6 . . . . x x x .   0e
	defb 0x03		;47a7 . . . . . . x x   0f
	defb 0x63		;47a8 . x x . . . x x   10
	defb 0x3E		;47a9 . . x x x x x .   11

	defb 0x00		;47aa . . . . . . . .   12 Character 0x14.
	defb 0x0E		;47ab . . . . x x x .   13
	defb 0x1E		;47ac . . . x x x x .   14
	defb 0x36		;47ad . . x x . x x .   15
	defb 0x66		;47ae . x x . . x x .   16
	defb 0x66		;47af . x x . . x x .   17
	defb 0x7F		;47b0 . x x x x x x x   18
	defb 0x06		;47b1 . . . . . x x .   19

	defb 0x00		;47b2 . . . . . . . .   1a Character 0x15.
	defb 0x7F		;47b3 . x x x x x x x   1b
	defb 0x60		;47b4 . x x . . . . .   1c
	defb 0x7E		;47b5 . x x x x x x .   1d
	defb 0x63		;47b6 . x x . . . x x   1e
	defb 0x03		;47b7 . . . . . . x x   1f
	defb 0x63		;47b8 . x x . . . x x   20
	defb 0x3E		;47b9 . . x x x x x .   21


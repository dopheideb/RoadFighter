41e6_game_state_03_substate_09:
	; Copy cars+minicar to sprite attributes and show cars on screen.
	call 05270h		;41e6 5270_copy_30_sprites_from_RAM_to_VRAM
	
	ld a,(0e003h)		;41e9 A = game_state_ticker
	bit 4,a			;41ec
	ld a,0c8h		;41ee A = 0xC8 (car_vpos: outside the screen)
	jr z,$+4		;41f0 if (game_state_ticker & 0x10) jump to 0x41F4
	ld a,080h		;41f2 A = 0x80 (car_vpos: start position on grid)
	
	; We can get here from:
	;   0x41F0 (jump) A == 0xC8 (0xC8 is outside the screen, so car "disappears")
	;   0x41F2 (fall) A == 0x80 (start position on grid)
	ld (0e04ch_car_vpos),a	;41f4 car_vpos = A
	call 06e1dh		;41f7 6e1d_store_car_sprite_attributes
	

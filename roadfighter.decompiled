; We can get here from:
;   0x40DB (jump) [from=40cf_game_state_00_substate_03__draw_logo_konami_play_select_level_A_level_B]
;   0x4131 (jump) [from=412d_game_state_01__waiting_for_player_to_start_the_game]
5028_draw_or_hide_hand_pointing_to_right_symbols_in_front_of_level_A_and_B:
	ld hl,0e004h		;5028 HL = &game_state_bits_or_counter_or_timer
	bit 3,(hl)		;502b ?Test blink bit?
	ld c,0ffh		;502d C = 0xFF (do write symbol)
	jr nz,$+3		;502f if (nz) jump to 5032_draw_0_or_1_hand_pointing_to_right_symbols_in_front_of_level_A_and_B
	inc c			;5031 C = 0x00 (don't write symbol)
	; Fall to 5032_draw_0_or_1_hand_pointing_to_right_symbols_in_front_of_level_A_and_B



; We can get here from:
;   0x502F (jump) C == 0xFF (do write hand symbol)
;   0x5031 (fall) C == 0x00 (don't write hand symbol)
5032_draw_0_or_1_hand_pointing_to_right_symbols_in_front_of_level_A_and_B:
	ld hl,03a0ah		;5032 VRAM location for hand point to right (level A).
	ld de,03a4ah		;5035 VRAM location for hand point to right (level B).
	ld a,(0e03bh)		;5038 A = level, 0x00 == level A, 0x01 == level B
	or a			;503b Update Z/NZ flag.
	jr z,$+3		;503c if (z) jump to 0x503F
	ex de,hl		;503e DE = 0x3A0A, HL = 0x3A4A
	
	; We can get here from:
	;   0x503C (jump) [level A] HL == 0x3A0A, DE == 0x3A4A
	;   0x503E (fall) [level B] HL == 0x3A4A, DE == 0x3A0A
	push de			;503f Store VRAM location of the other level.
	call 05046h		;5040 5046_draw_or_hide_hand_pointing_to_right(VRAM_destination=HL, mask=C)
	
	; Never must 2 hand symbols be seen, so at least 1 must be 
	; hidden, so hide the other hand. I.e, set C to 0x00.
	pop hl			;5043 Restore VRAM location of the other level.
	ld c,000h		;5044 C = 0x00 (don't write symbol, i.e. blacken)
	; Fall to 5046_draw_or_hide_hand_pointing_to_right(VRAM_destination=HL, mask=C)



; Draw or hide the hand pointing to right symbol.
; 
; Input:
;   HL: VRAM start location (inside name table)
;    C: mask (0x00: hide symbol, 0xFF: draw symbol)
; 
; We can get here from:
;   0x5040 (call) C: determined by 0xE004, level A: HL == 0x3A0A, level B: HL == 0x3A4A
;   0x5044 (fall) C == 0x00              , level A: HL == 0x3A4A, level B: HL == 0x3A0A
;
; Visualization:
;
; [00] . . . . . . . .|. . . . . . . .|
; [01] . . . . x x x x|. . . . . . . .|
; [02] . . . x x x x x|x x x x x x x .|
; [03] x x x x x x x x|x x x . . . . .|
; [04] x x x x x x x x|x x x . . . . .|
; [05] x x x x x x x x|x x . . . . . .|
; [05] x x x x x x x x|x x . . . . . .|
; [06] . . . . x x x x|x . . . . . . .|
5046_draw_or_hide_hand_pointing_to_right:
	ld de,0475bh		;5046 475b_hand_pointing_to_right_characters
	jp 045f8h		;5049 45f8_draw_or_hide_characters(start=0x475B, mask=C)



; We can get here from:
;   0x415D (call) [from=415a_game_state_02_substate_02]
;   0x419E (call) [from=4197_game_state_03_substate_03]
;   0x43B2 (call) [from=4392_game_state_08_substate_04]
504c_init_stage:
	; Clear/zero 0xE048 upto and including 0xE395.
	ld hl,0e048h		;504c LDIR: Source
	ld de,0e049h		;504f LDIR: Destination
	ld bc,0034eh		;5052 LDIR: Count: 0x034E, copy this many bytes
	ld (hl),000h		;5055
	ldir			;5057 do { *(DE++) = *(HL++) } while (--BC)
	
	call 051e5h		;5059 51e5_moving_objects__zero
	ld hl,0e098h		;505c LDIR: source
	ld de,0e099h		;505f LDIR: destination
	ld (hl),020h		;5062 Initialize source
	ld c,017h		;5064 LDIR: count (B is still 0)
	ldir			;5066 do { *(DE++) = *(HL++) } while (--BC)
	
	; Check if wrapped around.
	ld hl,0e042h		;5068 HL = &num_stage_wraparounds
	ld a,(hl)		;506b A = num_stage_wraparounds
	or a			;506c Update Z/NZ flag.
	jr nz,$+11		;506d if (num_stage_wraparounds != 0) jump to 0x5078
	;
	; Post: num_stage_wraparounds == 0
	;
	inc hl			;506f HL = &stage (0xE043)
	ld a,(hl)		;5070 A = stage
	ld hl,050beh		;5071 HL = 50be_location_and_type_of_oil__stage_1_to_5_except_stage_3
	cp 006h			;5074 Compute stage - 0x06 and update Z/NZ flag.
	jr nz,$+5		;5076 if (stage != 0x06) jump to 0x507B
	
	; We can get here from:
	;   0x506D (jump) num_stage_wraparounds >= 1 (though technically != 0)
	;   0x5076 (fall) num_stage_wraparounds == 0, stage == 0x06
	ld hl,050dch		;5078 HL = 50dc_location_and_type_of_oil__stage_6_and_beyond
	
	; We can get here from:
	;   0x5078 (fall) HL == 50dc_location_and_type_of_oil__stage_6_and_beyond
	;   0x5076 (jump) HL == 50be_location_and_type_of_oil__stage_1_to_5_except_stage_3
	ld (0e0b2h),hl		;507b &oil_details = HL
	call 050bfh		;507e 50bf_setup_stage_specific_stuff_and_jump_to_stage_specific_code
	ld a,008h		;5081 A = 0x08
	ld (0e07dh),a		;5083 Top screen row: set number of horizonl scenery characters before track starts

	call 051ffh		;5086 51ff_initialize_variables
	
	; Initialize remaining fuel to 0xD0 (almost full fuel tank). 
	; FWIW: 0xD7 is really the maximum, see 0x7765.
	ld a,0d0h		;5089 A = 0xD0
	ld (0e083h),a		;508b fuel_remaining = 0xD0
	
	; A = stage - 1, make stage 0-based.
	ld a,(0e043h)		;508e A = stage
	dec a			;5091 A = stage - 1
	
	; Init stage_specific_default_coarse_pattern_ID.
	ld hl,05191h		;5092 HL = 5191_stage2default_scenery_pattern_id
	call 0403bh		;5095 HL += A
	ld a,(hl)		;5098
	ld (0e089h),a		;5099 stage_specific_default_coarse_pattern_ID = 5191_stage2default_scenery_pattern_id[stage - 1]
	
	; A = stage - 1, make stage 0-based.
	ld a,(0e043h)		;509c A = stage
	dec a			;509f A = stage - 1
	
	; HL = stage_0based * 16
	ld l,a			;50a0
	ld h,000h		;50a1
	add hl,hl		;50a3
	add hl,hl		;50a4
	add hl,hl		;50a5
	add hl,hl		;50a6
	
	; HL = 0x537D + stage_0based * 16
	ld de,0537dh		;50a7
	add hl,de		;50aa
	
	ld (0e0bdh),hl		;50ab &current_moving_object_initial_data__idx = HL
	call 07020h		;50ae 7020_moving_object__compute_and_set_next_pair_of_initial_values
	
	ld a,004h		;50b1 A = 0x04.
	ld (0e086h),a		;50b3
	ld de,0e186h		;50b6 DE = 0xE186
	ld (0e046h),de		;50b9
	ret			;50bd


; Oil location and type for stages 1 to 5 (except 3)
; 
; References:
;   0x5071
50be_location_and_type_of_oil__stage_1_to_5_except_stage_3:
	defb 0xFF		;50be



; We can get here from:
;   0x507E (call) [from=504c_init_stage]
;   0x56FE (call) [from=56f7_fixme]
50bf_setup_stage_specific_stuff_and_jump_to_stage_specific_code:
	call 05132h		;50bf 5132_setup_stage_specific_stuff_something
	ld a,(0e043h)		;50c2 A = stage
	dec a			;50c5 Make stage 0 based.
	call 04045h		;50c6 PC = PC[2 * A]

; Jump table, see 0x50C6.
	defw 0x50E7		;50c9 #00: Stage 1 50e7_init_stage_1
	defw 0x50E8		;50cb #01: Stage 2 50e8_init_stage_2
	defw 0x50EF		;50cd #02: Stage 3 50ef_init_stage_3
	defw 0x510A		;50cf #03: Stage 4 510a_init_stage_4_and_partly_stage_5
	defw 0x5122		;50d1 #04: Stage 5 5122_init_stage_5
	defw 0x50D5		;50d3 #05: Stage 6 50d5_init_stage_6



; We can get here from:
;   0x50C6 (jump) index #05 of jump table (stage 6)
50d5_init_stage_6:
	ld hl,07fe4h		;50d5 HL = 0x7FE4
	ld (0e090h),hl		;50d8 *(0xE090) = 0x7FE4
	ret			;50db


; Oil location and type for stage >= 6.
; 
; References:
;   0x5078
50dc_location_and_type_of_oil__stage_6_and_beyond:
	defb 0x01		;50dc Appear when distance_travelled == 0x010000
	defb 0x00		;50dd Blue/water.

	defb 0x04		;50de Appear when distance_travelled == 0x040000
	defb 0x00		;50df Blue/water.

	defb 0x06		;50e0 Appear when distance_travelled == 0x060000
	defb 0x01		;50e1 Black/oil.

	defb 0x07		;50e2 Appear when distance_travelled == 0x070000
	defb 0x01		;50e3 Black/oil.

	defb 0x0E		;50e4 Appear when distance_travelled == 0x0E0000
	defb 0x00		;50e5 Blue/water.

	defb 0x00		;50e6 END (since distance_travelled is already >= 0x0E0000)



; We can get here from:
;   0x50C6 (jump) index #00 of jump table (stage 1)
50e7_init_stage_1:
	ret			;50e7



; We can get here from:
;   0x50C6 (jump) index #01 of jump table (stage 2)
50e8_init_stage_2:
	ld hl,07dc5h		;50e8 HL = 7dc5_shoreline_pattern_names
	ld (0e08ah),hl		;50eb
	ret			;50ee



; We can get here from:
;   0x50C6 (jump) index #02 of jump table (stage 3)
50ef_init_stage_3:
	ld hl,07c85h		;50ef HL = 0x7C85
	ld (0e090h),hl		;50f2
	
	ld hl,07c54h		;50f5 HL = 0x7C54
	ld (0e06fh),hl		;50f8 track_data_pointer = HL
	
	ld a,001h		;50fb A = 0x01
	ld (0e07ch),a		;50fd
	ld (0e08ah),a		;5100
	ld hl,07aa1h		;5103 HL = 7aa1_location_and_type_of_oil__stage_3
	ld (0e0b2h),hl		;5106
	ret			;5109



; We can get here from:
;   0x50C6 (jump) index #03 of jump table (stage 4)
;   0x5122 (call) [from=5122_init_stage_5]
510a_init_stage_4_and_partly_stage_5:
	ld hl,05116h		;510a HL = 0x5116
	ld de,0e08ah		;510d DE = 0xE08A
	ld bc,0000ch		;5110 BC = 0x000C
	ldir			;5113 do { *(DE++) = *(HL++) } while (--BC)
	ret			;5115



; Data, see 0x510A.
5116_data:
	defw 0x7E7C		;5116 Initial value for 0xE08A (stage 4+5).
	defb 0x01		;5118 Initial value for 0xE08C (stage 4+5).
	defb 0x01		;5119 Initial value for 0xE08D (stage 4+5).
	defb 0x00		;511a Initial value for 0xE08E (stage 4+5).
	defb 0x00		;511b Initial value for 0xE08F (stage 4+5).
	defw 0x7E57		;511c Initial value for 0xE090 (stage 4+5).
	defb 0x3F		;511e Initial value for 0xE092 (stage 4+5).
	defb 0x01		;511f Initial value for 0xE093 (stage 4+5).
	defw 0x7DC5		;5120 Initial value for 0xE094 (stage 4+5). 7dc5_shoreline_pattern_names



; We can get here from:
;   0x50C6 (jump) index #04 of jump table (stage 5)
5122_init_stage_5:
	call 0510ah		;5122 510a_init_stage_4_and_partly_stage_5
	ld hl,07d8ah		;5125 HL = 0x7D8A
	ld (0e08ah),hl		;5128
	ld hl,0010eh		;512b HL = 0x010E
	ld (0e092h),hl		;512e *(0xE092) = 0x010E
	ret			;5131



; We can get here from:
;   0x50BF (call) [from=50bf_setup_stage_specific_stuff_and_jump_to_stage_specific_code]
5132_setup_stage_specific_stuff_something:
	; Compute HL = 0x5161 + 6 * (stage - 1)
	ld a,(0e043h)		;5132 A = stage
	dec a			;5135 Make stage 0 based.
	add a,a			;5136 A = 2 * stage_0based
	ld b,a			;5137 B = 2 * stage_0based
	add a,a			;5138 A = 4 * stage_0based
	add a,b			;5139 A = 6 * stage_0based
	ld hl,05161h		;513a HL = 0x5161
	call 0403bh		;513d HL = 0x5161 + 6 * stage_0based
	
	;
	; ---------+---------------+--------------------------------+--------------------------+----------
	;          | Offset 0x5161 | Absolute addresses of pointers | Value of pointers        | Remark(s)
	; ---------+---------------+--------------------------------+--------------------------+----------
	; Stage 01 |            0  |  0x5161  |  0x5163  |  0x5165  | 0x78C4 | 0x78E5 | 0x7960 | Data pointers 2 and 3 are the same as stage 4 and 5.
	; ---------+---------------+--------------------------------+--------------------------+----------
	; Stage 02 |            6  |  0x5167  |  0x5169  |  0x516B  | 0x7AAA | 0x7BAA | 0x7ACD | Completely the same as stage 3.
	; ---------+---------------+--------------------------------+--------------------------+----------
	; Stage 03 |           12  |  0x516D  |  0x5163  |  0x5165  | 0x7AAA | 0x7BAA | 0x7ACD | Completely the same as stage 2.
	; ---------+---------------+--------------------------------+--------------------------+----------
	; Stage 04 |           18  |  0x5173  |  0x5175  |  0x5177  | 0x7E83 | 0x78E5 | 0x7960 | Data pointers 2 and 3 are the same as stage 1 and 5.
	; ---------+---------------+--------------------------------+--------------------------+----------
	; Stage 05 |           24  |  0x5179  |  0x517B  |  0x517D  | 0x7E60 | 0x78E5 | 0x7960 | Data pointers 2 and 3 are the same as stage 1 and 4.
	; ---------+---------------+--------------------------------+--------------------------+----------
	; Stage 06 |           30  |  0x517F  |  0x5181  |  0x5183  | 0x7EA8 | 0x7F6B | 0x7ED1 |
	; ---------+---------------+--------------------------------+--------------------------+----------
	;
	; Copy 3 data pointers (3 words, 6 bytes) from HL to 0xE071-0xE6.
	ld bc,00006h		;5140 LDIR: count
	ld de,0e071h		;5143 LDIR: destination
	ldir			;5146 Copy HL to DE, 0x06 times. Copy 3 data pointers.
	
	ld a,001h		;5148 A = 1
	ld (0e07fh),a		;514a *(0xE07F) = 1
	ld hl,(0e071h)		;514d HL = stage_something_pointer[0]
	ld de,0e07ah		;5150 LDIR: destination = &current_track_layout
	ld c,002h		;5153 LDIR: count = 2 (B is still 0)
	ldir			;5155 Copy HL to DE, 0x02 times. Copies 2 stage/track related bytes.
	ld (0e071h),hl		;5157 Store HL

	; track_data_pointer = 0x5998
	ld hl,05998h		;515a HL = 0x5998
	ld (0e06fh),hl		;515d *(0xE06F) = 0x5998

	ret			;5160



; Data, 6 bytes per element (see 0x5140)
	defw 0x78C4		;5161 #00 Stage 1: track layout
	defw 0x78E5		;5163 #00
	defw 0x7960		;5165 #00
	
	defw 0x7AAA		;5167 #01 Stage 2: track layout
	defw 0x7BAA		;5169 #01

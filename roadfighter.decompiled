; z80dasm 1.1.6
; command line: z80dasm --address --origin=16384 --output=roadfighter.decompiled.org RoadFighter.rom



	; C-BIOS MSX1
	; 
	; Disassembled with 'z80dasm --address --origin=0 /usr/share/cbios/cbios_main_msx1.rom'
	org	00000h
	di			;0000 [BIOS] CHKRAM (also called STARTUP, RESET or BOOT): Tests RAM and sets RAM slot for the system
	jp 00d12h		;0001
	defw 0x1BBF		;0004 [BIOS] Address of ROM character set
	(...)
	defb 0x98		;0006 [BIOS] VDP.DR: The base port address for VDP data reads.
	defb 0x98		;0007 [BIOS] VDP.DW: The base port address for VDP data writes.
	(...)
	jp 018e6h		;0038 [BIOS] KEYINT: Executes the timer interrupt process routine
	(...)
	jp 0022eh		;0047 [BIOS] WRTVDP: Write to any VDP register
	jp 00245h		;004a [BIOS] RDVRM : Read byte from VRAM
	jp 0024dh		;004d [BIOS] WRTVRM: Write byte to VRAM
	jp 00255h		;0050 [BIOS] SETRD : Set up VDP for read
	jp 00260h		;0053 [BIOS] SETWRT: Set up VDP for write
	jp 0026dh		;0056 [BIOS] FILVRM: Fill block of VRAM with data byte
	(...)
	jp 01752h		;0093 [BIOS] WRTPSG: Write to any PSG register
	jp 0175ch		;0096 [BIOS] RDPSG : Read from any PSG register
	(...)
	jp 01770h		;013e [BIOS] RDVDP : Read VDP Status Register
	jp 01773h		;0141 [BIOS] SNSMAT: Read row of keyboard matrix
	(...)

; grauw.nl states:
;   Address  : #0047
;   Function : Write data in the VDP-register
;   Input    : B  - Data to write
;              C  - Number of the register
;   Registers: AF, BC
022e_WRTVDP:
	di			;022e Disable interrupts.
	
	; The VDP docs says that bit 7 needs to be set. But the C should 
	; be the number of the register, i.e. without bit 7 set. So, 
	; fixed user errors, since we need the register number for 
	; shadowing. See 0x0242.
	res 7,c			;022f Reset bit 7 of register C.
	
	; TMS9918.pdf states in 2.1.2 ("CPU Write to VDP Register"): 
	; "The first byte transferred is the data byte, and the second 
	; byte transferred controls the destination. The MSB of the 
	; second byte must be a 1."
	; 
	; Write the data byte.
	ld a,b			;0231 A = B
	out (099h),a		;0232 Write data (B) to the VDP.
	
	; Write to which register the data byte must go to.
	ld a,c			;0234 A = C
	or 080h			;0235 A = C | 0x80, MSB must be set to 1 according to VDP docs.
	out (099h),a		;0237 Write address to the VDP.
	ei			;0239 Enable interrupts.

	; (0xF3DF)[C] = B, update MSX BIOS VDP register mirror address.
	push hl			;023a Store HL (restored at 0x0243).
	ld hl,0f3dfh		;023b HL = 0xF3DF
	ld a,b			;023e A = B
	ld b,000h		;023f B = 0x00
	add hl,bc		;0241 HL += BC
	ld (hl),a		;0242 *(HL) = A
	pop hl			;0243 Restore HL (stored at 0x023A).

	ret			;0244



0260_SETWRT:
	di			;0260 Disable interrupts.
	
	; 0x99: Writing port 1: VRAM address and register set-up.
	ld a,l			;0261 A = L
	out (099h),a		;0262 Store low byte of VRAM address to write to.
	ld a,h			;0264 A =  H
	; Bit 7 is unused and must be 0.
	; Bit 6:
	;   0: Set-up for READING from VRAM.
	;   1: Set-up for WRIING to VRAM.
	and 03fh		;0265 A = (H & 0x3F), bit 6 and 7 are not part of the VRAM address
	or 040h			;0267 A = (H & 0x3F) | 0x40, we want to WRITE to VRAM.
	out (099h),a		;0269 Store high byte of VRAM address to write to.
	
	ei			;026b Enable interrupts.
	ret			;026c



18e6_KEYINT:
	; Save all registers.
	push hl			;18e6
	push de			;18e7
	push bc			;18e8
	push af			;18e9
	exx			;18ea
	ex af,af'		;18eb
	push hl			;18ec
	push de			;18ed
	push bc			;18ee
	push af			;18ef
	push iy			;18f0
	push ix			;18f2
	
	; Call H.KEYI for every interrupt.
	; 
	; Note: MSX1 (with for instance TMS9929A) has no HBLANK.
	call 0fd9ah		;18f4 H.KEYI
	in a,(099h)		;18f7 Read VDP status register.
	
	; Set sign flag. Meaning:
	;   P (bit 7 is 0): This is NOT a VBLANK. (VDPs interrupt flag is NOT set.)
	;   M (bit 7 is 0): This IS a VBLANK. (VDPs interrupt flag IS set.)
	or a			;18f9 Update sign flag (P/M).
	ld (0f3e7h),a		;18fa Store VDP status register. (Unused in Road Fighter.)
	jp p,0194eh		;18fd if (not VBLANK) jump to 0x194E (194e_restore_registers_ei_return)
	
	; VBLANK occured, call H.TIMI.
	call 0fd9fh		;1900 H.TIMI

	; Update JIFFY, i.e. the number of times this interrupt routine 
	; has been called.
	ld hl,(0fc9eh)		;1903
	inc hl			;1906
	ld (0fc9eh),hl		;1907
	
	; Clear CLIKFL.
	xor a			;190a A = 0	
	ld (0fbd9h),a		;190b
	
	; Update SCNCNT. This variable is used as a counter by the 
	; interrupt handler to control the rate at which keyboard scans 
	; are performed.
	ld a,(0f3f6h)		;190e
	dec a			;1911
	ld (0f3f6h),a		;1912
	
	jr nz,$+57		;1915 if (nz) jump to 0x194E (194e_restore_registers_ei_return)
	; Post: must perform keyboard scan.
	; 
	; Reset SCNCNT to 3
	ld a,003h		;1917 A = 0x03
	ld (0f3f6h),a		;1919

	; Update TRGFLG.
	xor a			;191c A = 0
	call 01802h		;191d ?Scan keyboard and joysticks?
	cpl			;1920 A = ~A
	and 001h		;1921 A &= 1
	ld (0f3e8h),a		;1923 Update TRGFLG.
	
	call 01963h		;1926
	ld hl,(0f3f8h)		;1929 HL = *PUTPNT
	ld de,(0f3fah)		;192c DE = *GETPNT
	rst 20h			;1930 call DCOMPR: Compares HL with DE
	jr nz,$+29		;1931 if (HL != DE) jump to 0x194E (194e_restore_registers_ei_return)
	
	; Update REPCNT: This variable is used as a counter by the 
	; interrupt handler to control the key repeat rate.
	ld a,(0f3f7h)		;1933 A = *REPCNT
	dec a			;1936 --A
	ld (0f3f7h),a		;1937 *REPCNT = A

	jr nz,$+20		;193a if (nz) jump to 0x194E (194e_restore_registers_ei_return)
	
	; OLDKEY (11 bytes): This buffer is used by the interrupt 
	; handler to hold the previous state of the keyboard matrix, 
	; each byte contains one row of keys starting with row 0.
	ld hl,0fbdah		;193c HL = OLDKEY
	ld bc,00bffh		;193f B = 0x0B (DJNZ loop count), C = 0xFF
	1942_fill_OLDKEY_buffer:
	ld (hl),c		;1942
	inc hl			;1943
	djnz $-2		;1944 if (--B != 0) jump to 0x1942 (1942_fill_OLDKEY_buffer)
	
	call 01963h		;1946
	
	; Update REPCNT.
	ld a,001h		;1949 A = 0x01
	ld (0f3f7h),a		;194b *REPCNT = 0x01
	; Fall to 194e_restore_registers_ei_return.
	
	; Restore all registers.
	; 
	; We can get here from:
	;   0x18FD (jump)
	;   0x1915 (jump)
	;   0x1931 (jump)
	;   0x194B (fall)
	194e_restore_registers_ei_return:
	pop ix			;194e
	pop iy			;1950
	pop af			;1952
	pop bc			;1953
	pop de			;1954
	pop hl			;1955
	exx			;1956
	ex af,af'		;1957
	pop af			;1958
	pop bc			;1959
	pop de			;195a
	pop hl			;195b
	
	ei			;195c Enable interrupts.
	ret			;195d



; Road Fighter ROM	
org	04000h

defm "AB"		;4000 ID. Must be "AB" for cartridge.
defw 0x404F		;4002 INIT. Entry point.
defw 0x0000		;4004 STATEMENT.                     Not used, so zeroed.
defw 0x0000		;4006 DEVICE.                        Not used, so zeroed.
defw 0x0000		;4008 TEXT.                          Not used, so zeroed.
defw 0x0000		;400A RESERVED FOR FUTURE USE.       Not used, so zeroed.
defw 0x0000		;400C RESERVED FOR FUTURE USE.       Not used, so zeroed.
defw 0x0000		;400E RESERVED FOR FUTURE USE.       Not used, so zeroed.



; Weird. We can only get here from 0x48C6 (a 3 byte opcode), and we jump 
; to 0x48C9: exactly 3 bytes after where we came from, which is a waste 
; of cycles!
;
; We can get here from:
;   0x48C6 (jump)
4010_from_48c6_to_48c9:
	jp 048c9h		;4010 jump to 0x48C9: 48c9_copy_konami_logo_characters_to_vram_3x



; This is the game's interrupt routine. It is called after the VDP is 
; done drawing the screen. This routine should do all its 
; drawing/writing to VDP before the VDP starts to draw another screen. 
; (The routine has safeguard for when the "should" part somehow fails.)
;
; If you want a frame by frame view in OpenMSX, try this command:
; 
;     debug set_bp 0x4013
;
; We can get here from:
;   0x18F4 (call) [from=18e6_KEYINT,0038_KEYINT]
4013_H_KEYINT_hook:
	call 013E_RDVDP		;4013 Read VDP status register; clears interrupt.
	di			;4016 Disable interrupts.
	call 04bffh		;4017 4bff_handle_3_PSG_channel_structs_something
	ld hl,0e005h		;401a HL = &interrupt_sentry
	bit 0,(hl)		;401d Test bit 0 (mask 0x01).
	jr nz,$+15		;401f if (interrupt_sentry & 0x01) jump to 0x402E (402e_interrupt_hook_bottom)
	;
	; Post: previous interrupt was completed, so we can actually 
	; handle this interrupt.
	;
	inc (hl)		;4021 ++interrupt_sentry, i.e. set interrupt_sentry to 1.
	ei			;4022 Enable interrupts.
	call 046b6h		;4023 46b6_read_and_save_joystick_and_keyboard
	call 04082h		;4026 4082_increment_ticker__read_input__jump_to_state_handler
	ld a,000h		;4029 A = 0x00
	ld (0e005h),a		;402b interrupt_sentry = 0x00
	; Fall to 402e_interrupt_hook_bottom.



; We can get here from:
;   0x401F (jump) Skipped the interrupt routine
;   0x402B (fall) Executed the interrupt routine 
402e_interrupt_hook_bottom:
	call 013E_RDVDP		;402e A = status register; clears interrupt.
	or a			;4031 Set flags, including minus flag.
	di			;4032 Disable interrupts.
	
	; Handle sound with very precise frequency: 50/60 Hz.
	;
	; Bit 7 (mask 0x80) of the VDP status register is set at the end 
	; of the raster scan of the last line of the active display.
	call m,04bffh		;4033 4bff_handle_3_PSG_channel_structs_something
	
	ei			;4036 Enable interrupts.
	ret			;4037



; grauw.nl states:
;   WRTVDP
;   Address  : #0047
;   Function : Write data in the VDP-register
;   Input    : B  - Data to write
;              C  - Number of the register
;   Registers: AF, BC
4038_wrtvdp_jump:
	jp 0047_WRTVDP		;4038



; Computes HL += A
403b_HL+=A:
	add a,l			;403b
	ld l,a			;403c
	ret nc			;403d
	inc h			;403e
	ret			;403f



; Computes DE += A
4040_DE+=A:
	add a,e			;4040
	ld e,a			;4041
	ret nc			;4042
	inc d			;4043
	ret			;4044



; Jump table implementer.
; 
; Changes the program counter in the following way:
; 
;   PC += 2 * A (the PC from the caller perspective)
; 
; Destroys A, DE, HL
4045_PC=PC[2*A]:
	add a,a			;4045 A += A
	
	; Z80 pushed the program counter (pc) when this subroutine was 
	; called. (Actually the PC right after the call.) So, that PC is 
	; popped here.
	pop hl			;4046 HL = *(SP)
	
	call 0403bh		;4047 HL += A
	ld e,(hl)		;404a E = *(HL)
	inc hl			;404b ++HL
	ld d,(hl)		;404c D = *(HL)
	ex de,hl		;404d DE=HL, HL=DE
	jp (hl)			;404e



404f_entry_point:
	di			;404f Disable interrupts.
	; Interrupt mode 1: always call fixed (BIOS) address 0x0038 
	; (i.e. BIOS call "KEYINT")
	im 1			;4050
	
	; Setup interrupt hook H.KEYI.
	; 
	; Set H.KEYI to "jp 0x4013". Fires at __every__ interrupt, not 
	; just VDP. But there are basically no other interrupts in a 
	; standard MSX 1, except the Vertical Blank (VBLANK) Interrupt, 
	; a.k.a. VBI.
	;
	;   0xFD9A | 0xFD9B | 0xFD9C | Assembly
	;   -------+--------+--------+-----------
	;   0xC3   | 0x13   | 0x40   | JP 0x4013
	ld a,0c3h		;4052 A = 0xC3, which is the opcode "jp" (jump)
	ld (0fd9ah),a		;4054 "JP"
	ld hl,04013h		;4057 HL = 0x4013 (4013_H_KEYINT_hook)
	ld (0fd9bh),hl		;405a

	; Setup stack pointer.
	ld sp,0e800h		;405d Set top of stack to 0xE800.

	; Clear RAM. Zero 0xE000 up to and including 0xE7FF.
	ld hl,0e000h		;4060 LDIR: source (&game_state)
	ld de,0e001h		;4063 LDIR: destination (&game_substate)
	ld bc,007ffh		;4066 LDIR: count (0x800)
	ld (hl),000h		;4069 Zero first address manually
	ldir			;406b Copy zero onwards.
	
	; Setup the VDP.
	ld a,001h		;406d A = 1
	ld (0e005h),a		;406f interrupt_sentry = 1
	call 04685h		;4072 4685_setup_PSG_and_VDP
	xor a			;4075 A = 0
	ld (0e005h),a		;4076 interrupt_sentry = 1
	
	; Clear the VDPs VBLANK interrupt flag.
	call 013E_RDVDP		;4079 Read VDP status register; clears interrupt.

	ei			;407c Enable interrupts. Was disabled at 0x404f.
	; This is basically the end of the entry point.
	; 
	; Road Fighter has no /real/ main routine. Road Fighter is VDP 
	; interrupt based, so 4013_interrupt_hook takes over.

; Do absolutely nothing, except keep busy jumping to myself.
; 
; Note: We can be interrupted, by the VBLANK interrupt to be specific.
;
; We can get here from:
;   0x407C (fall) [from=404f_entry_point] End of entry point, start doing nothing.
;   0x407D (jump) [from=404f_entry_point] Continue doing nothing.
407d_main:
	jr $+0			;407d jump to 407d_main



407f_jump_to_0x4B6E:
	jp 04b6eh		;407f 4b6e_sound_something_with_D_is_0


; We can get here from:
;   0x4026 (call) [from=4013_H_KEYINT_hook]
4082_increment_ticker__read_input__jump_to_state_handler:
	ld hl,0e003h		;4082 HL = &game_state_ticker
	inc (hl)		;4085 ++game_state_ticker
	ld a,(0e002h)		;4086 A = game_bits
	add a,a			;4089 A = 2 * game_bits

	; "m" is minus: bit 7, mask 0x80. If bit 6 (0x40) is set in 
	; 0xE002, then 2 * *(0xE002) has bit 7 set. So if bit 6 (0x40, 
	; player is playing) is set in 0xE002, then we get a sign minus 
	; flag.
	jp m,04091h		;408a if (player is playing) jump to 0x4091
	
	; Player is not playing. When not playing, there is more than 1 
	; game state besides 0x05 ("playing").
	; 
	; Push 0x43C3 (43c3_game_state_handler) to the stack. It will be 
	; popped as the program counter (PC), when "ret" is used in the 
	; code jumped to by jump table 0x4096. And after 
	; 43c3_game_state_handler returns, the PC returns to 0x4029 
	; (4013_H_KEYINT_hook), since only 0x4026 calls us.
	; 
	; 
	ld hl,043c3h		;408d HL = 43c3_game_state_handler
	push hl			;4090
	
	; We can get here from:
	;   0x408A (jump) Player is playing
	;   0x4090 (fall) Player is not playing, will return to 43c3_game_state_handler
	ld bc,(0e000h)		;4091 C = game_state, B = game_substate
	ld a,c			;4095 A = game_state
	call 04045h		;4096 PC = PC[2 * A]
	; Returns to if player is NOT playing:
	;   0x43C3 (43c3_game_state_handler), 0x4029 is still on the stack.
	; 
	; Returns to if player IS playing:
	;   0x4029 (inside 4013_H_KEYINT_hook)



; Jump table, see 0x4096.
4099_game_state_jump_table:
	defw 0x40AB		;4099 #00: 40ab_game_state_00__setup_game
	defw 0x412D		;409b #01: 412d_game_state_01__waiting_for_player_to_start_the_game
	defw 0x4137		;409d Game state #02: Start demo/next stage
	defw 0x416F		;409f Game state #03: Start a new game
	defw 0x4270		;40a1 Game state #04: Demo
	defw 0x4306		;40a3 Game state #05: Race has started
	defw 0x4325		;40a5 Game state #06: Crashed: check remaining fuel.
	defw 0x4348		;40a7 #07: 4348_game_state_07__no_fuel_remaining
	defw 0x4373		;40a9 #08: 4373_game_state_08__post_reaching_checkpoint_or_goal



; We can get here from:
;   0x4096 (jump) [from=4082_increment_ticker__read_input__jump_to_state_handler]
40ab_game_state_00__setup_game:
	djnz $+21		;40ab if (--B != 0) jump to 0x40C0
40ad_game_state_00_substate_01__konami_logo_and_line_and_software_letters:
	ld a,(0e003h)		;40ad A = game_state_ticker
	rra			;40b0 Rotate right through the carry flag.
	ret nc			;40b1 if (game_state_ticker & 0x01 == 0) return
	
	; Note: Routine 0x48DD sets the Z/NZ flag.
	call 048ddh		;40b2 48dd_write_upwards_scrolling_konami_logo
	ret nz			;40b5 if (konami_logo__scroll_ups_remaining != 0) return
	
	; Post: konami_logo__scroll_ups_remaining == 0
	ld de,046fch		;40b6 DE = 46fc_line_and_software_letters
	
	call 0460bh		;40b9 460b_hl=*de_and_inc_de_twice_and_decompress_and_copy_to_VRAM
	; Post:
	;   HL = *DE, so HL == 0x394A
	;   DE += 2,  so DE == 0x46FE
	
	; Get ready for next substate (#02).
	xor a			;40bc A = 0x00
	jp 04167h		;40bd 4167_increase_substate_and_set_E004_to_regA
	
	
	
	; We can get here from:
	;   0x40AB (djnz)
	djnz $+13		;40c0 if (--B != 0) jump to 0x40CD
40cc_game_state_00_substate_02__setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo:
	call 0440ch		;40c2 440c_decrement_timer_and_do_return_magic
	; Post: timer ran out.
	call 049a6h		;40c5 49a6_setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo
	
	; Get ready for next substate (#03).
	ld a,020h		;40c8 A = 0x20
	jp 04167h		;40ca 4167_increase_substate_and_set_E004_to_regA


	
	; We can get here from:
	;   0x40C0 (djnz)
	djnz $+25		;40cd if (--B != 0) jump to 0x40E6
40cf_game_state_00_substate_03__draw_logo_konami_play_select_level_A_level_B:
	; Decrement game_state_bits_or_counter_or_timer.
	ld hl,0e004h		;40cf HL = &game_state_bits_or_counter_or_timer
	dec (hl)		;40d2
	ld a,(hl)		;40d3
	
	cp 007h			;40d4 Compute A - 0x07 and update C/NC flag.
	jr c,$+8		;40d6 if (game_state_bits_or_counter_or_timer <= 6) jump to 0x40DE
	; Post: game_state_bits_or_counter_or_timer >= 7
	; 
	; Update the name table to draw "©KONAMI 1985" + "PLAY SELECT" + "LEVEL A" + "LEVEL B".
	call 049c2h		;40d8 49c2_draw_logo_konami_play_select_level_A_level_B
	jp 05028h		;40db 5028_draw_or_hide_hand_pointing_to_right_symbols_in_front_of_level_A_and_B


	
	; We can get here from:
	;   0x40D6 (jump) game_state_bits_or_counter_or_timer <= 6
	call 0778ch		;40de 778c_play_sound_03__grabbed_bonus_fuel_heart
	
	; Get ready for next substate (#04).
	ld a,020h		;40e1 A = 0x20
	jp 04167h		;40e3 4167_increase_substate_and_set_E004_to_regA



	; We can get here from:
	;   0x40CD (djnz)
	djnz $+52		;40e6 if (--B != 0) jump to 0x411A
40cf_game_state_00_substate_04__draw_road_fighter_logo_in_different_colors:
	ld hl,0e004h		;40e8 HL = &game_state_bits_or_counter_or_timer
	dec (hl)		;40eb --game_state_bits_or_counter_or_timer
	jr z,$+34		;40ec if (game_state_bits_or_counter_or_timer == 0) jump to 0x410E
	ld a,(hl)		;40ee A = game_state_bits_or_counter_or_timer
				;xxxx fall to 40ef_draw_road_fighter_logo(color_set=A)


; Draw Road Fighter logo.
; 
; Input:
;   A: the requested color set (0..3)
; 
; We can get here from:
;   0x40EE (fall) A == game_state_bits_or_counter_or_timer and A != 0x00
;   0x49BC (jump) A == 0x01
40ef_draw_road_fighter_logo:
	and 003h		;40ef A &= 0x03
	add a,a			;40f1 A *= 2
	ld de,04112h		;40f2 DE = 0x4112 (4112_road_fighter_logo_blink_colors)
	call 04040h		;40f5 DE += A
	ld a,(de)		;40f8 A = 4112_road_fighter_logo_blink_colors[A]
	
	; Copy dark color, one of dark blue, dark red, dark yellow.
	push de			;40f9
	ld hl,00600h		;40fa HL = 0x0600 (start address for FILVRM, color table)
	ld bc,000b0h		;40fd BC = 0x00B0 (length)
	call 0410bh		;4100 410b == (jump to) 45cf_filvrm_color_or_pattern_generator
	pop de			;4103

	; Copy light color, one of light blue, light red, light yellow.
	inc de			;4104
	ld a,(de)		;4105 A = *DE (value for FILVRM)
	ld hl,006b0h		;4106 HL = 0x06B0 (start address for FILVRM, color table)

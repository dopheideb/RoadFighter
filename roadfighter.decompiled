	bit 0,a			;421a
	ld b,046h		;421c B = 0x46 (traffic light will be black)
	jr nz,$+10		;421e if (*0xE004 & 1) jump to 0x4228
	ld b,044h		;4220 B = 0x44 (traffic light will be yellow)
	dec a			;4222
	dec a			;4223
	jr nz,$+4		;4224 if (A != 0) jump to 0x4228
	
	ld b,048h		;4226 B = 0x48 (traffic light will be green)

	; We can get here from:
	;   0x421E (jump) B == 0x46 [BLACK]  Name table offset 0x46 contains left  half of traffic light (black)
	;                                    Name table offset 0x47 contains right half of traffic light (black)
	;   0x4224 (jump) B == 0x44 [YELLOW] Name table offset 0x44 contains left  half of traffic light (yellow)
	;                                    Name table offset 0x45 contains right half of traffic light (yellow)
	;   0x4226 (jump) B == 0x48 [GREEN]  Name table offset 0x48 contains left  half of traffic light (green)
	;                                    Name table offset 0x49 contains right half of traffic light (green)
	;
	; Compute the pattern name address:
	; 
	;   HL = 0x3826 + *(0x4241 + game_state_bits_or_counter_or_timer)
	ld a,(0e004h)		;4228 A = game_state_bits_or_counter_or_timer
	ld hl,04241h		;422b HL = 0x4241
	call 0403bh		;422e HL += A
	ld a,(hl)		;4231
	ld hl,03826h		;4232 HL = 0x3826 (VRAM destination)
	call 0403bh		;4235 HL += A

	ld a,b			;4238 A = character id of left half of traffic light
	; Draw left half of 1 traffic light.
	; 
	; HL: VRAM destination 0x3826 + n * 0x20 (inside name table, upper band)
	;  A: VRAM value (0x44, 0x46, 0x48)
	call 004D_WRTVRM	;4239
	
	inc a			;423c
	inc hl			;423d
	; Draw right half of 1 traffic light.
	; 
	; HL: VRAM destination 0x3826 + n * 0x20 + 1 (inside name table, upper band)
	;  A: VRAM value (0x45, 0x47, 0x49)
	jp 004D_WRTVRM		;423e



; Offsets for the traffic light. The offset is with respect to 0x3826 
; (see 0x4232), which is the pattern name table in VRAM.
; 
; Base | 00 01 02 03 04 05 06 07 08
; -----+---------------------------
; 3800 | 00                __ __   
; 3820 | 00              | =( )= | 
; 3840 | 00              | =( )= | 
; 3860 | 00              | =( )= | 
; 3880 | 00              | =( )= | 
; 38A0 | 00                -- --   
; 38C0 | 00                        
; 38E0 | 00                        
;
; Referenced by:
;   0x422B
	defb 0x00		;4241 #00 (unused)
	defb 0x60		;4242 #01 0x60 + 0x3826 == 0x3886, name table VRAM address of lower     left  half of traffic light
	defb 0x60		;4243 #02 0x60 + 0x3826 == 0x3887, name table VRAM address of lower     right half of traffic light
	defb 0x40		;4244 #03 0x40 + 0x3826 == 0x3866, name table VRAM address of lower/mid left  half of traffic light
	defb 0040		;4245 #04 0x40 + 0x3827 == 0x3867, name table VRAM address of lower/mid right half of traffic light
	defb 0x20		;4246 #05 0x20 + 0x3826 == 0x3846, name table VRAM address of upper/mid left  half of traffic light
	defb 0x20		;4247 #06 0x20 + 0x3827 == 0x3847, name table VRAM address of upper/mid right half of traffic light
	defb 0x00		;4248 #07 0x00 + 0x3826 == 0x3826, name table VRAM address of upper     left  half of traffic light
	defb 0x00		;4249 #08 0x00 + 0x3827 == 0x3827, name table VRAM address of upper     right half of traffic light




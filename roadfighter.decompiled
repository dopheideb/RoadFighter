; We can get here from:
;   0x41CD (call) [from=41cd_game_state_03_substate_07__initialize_blue_cars_on_starting_grid_of_stage_01_and_set_timer_to_0x05_and_increase_substate]
5197_initialize_blue_cars_on_starting_grid_of_stage_01:
	; Left column of starting grid: Draw 5 blue cars.
	ld de,0e11ah		;5197 DE = 0xE11A
	ld bc,00551h		;519a B = 0x05, C = 0x51
	call 051a5h		;519d 51a5_setup_stage_01_blue_cars_at_start
	
	; Right column of starting grid: Draw 6 blue cars.
	ld e,042h		;51a0 DE = 0xE142
	ld bc,00665h		;51a2 B = 0x06, C = 0x65
	; Fall to 51a5_setup_stage_01_blue_cars_at_start.



; Initialize the blue cars at the start of stage 1.
; 
; Input:
;   DE: address of sprite to start from initializing
;    B: Number of blue cars to initialize.
;    C: Horizontal position of all the blue regB cars.
; 
; We can get here from:
;   0x519D (call) [from=5197_initialize_blue_cars_on_starting_grid_of_stage_01] DE == 0xE11A, B == 0x05, C = 0x51
;   0x51A2 (fall) [from=5197_initialize_blue_cars_on_starting_grid_of_stage_01] DE == 0xE142, B == 0x06, C = 0x65
51a5_setup_stage_01_blue_cars_at_start:
	ld a,008h		;51a5 A = 0x08
	
	; B == 5: Initialize 5 blue cars (2*5 sprites) in the left starting column.
	; B == 6: Initialize 5 blue cars (2*6 sprites) in the left starting column.
	51a7_start_of_outer_djnz_loop:
	push bc			;51a7 Store BC. Restore at 0x51BD.
	ld hl,051c1h		;51a8 HL = 51c1_patterns_and_colors_of_blue_car (0x51C1)
	ld b,002h		;51ab B = 0x02 (initialize both blue car and its shadow)
	
	; This loop: copy both moving objects and its shadow (or fuel 
	; heart and "B").
	51ad_start_of_inner_djnz_loop:
	push bc			;51ad Store BC. Restore at 0x51B8.
	ld (de),a		;51ae current_sprite.vpos = A. A increments by 0x18 each loop, see 0x51BB.
	inc de			;51af DE = &current_sprite.hpos
	ex de,hl		;51b0 HL = &current_sprite.hpos
	ld (hl),c		;51b1 Set hpos, to either 0x51 or 0x65.
	ex de,hl		;51b2 DE = &current_sprite.hpos
	inc de			;51b3 DE = &current_sprite.pattern
	ldi			;51b4 *(DE++) = *(HL++), --BC, set pattern
	ldi			;51b6 *(DE++) = *(HL++), --BC, set color
	pop bc			;51b8 Restore BC. Stored at 0x51AD.
	djnz $-12		;51b9 if (--B != 0) jump to 0x51AD
	; End of inner DJNZ loop.
	
	add a,018h		;51bb A = 0x18, next blue car will start 0x18 pixels lower, 8 pixels between cars (vertically).
	pop bc			;51bd Restore BC. Stored at 0x51A7.
	djnz $-23		;51be if (--B != 0) jump to 0x51A7
	
	ret			;51c0



; Referenced by:
;   0x51A8 [from=51a5_setup_stage_01_blue_cars_at_start]
51c1_patterns_and_colors_of_blue_car:
	defb 0x00		;51c1 Pattern of shadow of blue car.
	defb 0x01		;51c2 Color of shadow of blue car: black.
	defb 0x04		;51c3 Pattern of blue car.
	defb 0x04		;51c4 Color of blue car: dark blue.




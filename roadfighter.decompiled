; GAME OVER
; 
; We can get here from:
;   0x6AF0 (jump) [from=6abb_car_state_01__crashed]
;   0x6B16 (jump) [from=6b05_car_state_02__no_fuel_remaining]
6b1c_out_of_fuel_and_no_more_speed:
	ld a,(E028_soundID_B)	;6b1c A = current sound/tune/bleep
	or a			;6b1f Update Z/NZ flag.
	ret nz			;6b20 if (some sound/tune/bleep is playing) return

	ld a,01bh		;6b21 A = 0x1B (silence, on all 3 channels)
	call 04b6eh		;6b23 4b6e_sound_something_with_D_is_0

	ld hl,0e04eh		;6b26 HL = 0xE04E
	ld b,(hl)		;6b29 B = horizontal position of car
	dec hl			;6b2a HL = 0xE04D
	dec hl			;6b2b HL = 0xE04C
	ld a,(hl)		;6b2c A = vertical position of car
	sub 010h		;6b2d A -= 0x10
	ld l,a			;6b2f L = A
	ld a,b			;6b30 A = B
	sub 008h		;6b31 A -= 0x08
	ld h,a			;6b33 H = A
	call 04561h		;6b34 4561_compute_vdp_address_of_HL_coordinates
	ld a,l			;6b37 A = L
	and 01fh		;6b38 A &= 0x1F
	cp 012h			;6b3a Compute A - 0x12 and set flags.
	jr c,$+8		;6b3c if (A < 0x12) jump to 0x6B44

	ld a,l			;6b3e A = L
	and 0e0h		;6b3f A &= 0xE0
	or 012h			;6b41 A |= 0x12
	ld l,a			;6b43 L = A

	ld de,06b59h		;6b44 DE = 0x6B59 (source, 6b59_empty, the pattern IDs that make up "EMPTY")
	ld bc,00005h		;6b47 BC = 0x0005 (number of bytes to copy)
	call 45a7_copy2vram	;6b4a
	
	ld a,080h		;6b4d A = 0x80
	ld (0e004h),a		;6b4f game_state_bits_or_counter_or_timer = 0x80
	
	ld a,006h		;6b52 A = 0x06
	ld (0e049h),a		;6b54 car_state = CAR_STATE_RESPAWN
	pop hl			;6b57 Remove return address, return to grandparent.
	ret			;6b58




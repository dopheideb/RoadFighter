; We can get here from:
;   0x40C5 (call) [from=40cc_game_state_00_substate_02__setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo]
;   0x49BF (call) [from=43f3_switch_to_game_state_01]
49a6_setup_VRAM_for_symbols_and_road_fighter_logo_and_draw_logo:
	ld b,0e0h		;49a6 B = 0xE0, (B&0x07) == 0 so set the VRAM page to 0.
	call 046b1h		;49a8 46b1_write_B_to_vdp_register_14
	
	call 04584h		;49ab 4584_clear_name_table_and_set_sprite_00_vpos_to_D0
	call 04773h		;49ae 4773_copy_symbols_to_VRAM
	
	; Copy Road Fighter logo patterns to VRAM.
	ld de,04a25h		;49b1 DE = 0x4A24 (4a25_road_fighter_logo_patterns)
	ld hl,02600h		;49b4 HL = 0x2600
	call 45e0_copy2VRAM_3x	;49b7
	
	; Blink the Road Fighter logo, start with dark+light red (0x01).
	ld a,001h		;49ba A = 0x01
	jp 040efh		;49bc 40ef_draw_road_fighter_logo(color_set=0x01)



; We can get here from:

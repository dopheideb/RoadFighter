; We can get here from:
;   0x523C (call) [from=5224_handle_race_substate]
5251_check_if_check_point_reached:
	ld hl,(0e078h)		;5251 Load distance travelled (middle and high byte)
	ld bc,00f12h		;5254 BC = 0x0F12 (checkpoint is at 0x0F1200)
	and a			;5257 Clear carry flag
	sbc hl,bc		;5258 distance travelled - checkpoint
	ret c			;525a return if checkpoint not yet reached

	525b_reached_checkpoint:
	ld a,(0e002h)		;525b Bit 6 (mask 0x40) means: 0==demo, 1==player is playing
	bit 6,a			;525e Check if player if playing.
	ld a,092h		;5260 Set tune ID to 0x92: Victorious tune when player reaches checkpoint
	call nz,04b6eh		;5262 if (player is playing) call 4b6e_sound_something_with_D_is_0
	
	ld a,003h		;5265 A = 0x03
	ld (0e049h),a		;5267 car_state = CAR_STATE_REACHED_CHECKPOINT
	ret			;526a



; We can get here from:

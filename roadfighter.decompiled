	ld de,0e0c2h		;51e8 LDIR: destination
	ld bc,00044h		;51eb LDIR: count
	ld (hl),000h		;51ee
	ldir			;51f0 do { *(DE++) = *(HL++) } while (--BC)
	
	ret			;51f2



51f3_something_about_car_horizontal_pos_on_screen:

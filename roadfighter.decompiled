; Stage 4
; 
; We can get here from:
;   0x5523 (call) Jump table entry for stage 4.
5539_stage_04_specific_code:
	call 05600h		;55e9 5600_fixme
	
	; HL -= 7
	ld bc,0fff9h		;55ec BC = 0xFFF9 (-7)
	add hl,bc		;55ef HL -= 7
	
	ld b,007h		;55f0 DJNZ: loop count = 7
	ld de,0e06eh		;55f2 DE = 0xE06E
	
	55f5_djnz_loop:
	ld a,(hl)		;55f5 A = *(HL)
	add a,00dh		;55f6 A += 0x0D
	ld (de),a		;55f8 *(DE) = A
	dec de			;55f9 --DE
	inc hl			;55fa ++HL
	djnz $-6		;55fb if (--B != 0) jump to 0x55F5 (55f5_djnz_loop)
	jp 05537h		;55fd 5537_post_routine_for_stage_01_02_04_06



; Note: stages 4 and 5 are both red, and the left scenery contains green 
; bushes/tree. That may explain the common code.
; 
; We can get here from:
;   0x55E9 (call) [stage 4]
;   0x5645 (call) [stage 5]
5600_fixme:
	ld hl,0e08dh		;5600 HL = 0xE08D
	dec (hl)		;5603
	jr nz,$+47		;5604 if (nz) jump to 0x5633
	
	; Number of scenery lines remaining is 0.
	dec hl			;5606
	dec (hl)		;5607
	jr nz,$+18		;5608 if (nz) jump to 0x561A
	
	ld hl,(0e08ah)		;560a
	inc hl			;560d
	ld (0e08ah),hl		;560e
	ld a,(hl)		;5611
	rra			;5612
	rra			;5613
	and 03fh		;5614
	ld de,0e08ch		;5616
	ld (de),a		;5619
	ld hl,(0e08ah)		;561a
	ld a,(hl)		;561d
	and 003h		;561e A &= 0x03 (since table has only 4 entries)
	add a,a			;5620 A *= 2 (since table consists of pointers)
	
	ld hl,0569ch		;5621 HL = 0x569C
	; Read pointer at HL[A] into HL.
	call 0403bh		;5624 HL += A
	ld a,(hl)		;5627
	inc hl			;5628
	ld h,(hl)		;5629
	ld l,a			;562a
	
	; ?Read length of scenery/track/coarse data?
	ld de,0e08dh		;562b DE = 0xE08D
	ldi			;562e *(DE++) = *(HL++), --BC
	ld (0e08eh),hl		;5630

; We can get here from:
;   0x5604 (jump)
;   0x5630 (fall)
5633_fixme:
	; Copy scenery data for left side of the track.
	; 
	; Copy 7 bytes from *(0xE08E) to 0xE058.
	ld de,0e058h		;5633 DE = 0xE058
	ld bc,00007h		;5636 BC = 0x0007
	ld hl,(0e08eh)		;5639 HL = *(0xE08E)
	ldir			;563c do { *(DE++) = *(HL++) } while (--BC)
	
	ld (0e08eh),hl		;563e Store beginning of next scenery line.
	ret			;5641



; Stage 5
;
; We can here from:
;   0x5523 (call) Jump table entry for stage 5.
5642_stage_05_specific_code:
	call 056f7h		;5642 56f7_fixme
	call 05600h		;5645 5600_fixme
	ld hl,(0e094h)		;5648
	ld a,(hl)		;564b
	inc a			;564c
	jr nz,$+41		;564d if (nz) jump to 0x5676
	
	ld hl,0e092h		;564f HL = 0xE092
	dec (hl)		;5652
	ld hl,(0e090h)		;5653
	jr nz,$+15		;5656 if (*(0xE092) != 0) jump to 0x5665
	
	inc hl			;5658 HL = 0xE093
	ld (0e090h),hl		;5659
	ld a,(hl)		;565c
	ld b,a			;565d B = A
	
	; *(0xE092) = (A >> 2)
	rra			;565e A >>= 1
	rra			;565f A >>= 1
	and 03fh		;5660 A &= 0x3F
	ld (0e092h),a		;5662
	
	; We can get here from:
	;   0x5656 (jump) [from=self] *(0xE092) was already non-zero
	;   0x5662 (fall) [from=self] *(0xE092) was zero, but set now
	ld a,(hl)		;5665
	and 003h		;5666 A &= 0x03 (keep lower 2 bits)
	add a,a			;5668 A *= 2
	ld hl,056a4h		;5669 HL = 0x56A4 (table ?to railroad track?)
	call 0403bh		;566c HL += A
	
	; HL = *(HL)
	ld a,(hl)		;566f
	inc hl			;5670
	ld h,(hl)		;5671
	ld l,a			;5672
	
	ld (0e094h),hl		;5673
	
	; We can get here from:
	;   0x564D (jump) [from=self]
	;   0x5673 (fall) [from=self]
	exx			;5676 Store HL. Restore at 0x567F.
		ld hl,(0e090h)	;5677
		ld a,(hl)	;567a
		and 003h	;567b A &= 0x03
		cp 003h		;567d Compute A - 0x03 and update Z/NZ flag.
	exx			;567f Restore HL, stored at 0x5676.
	jr nz,$+11		;5680 if ((*(0xE090) & 0x03) != 0) jump to 0x568B
	
	ld (0e094h),hl		;5682

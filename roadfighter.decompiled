;   . . x . . . x x   x x x x x x . .
;   . . . . x . x x   x x x x x . . .
;   . . . x x . x x   x x x x . . . .
;   . . . x x . . x   x x . . . . . .
;   . . . . . . . .    . . . . . . . .
	defb 0x76		;54f9
	defb 0x77		;54fa
	defb 0x74		;54fb
	defb 0x75		;54fc

; Blue oil. Visualization:
;   . . . . . . . .   . . . . . . . .
;   . . . . . . . .   . . . . . . . .
;   . . . . . . . .   x x x x . . . .
;   . . . . . . x x   x x x x x . . .
;   . . . . . x x x   x x x x x x x .
;   . . . . . x x x   x x x . . x x x
;   . . . . x x x x   x x x . . x x x
;   . . . . x x x x   x x x x . x x x
;
;   . . . . x x x x   x x x x x x x x
;   . x x . x x x x   x x x x . x x x
;   . x . . . x x x   x x x . x x x .
;   . . . . . x x x   x x x x x x x .
;   . . . x . x x x   x x x x x x . .
;   . . x x . x x x   x x x x x . . .
;   . x x x . . x x   x x x . . . . .
;   . . x . . . . x   x x . . . . . .
	defb 0x7A		;54fd
	defb 0x7B		;54fe
	defb 0x78		;54ff
	defb 0x79		;5500



; We can get here from:
;   0x5242 (call) [from=5224_handle_race_substate]
;   0x5289 (call) [from=527d_fixme]
5501_if_distance_travelled_changed__add_to_score_and_update_hiscore:
	ld a,(0e049h)		;5501 A = car_state
	dec a			;5504 --A, updates Z/NZ flag
	ret z			;5505 if (car_state == CAR_STATE_CRASHED) return
	; Post: not crashed
	;
	ld b,001h		;5506 B = 0x01
	ld a,(0e078h)		;5508 A = distance_travelled (middle byte)
	and b			;550b A &= 0x01
	ld d,a			;550c D = A
	ld hl,0e07eh		;550d HL = &previous_last_bit_of_distance_travelled_middle_byte
	ld a,(hl)		;5510 A = previous_last_bit_of_distance_travelled_middle_byte
	and b			;5511 A &= 0x01
	xor d			;5512 A ^= D
	ret z			;5513 if (distance_travelled_middle_byte is unchanged) return
	
	; Flip bit, and update previous_last_bit_of_distance_travelled_middle_byte.
	ld a,(hl)		;5514
	xor b			;5515 A ^= B
	ld (hl),a		;5516
	
	; Add 3 to score, update highscore if necessary.
	ld de,00003h		;5517 DE = 0x0003
	call 0447fh		;551a 447f_add_to_score_and_update_hiscore



